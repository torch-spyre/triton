// RUN: spyre-triton-opt %s -split-input-file --lower-descriptor-memory | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_1:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 511 >= 0)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>

// Tests for --lower-descriptor-memory on tt.descriptor_load.
//
// One tt.descriptor_load becomes three ops: a ktdp.construct_memory_view over
// the whole tensor, a ktdp.construct_access_tile positioned at the load index,
// and a ktdp.load that reads through the tile. The split is the point of the
// pass -- the view says what memory exists, the tile says which window of it
// this load touches.
//
// The two shapes in the input must not be confused:
//
//   tt.make_tensor_descriptor's [shape...] operands = the FULL tensor extent
//   the !tt.tensordesc<BxC> result type            = the block (tile) extent
//
// So a 512-element tensor read in 64-wide tiles gives memref<512xf16> on the
// view and access_tile<64xindex> on the tile. Both are pinned in every case
// below, because a pattern that read the block shape for the view would still
// emit well-formed IR -- just addressing 64 elements of a 512-element buffer.
// The same split shows up in the two affine sets: coordinate_set's upper bound
// is tensor-1 (511) and access_tile_set's is block-1 (63).
//
// Shape operands are i32 and stride operands are i64 (TritonOps.td spells them
// Variadic<I32>:$shape / Variadic<I64>:$strides), so the constants below use
// those types deliberately.
//
// Two notes on reading the output:
//
//   * The pass leaves builtin.unrealized_conversion_cast ops behind -- one
//     turning the !tt.ptr argument into the index the view wants, and one
//     turning the memref back into a !tt.tensordesc for uses the pass has not
//     rewritten yet. They are ordinary type-conversion plumbing, not a defect,
//     and ConvertFunctions resolves them later.
//   * The pass runs DCE, so a descriptor_load whose result is unused is erased
//     and the output is empty. Every kernel here returns its tile.

// -----
// Static 1-D, N=512. The smallest complete case: view over the full 512,
// tile of 64 at the load offset.
//
// Triton source pattern:
//
//   desc = tl.make_tensor_descriptor(ptr, shape=[N], strides=[1],
//                                    block_shape=[BLOCK])
//   tile = tl.descriptor_load(desc, [pid * BLOCK])   # tensor<BLOCKxf16>
//
// The absence guards sit between the load and the return, inside the function
// body, so they are not in the module's empty tail where they could never fire.
// The gap they scan is empty on clean output -- that is the normal state of a
// regression guard, and a regression is what fills it. Controlling such a guard
// means injecting into that gap an op whose result is consumed (DCE keeps it)
// and which does not displace the SSA value the trailing anchor names, or else
// running fewer passes so the excluded op survives naturally. Naming the
// anchor's own text does not control anything: FileCheck resolves the trailing
// CHECK first, so the anchor consumes the string.

// CHECK-LABEL:   tt.func @load_static_1d_512(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32) -> tensor<64xf16> {
// CHECK:           %[[VAL_2:.*]] = arith.constant 512 : i32
// CHECK:           %[[VAL_3:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [512], strides: [1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.memory_space<global>} : memref<512xf16>
// CHECK:           %[[VAL_6:.*]] = builtin.unrealized_conversion_cast %[[VAL_5]] : memref<512xf16> to !tt.tensordesc<64xf16>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_7]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<512xf16> -> !ktdp.access_tile<64xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <64xindex> -> tensor<64xf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_9]] : tensor<64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_3:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_5:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @load_static_1d_512(%ptr: !tt.ptr<f16>, %off: i32) -> tensor<64xf16> {
  %N = arith.constant 512 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
  %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf16> -> tensor<64xf16>
  tt.return %data : tensor<64xf16>
}

// -----
// Static 1-D, N=1024. Same structure, different tensor extent -- the block
// stays 64, so this pins that the view tracks the shape operand and not the
// descriptor type.

// CHECK-LABEL:   tt.func @load_static_1d_1024(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32) -> tensor<64xf16> {
// CHECK:           %[[VAL_2:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_3:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1024], strides: [1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<1024xf16>
// CHECK:           %[[VAL_6:.*]] = builtin.unrealized_conversion_cast %[[VAL_5]] : memref<1024xf16> to !tt.tensordesc<64xf16>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_7]]] {access_tile_order = #[[$ATTR_3]], access_tile_set = #[[$ATTR_5]]} : memref<1024xf16> -> !ktdp.access_tile<64xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <64xindex> -> tensor<64xf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_9]] : tensor<64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 4095 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @load_static_1d_1024(%ptr: !tt.ptr<f16>, %off: i32) -> tensor<64xf16> {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
  %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf16> -> tensor<64xf16>
  tt.return %data : tensor<64xf16>
}

// -----
// Static 1-D, N=4096. Third extent, same 64-wide block. Together the three
// 1-D cases show the view's size tracking N while the tile's stays fixed.

// CHECK-LABEL:   tt.func @load_static_1d_4096(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32) -> tensor<64xf16> {
// CHECK:           %[[VAL_2:.*]] = arith.constant 4096 : i32
// CHECK:           %[[VAL_3:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [4096], strides: [1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<4096xf16>
// CHECK:           %[[VAL_6:.*]] = builtin.unrealized_conversion_cast %[[VAL_5]] : memref<4096xf16> to !tt.tensordesc<64xf16>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_7]]] {access_tile_order = #[[$ATTR_6]], access_tile_set = #[[$ATTR_8]]} : memref<4096xf16> -> !ktdp.access_tile<64xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <64xindex> -> tensor<64xf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_9]] : tensor<64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_9:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_10:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 511 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// CHECK: #[[$ATTR_11:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @load_static_1d_4096(%ptr: !tt.ptr<f16>, %off: i32) -> tensor<64xf16> {
  %N = arith.constant 4096 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
  %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf16> -> tensor<64xf16>
  tt.return %data : tensor<64xf16>
}

// -----
// Static 2-D, 512x64 tensor with a 32x64 block. Rank 2 adds a second index
// operand and a second index_cast; the affine sets gain a d1 pair each.
//
// %m and %k are the tile's top-left corner in the full tensor, not the tile
// size -- the tile size is the <32x64xf16> in the descriptor type.
//
// Triton source pattern:
//
//   desc = tl.make_tensor_descriptor(ptr, shape=[M, K], strides=[K, 1],
//                                    block_shape=[BLOCK_M, BLOCK_K])
//   tile = tl.descriptor_load(desc, [pid_m * BLOCK_M, pid_k * BLOCK_K])

// CHECK-LABEL:   tt.func @load_static_2d_512x64(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 512 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 64 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 64 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [512, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_10]], memory_space = #ktdp.memory_space<global>} : memref<512x64xf16>
// CHECK:           %[[VAL_9:.*]] = builtin.unrealized_conversion_cast %[[VAL_8]] : memref<512x64xf16> to !tt.tensordesc<32x64xf16>
// CHECK:           %[[VAL_10:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_11:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_8]]{{\[}}%[[VAL_10]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_9]], access_tile_set = #[[$ATTR_11]]} : memref<512x64xf16> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_13]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_12:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_13:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_14:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @load_static_2d_512x64(%ptr: !tt.ptr<f16>, %m: i32, %k: i32) -> tensor<32x64xf16> {
  %M = arith.constant 512 : i32
  %K = arith.constant 64 : i32
  %sr = arith.constant 64 : i64
  %sc = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <32x64xf16>
  %data = tt.descriptor_load %desc[%m, %k] : !tt.tensordesc<32x64xf16> -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// Static 2-D, 1024x128. The row stride follows K, so it changes with the
// shape -- pinned on the view's strides list.

// CHECK-LABEL:   tt.func @load_static_2d_1024x128(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_13]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_9:.*]] = builtin.unrealized_conversion_cast %[[VAL_8]] : memref<1024x128xf16> to !tt.tensordesc<32x64xf16>
// CHECK:           %[[VAL_10:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_11:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_8]]{{\[}}%[[VAL_10]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_12]], access_tile_set = #[[$ATTR_14]]} : memref<1024x128xf16> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_13]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_15:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_16:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 2047 >= 0, d1 >= 0, -d1 + 255 >= 0)>
// CHECK: #[[$ATTR_17:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @load_static_2d_1024x128(%ptr: !tt.ptr<f16>, %m: i32, %k: i32) -> tensor<32x64xf16> {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <32x64xf16>
  %data = tt.descriptor_load %desc[%m, %k] : !tt.tensordesc<32x64xf16> -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// Static 2-D, 2048x256. Third extent pair; the 32x64 block is unchanged
// throughout, so access_tile_set is identical in all three 2-D cases while
// coordinate_set tracks the tensor.

// CHECK-LABEL:   tt.func @load_static_2d_2048x256(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 2048 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 256 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 256 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [2048, 256], strides: [256, 1] {coordinate_set = #[[$ATTR_16]], memory_space = #ktdp.memory_space<global>} : memref<2048x256xf16>
// CHECK:           %[[VAL_9:.*]] = builtin.unrealized_conversion_cast %[[VAL_8]] : memref<2048x256xf16> to !tt.tensordesc<32x64xf16>
// CHECK:           %[[VAL_10:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_11:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_8]]{{\[}}%[[VAL_10]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_15]], access_tile_set = #[[$ATTR_17]]} : memref<2048x256xf16> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_13]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_18:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_19:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_20:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @load_static_2d_2048x256(%ptr: !tt.ptr<f16>, %m: i32, %k: i32) -> tensor<32x64xf16> {
  %M = arith.constant 2048 : i32
  %K = arith.constant 256 : i32
  %sr = arith.constant 256 : i64
  %sc = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <32x64xf16>
  %data = tt.descriptor_load %desc[%m, %k] : !tt.tensordesc<32x64xf16> -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// The full-shape-not-block-shape claim, stated on its own.
//
// The descriptor declares a 1024-element tensor read in 64-wide tiles. The
// view must be memref<1024xf16>; a view of memref<64xf16> would be the block
// shape leaking into the wrong op. The guard below pins the negative directly
// so a regression that swapped the two shows up as a wrong memref type rather
// than as a subtly narrow buffer.

// CHECK-LABEL:   tt.func @load_memory_view_is_full_shape(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32) -> tensor<64xf16> {
// CHECK:           %[[VAL_2:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_3:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1024], strides: [1] {coordinate_set = #[[$ATTR_19]], memory_space = #ktdp.memory_space<global>} : memref<1024xf16>
// CHECK:           %[[VAL_6:.*]] = builtin.unrealized_conversion_cast %[[VAL_5]] : memref<1024xf16> to !tt.tensordesc<64xf16>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_7]]] {access_tile_order = #[[$ATTR_18]], access_tile_set = #[[$ATTR_20]]} : memref<1024xf16> -> !ktdp.access_tile<64xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <64xindex> -> tensor<64xf16>
// CHECK-NOT:       memref<64xf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_9]] : tensor<64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_21:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_22:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_23:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @load_memory_view_is_full_shape(%ptr: !tt.ptr<f16>, %off: i32) -> tensor<64xf16> {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
  %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf16> -> tensor<64xf16>
  tt.return %data : tensor<64xf16>
}

// -----
// Element type f16. The element type comes from the pointer and is copied
// through to the memref and the loaded tensor untouched -- the pass has no
// f16-specific path. The four cases that follow vary only the element type.

// CHECK-LABEL:   tt.func @load_elem_f16(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32) -> tensor<64xf16> {
// CHECK:           %[[VAL_2:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_3:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1024], strides: [1] {coordinate_set = #[[$ATTR_22]], memory_space = #ktdp.memory_space<global>} : memref<1024xf16>
// CHECK:           %[[VAL_6:.*]] = builtin.unrealized_conversion_cast %[[VAL_5]] : memref<1024xf16> to !tt.tensordesc<64xf16>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_7]]] {access_tile_order = #[[$ATTR_21]], access_tile_set = #[[$ATTR_23]]} : memref<1024xf16> -> !ktdp.access_tile<64xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <64xindex> -> tensor<64xf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_9]] : tensor<64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_24:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_25:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_26:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @load_elem_f16(%ptr: !tt.ptr<f16>, %off: i32) -> tensor<64xf16> {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
  %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf16> -> tensor<64xf16>
  tt.return %data : tensor<64xf16>
}

// -----
// Element type f32.

// CHECK-LABEL:   tt.func @load_elem_f32(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: i32) -> tensor<64xf32> {
// CHECK:           %[[VAL_2:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_3:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1024], strides: [1] {coordinate_set = #[[$ATTR_25]], memory_space = #ktdp.memory_space<global>} : memref<1024xf32>
// CHECK:           %[[VAL_6:.*]] = builtin.unrealized_conversion_cast %[[VAL_5]] : memref<1024xf32> to !tt.tensordesc<64xf32>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_7]]] {access_tile_order = #[[$ATTR_24]], access_tile_set = #[[$ATTR_26]]} : memref<1024xf32> -> !ktdp.access_tile<64xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <64xindex> -> tensor<64xf32>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_9]] : tensor<64xf32>
// CHECK:         }
// CHECK: #[[$ATTR_27:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_28:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_29:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @load_elem_f32(%ptr: !tt.ptr<f32>, %off: i32) -> tensor<64xf32> {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f32>, <64xf32>
  %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf32> -> tensor<64xf32>
  tt.return %data : tensor<64xf32>
}

// -----
// Element type bf16 -- a distinct MLIR float type from f16 at the same width,
// so it catches a lowering that normalized on bit width rather than copying
// the type.

// CHECK-LABEL:   tt.func @load_elem_bf16(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<bf16>, %[[VAL_1:.*]]: i32) -> tensor<64xbf16> {
// CHECK:           %[[VAL_2:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_3:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<bf16> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1024], strides: [1] {coordinate_set = #[[$ATTR_28]], memory_space = #ktdp.memory_space<global>} : memref<1024xbf16>
// CHECK:           %[[VAL_6:.*]] = builtin.unrealized_conversion_cast %[[VAL_5]] : memref<1024xbf16> to !tt.tensordesc<64xbf16>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_7]]] {access_tile_order = #[[$ATTR_27]], access_tile_set = #[[$ATTR_29]]} : memref<1024xbf16> -> !ktdp.access_tile<64xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <64xindex> -> tensor<64xbf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_9]] : tensor<64xbf16>
// CHECK:         }
// CHECK: #[[$ATTR_30:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_31:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_32:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @load_elem_bf16(%ptr: !tt.ptr<bf16>, %off: i32) -> tensor<64xbf16> {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <bf16>, <64xbf16>
  %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xbf16> -> tensor<64xbf16>
  tt.return %data : tensor<64xbf16>
}

// -----
// Element type f64 -- the widest, and the one whose stride arithmetic would
// differ if the pass ever computed byte offsets instead of element offsets.

// CHECK-LABEL:   tt.func @load_elem_f64(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f64>, %[[VAL_1:.*]]: i32) -> tensor<64xf64> {
// CHECK:           %[[VAL_2:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_3:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f64> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1024], strides: [1] {coordinate_set = #[[$ATTR_31]], memory_space = #ktdp.memory_space<global>} : memref<1024xf64>
// CHECK:           %[[VAL_6:.*]] = builtin.unrealized_conversion_cast %[[VAL_5]] : memref<1024xf64> to !tt.tensordesc<64xf64>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_7]]] {access_tile_order = #[[$ATTR_30]], access_tile_set = #[[$ATTR_32]]} : memref<1024xf64> -> !ktdp.access_tile<64xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <64xindex> -> tensor<64xf64>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_9]] : tensor<64xf64>
// CHECK:         }
// CHECK: #[[$ATTR_33:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_34:.+]] = affine_set<(d0, d1)[s0, s1] : (d0 >= 0, -d0 + s0 - 1 >= 0, d1 >= 0, -d1 + s1 - 1 >= 0)>
// CHECK: #[[$ATTR_35:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @load_elem_f64(%ptr: !tt.ptr<f64>, %off: i32) -> tensor<64xf64> {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f64>, <64xf64>
  %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf64> -> tensor<64xf64>
  tt.return %data : tensor<64xf64>
}

// -----
// Both dimensions dynamic: %M and %K arrive as tt.func arguments, so
// getConstantInt sees no arith.constant and emits kDynamic for each,
// producing memref<?x?xf16>.
//
// Two things change relative to the static 2-D case. The view gains dynamic
// size operands, each an arith.index_cast of the i32 argument. And
// coordinate_set becomes symbolic: instead of a literal -d0 + 511 >= 0 it
// carries -d0 + s0 - 1 >= 0, with s0 bound positionally to the first dynamic
// size. So the range constraint is still exact, just resolved at runtime.
//
// The block shape <32x64xf16> stays fixed -- it is part of the descriptor
// type, which is always compile-time, so access_tile_set is unchanged from
// the static case.
//
// The rank-1 dynamic case is not repeated here: Conversion/
// lower-scalar-load-feeds-descriptor-shape.mlir already pins memref<?xf16>
// with its symbolic coordinate_set and the arith.index_cast feeding the
// dynamic size, under both pass orderings.
//
// Triton source pattern:
//
//   # M and K are runtime kernel arguments
//   desc = tl.make_tensor_descriptor(ptr, shape=[M, K], strides=[K, 1],
//                                    block_shape=[BLOCK_M, BLOCK_K])
//   tile = tl.descriptor_load(desc, [pid_m * BLOCK_M, pid_k * BLOCK_K])

// CHECK-LABEL:   tt.func @load_dynamic_2d(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: i32, %[[VAL_4:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_5:.*]] = arith.constant 64 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_8:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_9:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:           %[[VAL_10:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: {{\[}}%[[VAL_8]], %[[VAL_9]]], strides: [64, 1] {coordinate_set = #[[$ATTR_34]], memory_space = #ktdp.memory_space<global>} : memref<?x?xf16>
// CHECK:           %[[VAL_11:.*]] = builtin.unrealized_conversion_cast %[[VAL_10]] : memref<?x?xf16> to !tt.tensordesc<32x64xf16>
// CHECK:           %[[VAL_12:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_13:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_10]]{{\[}}%[[VAL_12]], %[[VAL_13]]] {access_tile_order = #[[$ATTR_33]], access_tile_set = #[[$ATTR_35]]} : memref<?x?xf16> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_15]] : tensor<32x64xf16>
// CHECK:         }
tt.func @load_dynamic_2d(%ptr: !tt.ptr<f16>, %m: i32, %k: i32,
                         %M: i32, %K: i32) -> tensor<32x64xf16> {
  %sr = arith.constant 64 : i64
  %sc = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <32x64xf16>
  %data = tt.descriptor_load %desc[%m, %k] : !tt.tensordesc<32x64xf16> -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}
