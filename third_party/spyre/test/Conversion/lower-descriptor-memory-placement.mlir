// RUN: spyre-triton-opt %s -split-input-file --lower-descriptor-memory | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_1:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>

// Tests for where --lower-descriptor-memory puts ktdp.construct_memory_view.
//
// The pass rewrites each tt.make_tensor_descriptor in place, so the resulting
// view lands in the same region as the descriptor it replaced -- regardless of
// where the load or store that consumes it lives. That is the whole claim, and
// it has three consequences worth pinning separately.
//
// A note on what FileCheck can and cannot say here. FileCheck matches text, not
// the region tree, so "inside the loop" becomes "after the scf.for line and
// before the loop's closing brace". That is weaker than an ancestry query in
// principle. In practice it is exact for these cases, because the printer emits
// a region's contents indented between its opening and closing braces and
// nothing else can appear there -- so a view printed between `scf.for ... {` and
// its `}` is in the loop body, and one printed before the `scf.for` is not. The
// pytest version asserted this with parent= ancestry checks; the ordering here
// carries the same claim, with the brace lines as the anchors.
//
// The per-tile ops are a useful cross-check in the first case: they depend on
// the loop induction variable, so they MUST be inside the loop. Pinning both
// halves means a regression that hoisted the access tile out along with the
// view, or sank the view in along with the tile, fails rather than trading one
// error for another.

// -----
// Descriptor at function top, load inside scf.for: the view stays at function
// top and is built once, not once per iteration.
//
// This is the common shape -- define a descriptor at the start of the kernel,
// then walk tiles of it in a loop. The check order below is the claim: the view
// appears before the `scf.for` line, while ktdp.construct_access_tile and
// ktdp.load appear after it and before the loop's closing brace.
//
// Triton source pattern:
//
//   desc = tl.make_tensor_descriptor(ptr, shape=[N], strides=[1],
//                                    block_shape=[BLOCK])   # at function top
//   for off in range(0, N, BLOCK):
//       tile = tl.descriptor_load(desc, [off])               # inside the loop
//
// The absence guards sit between the loop's closing brace and the return, so
// they are inside the function body rather than the module's empty tail. Their
// gap is empty on clean output -- the normal state of a regression guard.

// CHECK-LABEL:   tt.func @view_stays_at_function_top(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_1:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_2:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [1024], strides: [1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.memory_space<global>} : memref<1024xf16>
// CHECK:           %[[VAL_5:.*]] = builtin.unrealized_conversion_cast %[[VAL_4]] : memref<1024xf16> to !tt.tensordesc<64xf16>
// CHECK:           %[[VAL_6:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_7:.*]] = arith.constant 1024 : index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           scf.for %[[VAL_9:.*]] = %[[VAL_6]] to %[[VAL_7]] step %[[VAL_8]] {
// CHECK:             %[[VAL_10:.*]] = arith.index_cast %[[VAL_9]] : index to i32
// CHECK:             %[[VAL_11:.*]] = arith.index_cast %[[VAL_10]] : i32 to index
// CHECK:             %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_11]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1024xf16> -> !ktdp.access_tile<64xindex>
// CHECK:             %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <64xindex> -> tensor<64xf16>
// CHECK:           }
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK-NOT:       tt.descriptor_load
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_3:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_5:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @view_stays_at_function_top(%ptr: !tt.ptr<f16>) {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
  %lo = arith.constant 0 : index
  %hi = arith.constant 1024 : index
  %step = arith.constant 64 : index
  scf.for %iv = %lo to %hi step %step {
    %off = arith.index_cast %iv : index to i32
    %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf16> -> tensor<64xf16>
  }
  tt.return
}

// -----
// Descriptor inside scf.for: the view is emitted inside the loop body too,
// alongside the access op, and is rebuilt once per iteration.
//
// The pass does not try to hoist it. That is deliberate -- moving a view out of
// a loop is a licit optimization but not this pass's job, and doing it here
// would mean reasoning about whether the descriptor's operands are
// loop-invariant. Left to the author, or to a later pass.
//
// The check order is the inverse of the previous case: nothing appears between
// the function's opening and the `scf.for` line except the loop bounds, and the
// view appears after it.
//
// Triton source pattern:
//
//   for i in range(0, N, BLOCK):
//       desc = tl.make_tensor_descriptor(ptr, shape=[N], strides=[1],
//                                        block_shape=[BLOCK])  # inside loop
//       tile = tl.descriptor_load(desc, [i])

// CHECK-LABEL:   tt.func @view_stays_inside_loop(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_1:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_2:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_4:.*]] = arith.constant 1024 : index
// CHECK:           %[[VAL_5:.*]] = arith.constant 64 : index
// CHECK:           scf.for %[[VAL_6:.*]] = %[[VAL_3]] to %[[VAL_4]] step %[[VAL_5]] {
// CHECK:             %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:             %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [1024], strides: [1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<1024xf16>
// CHECK:             %[[VAL_9:.*]] = builtin.unrealized_conversion_cast %[[VAL_8]] : memref<1024xf16> to !tt.tensordesc<64xf16>
// CHECK:             %[[VAL_10:.*]] = arith.index_cast %[[VAL_6]] : index to i32
// CHECK:             %[[VAL_11:.*]] = arith.index_cast %[[VAL_10]] : i32 to index
// CHECK:             %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_8]]{{\[}}%[[VAL_11]]] {access_tile_order = #[[$ATTR_3]], access_tile_set = #[[$ATTR_5]]} : memref<1024xf16> -> !ktdp.access_tile<64xindex>
// CHECK:             %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <64xindex> -> tensor<64xf16>
// CHECK:           }
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK-NOT:       tt.descriptor_load
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @view_stays_inside_loop(%ptr: !tt.ptr<f16>) {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  %lo = arith.constant 0 : index
  %hi = arith.constant 1024 : index
  %step = arith.constant 64 : index
  scf.for %iv = %lo to %hi step %step {
    %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
    %off = arith.index_cast %iv : index to i32
    %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf16> -> tensor<64xf16>
  }
  tt.return
}

// -----
// Descriptor inside an scf.if then-branch: the view is emitted inside that
// branch, so it is only built when the branch is taken.
//
// The same in-place rewrite rule, applied to a conditional region rather than a
// loop. Hoisting the view to function top would be observably wrong here, not
// merely pessimal: it would construct a memory view over the descriptor's
// pointer on the path where the kernel decided not to touch that buffer.
//
// %cond is a function argument and is never bound to a value -- this is a check
// on where the view lands in the IR, not an execution test.
//
// Triton source pattern:
//
//   if cond:
//       desc = tl.make_tensor_descriptor(ptr, shape=[N], strides=[1],
//                                        block_shape=[BLOCK])  # inside if
//       tile = tl.descriptor_load(desc, [off])

// CHECK-LABEL:   tt.func @view_stays_inside_scf_if(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i1, %[[VAL_2:.*]]: i32) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 1 : i64
// CHECK:           scf.if %[[VAL_1]] {
// CHECK:             %[[VAL_5:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:             %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_5]], sizes: [1024], strides: [1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<1024xf16>
// CHECK:             %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_6]] : memref<1024xf16> to !tt.tensordesc<64xf16>
// CHECK:             %[[VAL_8:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:             %[[VAL_9:.*]] = ktdp.construct_access_tile %[[VAL_6]]{{\[}}%[[VAL_8]]] {access_tile_order = #[[$ATTR_6]], access_tile_set = #[[$ATTR_8]]} : memref<1024xf16> -> !ktdp.access_tile<64xindex>
// CHECK:             %[[VAL_10:.*]] = ktdp.load %[[VAL_9]] : <64xindex> -> tensor<64xf16>
// CHECK:           }
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK-NOT:       tt.descriptor_load
// CHECK:           tt.return
// CHECK:         }
tt.func @view_stays_inside_scf_if(%ptr: !tt.ptr<f16>, %cond: i1, %off: i32) {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  scf.if %cond {
    %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
    %data = tt.descriptor_load %desc[%off] : !tt.tensordesc<64xf16> -> tensor<64xf16>
  }
  tt.return
}
