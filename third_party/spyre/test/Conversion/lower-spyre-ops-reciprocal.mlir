// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// RUN: spyre-triton-opt %s --lower-spyre-ops -split-input-file | FileCheck %s

// `arith.divf` has two targets, and which one it gets turns on the NUMERATOR.
// `1.0 / x` becomes the UNARY spyreop.reciprocal, taking its float immediate out
// of the program entirely -- a float constant is emitted as its IEEE bit pattern
// and read by the device as Spyre's own 1-6-9 float, so a literal 1.0 arrives as
// 0.5. Every other numerator keeps the binary spyreop.realdiv, which is what the
// rest of this file is here to hold: the match is by value, not by "there is a
// constant on the left".

// A scalar f16 `1.0 / x` -> spyreop.reciprocal, and the constant goes with it:
// the divide was its only reader, so nothing dead is left behind.
// CHECK-LABEL:   tt.func @recip_f16(
// CHECK-SAME:  %[[VAL_0:.*]]: f16) -> f16 {
// CHECK-NOT:       arith.constant
// CHECK-NOT:       spyreop.realdiv
// CHECK:           %[[VAL_1:.*]] = spyreop.reciprocal %[[VAL_0]] : f16
// CHECK:           tt.return %[[VAL_1]] : f16
// CHECK:         }
tt.func @recip_f16(%x: f16) -> f16 {
  %one = arith.constant 1.0 : f16
  %0 = arith.divf %one, %x : f16
  tt.return %0 : f16
}

// -----

// Same at f32, and here it is uniformity rather than necessity: the device's f32
// IS plain IEEE, so an f32 immediate is not misread. The rewrite does not branch
// on the width, because a rule that held at one float type and not the other
// would be a second thing to remember.
// CHECK-LABEL:   tt.func @recip_f32(
// CHECK-SAME:  %[[VAL_0:.*]]: f32) -> f32 {
// CHECK-NOT:       arith.constant
// CHECK-NOT:       spyreop.realdiv
// CHECK:           %[[VAL_1:.*]] = spyreop.reciprocal %[[VAL_0]] : f32
// CHECK:           tt.return %[[VAL_1]] : f32
// CHECK:         }
// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1) -> (d0, d1)>
tt.func @recip_f32(%x: f32) -> f32 {
  %one = arith.constant 1.0 : f32
  %0 = arith.divf %one, %x : f32
  tt.return %0 : f32
}

// -----

// Softmax's own shape, and the reason the match cannot assume one: the divide is
// scalar, inside a linalg.generic body, and its `1.0` is a scalar
// `arith.constant` HOISTED ABOVE the generic rather than a splat tensor sitting
// beside it. Nothing about the enclosing tensor shape is visible from the op.
// CHECK-LABEL:   tt.func @recip_f16_inside_generic(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4x1xf16>) -> tensor<4x1xf16> {
// CHECK-NOT:       arith.constant
// CHECK-NOT:       spyreop.realdiv
// CHECK:           %[[VAL_1:.*]] = tensor.empty() : tensor<4x1xf16>
// CHECK:           %[[VAL_2:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_0]], #[[$ATTR_0]]], iterator_types = ["parallel", "parallel"]} ins(%[[VAL_0]] : tensor<4x1xf16>) outs(%[[VAL_1]] : tensor<4x1xf16>) {
// CHECK:           ^bb0(%[[VAL_3:.*]]: f16, %[[VAL_4:.*]]: f16):
// CHECK:             %[[VAL_5:.*]] = spyreop.reciprocal %[[VAL_3]] : f16
// CHECK:             linalg.yield %[[VAL_5]] : f16
// CHECK:           } -> tensor<4x1xf16>
// CHECK:           tt.return %[[VAL_2]] : tensor<4x1xf16>
// CHECK:         }
tt.func @recip_f16_inside_generic(%t: tensor<4x1xf16>) -> tensor<4x1xf16> {
  %one = arith.constant 1.0 : f16
  %init = tensor.empty() : tensor<4x1xf16>
  %0 = linalg.generic {
      indexing_maps = [affine_map<(d0, d1) -> (d0, d1)>,
                       affine_map<(d0, d1) -> (d0, d1)>],
      iterator_types = ["parallel", "parallel"]}
      ins(%t : tensor<4x1xf16>) outs(%init : tensor<4x1xf16>) {
  ^bb0(%in: f16, %out: f16):
    %1 = arith.divf %one, %in : f16
    linalg.yield %1 : f16
  } -> tensor<4x1xf16>
  tt.return %0 : tensor<4x1xf16>
}

// -----

// A constant numerator that is NOT one keeps spyreop.realdiv, constant and all.
// This is the half of the rule that says the peephole is about removing the one
// immediate that is removable, not about compensating for the reinterpretation:
// there is no pre-scaled value to substitute here, so `2.0` is emitted as it was
// written.
// CHECK-LABEL:   tt.func @realdiv_two_over_x_f16(
// CHECK-SAME:  %[[VAL_0:.*]]: f16) -> f16 {
// CHECK:           %[[VAL_1:.*]] = arith.constant 2.000000e+00 : f16
// CHECK:           %[[VAL_2:.*]] = spyreop.realdiv %[[VAL_1]], %[[VAL_0]] : f16
// CHECK:           tt.return %[[VAL_2]] : f16
// CHECK:         }
tt.func @realdiv_two_over_x_f16(%x: f16) -> f16 {
  %two = arith.constant 2.0 : f16
  %0 = arith.divf %two, %x : f16
  tt.return %0 : f16
}

// -----

// A non-constant numerator keeps spyreop.realdiv too. Nothing to match, so
// nothing to remove.
// CHECK-LABEL:   tt.func @realdiv_var_over_x_f16(
// CHECK-SAME:  %[[VAL_0:.*]]: f16, %[[VAL_1:.*]]: f16) -> f16 {
// CHECK:           %[[VAL_2:.*]] = spyreop.realdiv %[[VAL_0]], %[[VAL_1]] : f16
// CHECK:           tt.return %[[VAL_2]] : f16
// CHECK:         }
tt.func @realdiv_var_over_x_f16(%a: f16, %b: f16) -> f16 {
  %0 = arith.divf %a, %b : f16
  tt.return %0 : f16
}

// -----

// The match is on the numerator specifically, not on "an operand is constant":
// a constant DENOMINATOR still needs a binary op, and gets one. (`x / 1.0` is
// not the test for this -- arith's own folder rewrites that to `x` before any
// pattern here sees it -- so the constant is 2.0.)
// CHECK-LABEL:   tt.func @realdiv_x_over_two_f16(
// CHECK-SAME:  %[[VAL_0:.*]]: f16) -> f16 {
// CHECK:           %[[VAL_1:.*]] = arith.constant 2.000000e+00 : f16
// CHECK:           %[[VAL_2:.*]] = spyreop.realdiv %[[VAL_0]], %[[VAL_1]] : f16
// CHECK:           tt.return %[[VAL_2]] : f16
// CHECK:         }
tt.func @realdiv_x_over_two_f16(%x: f16) -> f16 {
  %two = arith.constant 2.0 : f16
  %0 = arith.divf %x, %two : f16
  tt.return %0 : f16
}
