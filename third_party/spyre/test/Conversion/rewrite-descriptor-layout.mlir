// RUN: spyre-triton-opt %s --lower-descriptor-memory --lower-scalar-load --lower-compute-ops --rewrite-descriptor-layout | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 127 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 127 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>


// Test 1: Pointwise with layout marker on both input and output descriptors.
// Marker is erased, memory view has physical shape, load result is physical rank.
module {
// CHECK-LABEL:   tt.func @pointwise_physical(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_2:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [2, 128, 64], strides: [8192, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<2x128x64xf32>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [128, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<128x128xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_7]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_7]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_9]], %[[VAL_6]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<2x128x64xf32> -> !ktdp.access_tile<2x128x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <2x128x64xindex> -> tensor<2x128x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [2, 128, 64], strides: [8192, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<2x128x64xf32>
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [128, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<128x128xf32>
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_19:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_20:.*]] = arith.divsi %[[VAL_18]], %[[VAL_19]] : index
// CHECK:           %[[VAL_21:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_22:.*]] = arith.remsi %[[VAL_18]], %[[VAL_21]] : index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_20]], %[[VAL_17]], %[[VAL_22]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<2x128x64xf32> -> !ktdp.access_tile<2x128x64xindex>
// CHECK:           ktdp.store %[[VAL_13]], %[[VAL_23]] : tensor<2x128x64xf32>, <2x128x64xindex>
// CHECK:           tt.return
// CHECK:         }
tt.func @pointwise_physical(%ptr: !tt.ptr<f32>, %out_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c1_i64 = arith.constant 1 : i64
  // [M=128, N=128] stick-on-N with stick_size=64 → physical [N/64, M, 64] = [2, 128, 64]
  %desc = tt.make_tensor_descriptor %ptr, [%c128_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x128xf32>
  tt.spyre_tensor_layout %desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x128xf32>
  %d = tt.descriptor_load %desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x128xf32> -> tensor<128x128xf32>
  // Output with same layout
  %out_desc = tt.make_tensor_descriptor %out_ptr, [%c128_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x128xf32>
  tt.spyre_tensor_layout %out_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x128xf32>
  tt.descriptor_store %out_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<128x128xf32>, tensor<128x128xf32>
  tt.return
}

// Test 2: Unannotated descriptor passes through unchanged (stays logical rank-2).
// CHECK-LABEL:   tt.func @unannotated_passthrough(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_2:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_5:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_5]], %[[VAL_6]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_4]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           %[[VAL_8:.*]] = ktdp.load %[[VAL_7]] : <64x64xindex> -> tensor<64x64xf32>
// CHECK:           %[[VAL_9:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_10:.*]] = ktdp.construct_memory_view %[[VAL_9]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_11:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_12:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_access_tile %[[VAL_10]]{{\[}}%[[VAL_11]], %[[VAL_12]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_4]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           ktdp.store %[[VAL_8]], %[[VAL_13]] : tensor<64x64xf32>, <64x64xindex>
// CHECK:           tt.return
// CHECK:         }
tt.func @unannotated_passthrough(%ptr: !tt.ptr<f32>, %out_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  %d = tt.descriptor_load %desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>
  %out_desc = tt.make_tensor_descriptor %out_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.descriptor_store %out_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}
