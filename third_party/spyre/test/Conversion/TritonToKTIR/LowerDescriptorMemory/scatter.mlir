// RUN: spyre-triton-opt %s -split-input-file --lower-descriptor-memory | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 511 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>

// Tests for --lower-descriptor-memory on rank-2 tt.descriptor_scatter.
//
// Scatter is gather's write-side mirror: the same
// ktdp.construct_indirect_access_tile over the same two memory views, with
// ktdp.store in place of ktdp.load. The constraints carry over unchanged --
// the descriptor block must have exactly one row, the number of rows written
// comes from x_offsets rather than the block, and x_offsets must be traceable
// back to a tt.descriptor_load in the same function.
//
// These cases exist separately from the gather ones because the two directions
// go through different conversion patterns (ConvertDescriptorScatter and
// ConvertDescriptorGather). A fix or a regression landing on one does not
// automatically reach the other, and the N-D work has already had to be applied
// twice for exactly that reason. The rank-3 scatter mirror lives in
// lower-descriptor-memory-gather-nd.mlir beside its gather counterpart; the
// rank-2 index-grid scatter lives in
// lower-descriptor-memory-gather-2d-indices.mlir.
//
// The payload being written arrives as a function argument, and a store has no
// result, so nothing here needs an artificial return value to survive DCE.
//
// Two memory views come out of every case -- one for the index buffer, one for
// That count is what pins the absence of the removed trace fallback, which used
// to build a third view; see lower-descriptor-memory-gather.mlir for the full
// account, including why the pytest suite's cast-absence assertion could never
// fire.

// -----
// Rank-2 scatter over a 512x128 table: 32 rows named by the index buffer, 64
// columns starting at y_offset, payload tensor<32x64xf16>.
//
// Triton source pattern:
//
//   idx_desc = tl.make_tensor_descriptor(idx_ptr, shape=[32], strides=[1],
//                                        block_shape=[32])
//   x_offsets = tl.descriptor_load(idx_desc, [0])        # tensor<32xi32>
//   tl.descriptor_scatter(desc, x_offsets, y_offset, data)
//
// The guards sit between ktdp.store and the return, inside the function body.
// Their gap is empty on clean output, which is the normal state of a regression
// guard; controlling one means injecting into that gap an op whose result is
// consumed, and not naming the trailing anchor's own text.

// CHECK-LABEL:   tt.func @scatter_2d_512x128(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: tensor<32x64xf16>) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 512 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_11:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_memory_view %[[VAL_11]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_13:.*]] = builtin.unrealized_conversion_cast %[[VAL_12]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_14:.*]] = arith.index_cast %[[VAL_10]] : i32 to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_access_tile %[[VAL_12]]{{\[}}%[[VAL_14]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_16:.*]] = ktdp.load %[[VAL_15]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_17:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_18:.*]] = ktdp.construct_memory_view %[[VAL_17]], sizes: [512, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<512x128xf16>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_18]] : memref<512x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_20:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_21:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_22:.*]], %[[VAL_23:.*]]) %[[VAL_18]][ind(%[[VAL_12]]{{\[}}%[[VAL_14]] + %[[VAL_22]]]), (%[[VAL_20]] + %[[VAL_23]])] {variables_space_order = #[[$ATTR_1]], variables_space_set = #[[$ATTR_4]]} : memref<512x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           ktdp.store %[[VAL_3]], %[[VAL_21]] : tensor<32x64xf16>, <32x64xindex>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_5:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_9:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @scatter_2d_512x128(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                            %y_offset: i32, %data: tensor<32x64xf16>) {
  %M = arith.constant 512 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  tt.descriptor_scatter %desc[%x_offsets, %y_offset], %data
      : !tt.tensordesc<1x64xf16>, tensor<32xi32>, i32, tensor<32x64xf16>
  tt.return
}

// -----
// Rank-2 scatter over 1024x128.

// CHECK-LABEL:   tt.func @scatter_2d_1024x128(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: tensor<32x64xf16>) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_11:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_memory_view %[[VAL_11]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_13:.*]] = builtin.unrealized_conversion_cast %[[VAL_12]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_14:.*]] = arith.index_cast %[[VAL_10]] : i32 to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_access_tile %[[VAL_12]]{{\[}}%[[VAL_14]]] {access_tile_order = #[[$ATTR_5]], access_tile_set = #[[$ATTR_7]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_16:.*]] = ktdp.load %[[VAL_15]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_17:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_18:.*]] = ktdp.construct_memory_view %[[VAL_17]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_8]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_18]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_20:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_21:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_22:.*]], %[[VAL_23:.*]]) %[[VAL_18]][ind(%[[VAL_12]]{{\[}}%[[VAL_14]] + %[[VAL_22]]]), (%[[VAL_20]] + %[[VAL_23]])] {variables_space_order = #[[$ATTR_6]], variables_space_set = #[[$ATTR_9]]} : memref<1024x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           ktdp.store %[[VAL_3]], %[[VAL_21]] : tensor<32x64xf16>, <32x64xindex>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_10:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_11:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_12:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_13:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 2047 >= 0, d1 >= 0, -d1 + 255 >= 0)>
// CHECK: #[[$ATTR_14:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @scatter_2d_1024x128(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                             %y_offset: i32, %data: tensor<32x64xf16>) {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  tt.descriptor_scatter %desc[%x_offsets, %y_offset], %data
      : !tt.tensordesc<1x64xf16>, tensor<32xi32>, i32, tensor<32x64xf16>
  tt.return
}

// -----
// Rank-2 scatter over 2048x256, writing a 64-wide slice of a 256-column table.
// The base view must span all 256 columns for the y_offset slice to be
// addressable, exactly as on the gather side.

// CHECK-LABEL:   tt.func @scatter_2d_2048x256(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: tensor<32x64xf16>) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 2048 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 256 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 256 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_11:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_memory_view %[[VAL_11]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_12]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_13:.*]] = builtin.unrealized_conversion_cast %[[VAL_12]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_14:.*]] = arith.index_cast %[[VAL_10]] : i32 to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_access_tile %[[VAL_12]]{{\[}}%[[VAL_14]]] {access_tile_order = #[[$ATTR_10]], access_tile_set = #[[$ATTR_12]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_16:.*]] = ktdp.load %[[VAL_15]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_17:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_18:.*]] = ktdp.construct_memory_view %[[VAL_17]], sizes: [2048, 256], strides: [256, 1] {coordinate_set = #[[$ATTR_13]], memory_space = #ktdp.memory_space<global>} : memref<2048x256xf16>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_18]] : memref<2048x256xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_20:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_21:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_22:.*]], %[[VAL_23:.*]]) %[[VAL_18]][ind(%[[VAL_12]]{{\[}}%[[VAL_14]] + %[[VAL_22]]]), (%[[VAL_20]] + %[[VAL_23]])] {variables_space_order = #[[$ATTR_11]], variables_space_set = #[[$ATTR_14]]} : memref<2048x256xf16>, memref<32xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           ktdp.store %[[VAL_3]], %[[VAL_21]] : tensor<32x64xf16>, <32x64xindex>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_15:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_16:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_17:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_18:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_19:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @scatter_2d_2048x256(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                             %y_offset: i32, %data: tensor<32x64xf16>) {
  %M = arith.constant 2048 : i32
  %K = arith.constant 256 : i32
  %sr = arith.constant 256 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  tt.descriptor_scatter %desc[%x_offsets, %y_offset], %data
      : !tt.tensordesc<1x64xf16>, tensor<32xi32>, i32, tensor<32x64xf16>
  tt.return
}

// -----
// The indirect tile's structure, stated on its own.
//
// ktdp.construct_indirect_access_tile carries a region of per-row subscript
// affine maps plus variables_space_set / variables_space_order describing the
// iteration space over x_offsets. For a 32-row, 64-column scatter that space is
// [0,31] x [0,63] -- len(x_offsets)-1 by block_cols-1 -- and the generated
// check spells the whole affine set, so a lowering that derived the space from
// the block's dim 0 (which is 1) instead of from x_offsets would fail here.
//
// The base view must also cover the full 1024x128 table rather than the 1x64
// block, which the guard below pins directly.

// CHECK-LABEL:   tt.func @scatter_2d_structure(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: tensor<32x64xf16>) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_11:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_memory_view %[[VAL_11]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_17]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_13:.*]] = builtin.unrealized_conversion_cast %[[VAL_12]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_14:.*]] = arith.index_cast %[[VAL_10]] : i32 to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_access_tile %[[VAL_12]]{{\[}}%[[VAL_14]]] {access_tile_order = #[[$ATTR_15]], access_tile_set = #[[$ATTR_17]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_16:.*]] = ktdp.load %[[VAL_15]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_17:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_18:.*]] = ktdp.construct_memory_view %[[VAL_17]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_18]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_18]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_20:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_21:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_22:.*]], %[[VAL_23:.*]]) %[[VAL_18]][ind(%[[VAL_12]]{{\[}}%[[VAL_14]] + %[[VAL_22]]]), (%[[VAL_20]] + %[[VAL_23]])] {variables_space_order = #[[$ATTR_16]], variables_space_set = #[[$ATTR_19]]} : memref<1024x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           ktdp.store %[[VAL_3]], %[[VAL_21]] : tensor<32x64xf16>, <32x64xindex>
// CHECK-NOT:       memref<1x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
tt.func @scatter_2d_structure(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                              %y_offset: i32, %data: tensor<32x64xf16>) {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  tt.descriptor_scatter %desc[%x_offsets, %y_offset], %data
      : !tt.tensordesc<1x64xf16>, tensor<32xi32>, i32, tensor<32x64xf16>
  tt.return
}
