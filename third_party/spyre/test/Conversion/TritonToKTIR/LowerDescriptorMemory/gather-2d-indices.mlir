// RUN: spyre-triton-opt %s -split-input-file --lower-descriptor-memory | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0, d2 >= 0, -d2 + 63 >= 0)>

// Tests for --lower-descriptor-memory on gather/scatter with a rank-2 index
// grid.
//
// The N-D relaxation widened the descriptor block and the result to rank >= 2
// but kept x_offsets strictly 1-D. The rank-K relaxation lets x_offsets itself
// be rank >= 1, so a kernel can gather a multi-dimensional grid of pages -- one
// page per (sequence, head) pair, say -- without flattening the index space by
// hand.
//
// With K = rank(x_offsets) and R = the block rank, the result rank is
// K + R - 1:
//
//   x_offsets  : tensor<8x4xi32>          K = 2
//   desc block : <1x64xf16>               R = 2, leading 1 still required
//   result     : tensor<8x4x64xf16>       index-grid dims, then block[1:]
//
//   result[d0, d1, d2] = base[ x_offsets[c_x0 + d0, c_x1 + d1],   // ONE dim
//                              y_offset + d2 ]                    // base dim 1
//
// The load-bearing subtlety is in that first line. A rank-2 index grid does NOT
// produce two indirect base dimensions. It produces ONE indirect base dimension
// -- the page axis -- whose subscript map yields K results, i.e. a K-D address
// into the index view. That is what ktdp.construct_indirect_access_tile
// expects: the KTDP verifier requires an indirect subscript map's result count
// to equal the index memref's rank.
//
// So the printed access tile has R subscripts, one per base dimension, and the
// index-grid axes live inside the first one's brackets:
//
//   ind(%idx[%c_x0 + %d0, %c_x1 + %d1]), (%c_y + %d2)
//
// Contrast the rank-1 index case in lower-descriptor-memory-gather.mlir, whose
// inner address is 1-D: ind(%idx[%c_x + %d0]). A regression that dropped an
// index axis would shrink that inner address while leaving everything else
// well-formed, so the generated checks pin the subscript text.
//
// x_offsets is staged through a 2-D index descriptor here -- the same
// descriptor-load provenance the rank-1 cases use, just at rank 2. Two memory
// bounds that count.

// -----
// Rank-2 index grid over a <1x64> block: an 8x4 grid of rows, 64 columns each,
// giving tensor<8x4x64xf16>. Both leading result dims are driven by the grid.
//
// Triton source pattern:
//
//   idx_desc = tl.make_tensor_descriptor(idx_ptr, [SEQ, HEADS], [HEADS, 1],
//                                        block_shape=[8, 4])
//   x_offsets = tl.descriptor_load(idx_desc, [0, 0])    # tensor<8x4xi32>
//   data = tl.descriptor_gather(desc, x_offsets, y_offset)
//   # -> tensor<8 x 4 x 64 x f16>
//
// The guards sit between the gather's ktdp.load and the return, inside the
// function body. The gap they scan is empty on clean output -- the normal state
// of a regression guard -- so controlling one means injecting into that gap an
// op whose result is consumed and which leaves the anchor's SSA name alone.

// CHECK-LABEL:   tt.func @gather_2d_indices(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<8x4x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 8 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 4 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 4 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [8, 4], strides: [4, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<8x4xi32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_13]] : memref<8x4xi32> to !tt.tensordesc<8x4xi32>
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_15]], %[[VAL_16]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<8x4xi32> -> !ktdp.access_tile<8x4xindex>
// CHECK:           %[[VAL_18:.*]] = ktdp.load %[[VAL_17]] : <8x4xindex> -> tensor<8x4xi32>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_memory_view %[[VAL_19]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_21:.*]] = builtin.unrealized_conversion_cast %[[VAL_20]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_22:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_24:.*]], %[[VAL_25:.*]], %[[VAL_26:.*]]) %[[VAL_20]][ind(%[[VAL_13]]{{\[}}%[[VAL_15]] + %[[VAL_24]], %[[VAL_16]] + %[[VAL_25]]]), (%[[VAL_22]] + %[[VAL_26]])] {variables_space_order = #[[$ATTR_1]], variables_space_set = #[[$ATTR_4]]} : memref<1024x128xf16>, memref<8x4xi32> -> !ktdp.access_tile<8x4x64xindex>
// CHECK:           %[[VAL_27:.*]] = ktdp.load %[[VAL_23]] : <8x4x64xindex> -> tensor<8x4x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_27]] : tensor<8x4x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_5:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_9:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0, d2 >= 0, -d2 + 63 >= 0)>
tt.func @gather_2d_indices(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                           %y_offset: i32) -> tensor<8x4x64xf16> {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ir = arith.constant 8 : i32
  %icol = arith.constant 4 : i32
  %isr = arith.constant 4 : i64
  %isc = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ir, %icol], [%isr, %isc]
      : <i32>, <8x4xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0, %c0]
      : !tt.tensordesc<8x4xi32> -> tensor<8x4xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<8x4xi32>, i32) -> tensor<8x4x64xf16>
  tt.return %data : tensor<8x4x64xf16>
}

// -----
// The one-indirect-base-dim claim, stated on its own.
//
// Same shape as the case above, kept separate because what it pins is the
// subscript structure rather than the surrounding IR. The base is
// memref<1024x128xf16>, rank 2, so there are exactly TWO subscripts -- one per
// base dimension -- not three. The K=2 index grid lives inside the first
// subscript's brackets as a two-coordinate address, and the second subscript is
// the direct y_offset column axis, which has moved past the grid axes to d2.
//
// This is the distinction from rank-1 x_offsets that a reader is most likely to
// get wrong, since "two indirect axes" is the natural but incorrect reading of
// the feature's name.

// CHECK-LABEL:   tt.func @gather_2d_indices_one_indirect_base_dim(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<8x4x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 8 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 4 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 4 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [8, 4], strides: [4, 1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<8x4xi32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_13]] : memref<8x4xi32> to !tt.tensordesc<8x4xi32>
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_15]], %[[VAL_16]]] {access_tile_order = #[[$ATTR_5]], access_tile_set = #[[$ATTR_7]]} : memref<8x4xi32> -> !ktdp.access_tile<8x4xindex>
// CHECK:           %[[VAL_18:.*]] = ktdp.load %[[VAL_17]] : <8x4xindex> -> tensor<8x4xi32>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_memory_view %[[VAL_19]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_8]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_21:.*]] = builtin.unrealized_conversion_cast %[[VAL_20]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_22:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_24:.*]], %[[VAL_25:.*]], %[[VAL_26:.*]]) %[[VAL_20]][ind(%[[VAL_13]]{{\[}}%[[VAL_15]] + %[[VAL_24]], %[[VAL_16]] + %[[VAL_25]]]), (%[[VAL_22]] + %[[VAL_26]])] {variables_space_order = #[[$ATTR_6]], variables_space_set = #[[$ATTR_9]]} : memref<1024x128xf16>, memref<8x4xi32> -> !ktdp.access_tile<8x4x64xindex>
// CHECK:           %[[VAL_27:.*]] = ktdp.load %[[VAL_23]] : <8x4x64xindex> -> tensor<8x4x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_27]] : tensor<8x4x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_10:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_11:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_12:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0)>
// CHECK: #[[$ATTR_13:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 4095 >= 0, d1 >= 0, -d1 + 255 >= 0)>
// CHECK: #[[$ATTR_14:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0, d2 >= 0, -d2 + 63 >= 0)>
tt.func @gather_2d_indices_one_indirect_base_dim(%ptr: !tt.ptr<f16>,
                                                 %idx_ptr: !tt.ptr<i32>,
                                                 %y_offset: i32) -> tensor<8x4x64xf16> {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ir = arith.constant 8 : i32
  %icol = arith.constant 4 : i32
  %isr = arith.constant 4 : i64
  %isc = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ir, %icol], [%isr, %isc]
      : <i32>, <8x4xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0, %c0]
      : !tt.tensordesc<8x4xi32> -> tensor<8x4xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<8x4xi32>, i32) -> tensor<8x4x64xf16>
  tt.return %data : tensor<8x4x64xf16>
}

// -----
// Result shape is [*x_offsets.shape, block_cols]: 8x4 grid, 64 columns.
//
// The three result-shape cases that follow vary the grid and the column count
// to pin that both grid dims flow through to the result, in order, ahead of the
// block columns. A lowering that transposed the grid or appended it after the
// columns would still produce a well-formed rank-3 tensor.

// CHECK-LABEL:   tt.func @gather_2d_indices_shape_8x4x64(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<8x4x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 4096 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 256 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 256 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 8 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 4 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 4 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [8, 4], strides: [4, 1] {coordinate_set = #[[$ATTR_12]], memory_space = #ktdp.memory_space<global>} : memref<8x4xi32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_13]] : memref<8x4xi32> to !tt.tensordesc<8x4xi32>
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_15]], %[[VAL_16]]] {access_tile_order = #[[$ATTR_10]], access_tile_set = #[[$ATTR_12]]} : memref<8x4xi32> -> !ktdp.access_tile<8x4xindex>
// CHECK:           %[[VAL_18:.*]] = ktdp.load %[[VAL_17]] : <8x4xindex> -> tensor<8x4xi32>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_memory_view %[[VAL_19]], sizes: [4096, 256], strides: [256, 1] {coordinate_set = #[[$ATTR_13]], memory_space = #ktdp.memory_space<global>} : memref<4096x256xf16>
// CHECK:           %[[VAL_21:.*]] = builtin.unrealized_conversion_cast %[[VAL_20]] : memref<4096x256xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_22:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_24:.*]], %[[VAL_25:.*]], %[[VAL_26:.*]]) %[[VAL_20]][ind(%[[VAL_13]]{{\[}}%[[VAL_15]] + %[[VAL_24]], %[[VAL_16]] + %[[VAL_25]]]), (%[[VAL_22]] + %[[VAL_26]])] {variables_space_order = #[[$ATTR_11]], variables_space_set = #[[$ATTR_14]]} : memref<4096x256xf16>, memref<8x4xi32> -> !ktdp.access_tile<8x4x64xindex>
// CHECK:           %[[VAL_27:.*]] = ktdp.load %[[VAL_23]] : <8x4x64xindex> -> tensor<8x4x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_27]] : tensor<8x4x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_15:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_16:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_17:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 15 >= 0, d1 >= 0, -d1 + 1 >= 0)>
// CHECK: #[[$ATTR_18:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 4095 >= 0, d1 >= 0, -d1 + 255 >= 0)>
// CHECK: #[[$ATTR_19:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 15 >= 0, d1 >= 0, -d1 + 1 >= 0, d2 >= 0, -d2 + 31 >= 0)>
tt.func @gather_2d_indices_shape_8x4x64(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                        %y_offset: i32) -> tensor<8x4x64xf16> {
  %M = arith.constant 4096 : i32
  %K = arith.constant 256 : i32
  %sr = arith.constant 256 : i64
  %sc = arith.constant 1 : i64
  %ir = arith.constant 8 : i32
  %icol = arith.constant 4 : i32
  %isr = arith.constant 4 : i64
  %isc = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ir, %icol], [%isr, %isc]
      : <i32>, <8x4xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0, %c0]
      : !tt.tensordesc<8x4xi32> -> tensor<8x4xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<8x4xi32>, i32) -> tensor<8x4x64xf16>
  tt.return %data : tensor<8x4x64xf16>
}

// -----
// Result shape 16x2x32: a taller, narrower grid and a 32-wide slice.

// CHECK-LABEL:   tt.func @gather_2d_indices_shape_16x2x32(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<16x2x32xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 4096 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 256 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 256 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 16 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 2 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 2 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [16, 2], strides: [2, 1] {coordinate_set = #[[$ATTR_17]], memory_space = #ktdp.memory_space<global>} : memref<16x2xi32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_13]] : memref<16x2xi32> to !tt.tensordesc<16x2xi32>
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_15]], %[[VAL_16]]] {access_tile_order = #[[$ATTR_15]], access_tile_set = #[[$ATTR_17]]} : memref<16x2xi32> -> !ktdp.access_tile<16x2xindex>
// CHECK:           %[[VAL_18:.*]] = ktdp.load %[[VAL_17]] : <16x2xindex> -> tensor<16x2xi32>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_memory_view %[[VAL_19]], sizes: [4096, 256], strides: [256, 1] {coordinate_set = #[[$ATTR_18]], memory_space = #ktdp.memory_space<global>} : memref<4096x256xf16>
// CHECK:           %[[VAL_21:.*]] = builtin.unrealized_conversion_cast %[[VAL_20]] : memref<4096x256xf16> to !tt.tensordesc<1x32xf16>
// CHECK:           %[[VAL_22:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_24:.*]], %[[VAL_25:.*]], %[[VAL_26:.*]]) %[[VAL_20]][ind(%[[VAL_13]]{{\[}}%[[VAL_15]] + %[[VAL_24]], %[[VAL_16]] + %[[VAL_25]]]), (%[[VAL_22]] + %[[VAL_26]])] {variables_space_order = #[[$ATTR_16]], variables_space_set = #[[$ATTR_19]]} : memref<4096x256xf16>, memref<16x2xi32> -> !ktdp.access_tile<16x2x32xindex>
// CHECK:           %[[VAL_27:.*]] = ktdp.load %[[VAL_23]] : <16x2x32xindex> -> tensor<16x2x32xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_27]] : tensor<16x2x32xf16>
// CHECK:         }
// CHECK: #[[$ATTR_20:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_21:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_22:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 3 >= 0, d1 >= 0, -d1 + 7 >= 0)>
// CHECK: #[[$ATTR_23:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 4095 >= 0, d1 >= 0, -d1 + 255 >= 0)>
// CHECK: #[[$ATTR_24:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 3 >= 0, d1 >= 0, -d1 + 7 >= 0, d2 >= 0, -d2 + 127 >= 0)>
tt.func @gather_2d_indices_shape_16x2x32(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                         %y_offset: i32) -> tensor<16x2x32xf16> {
  %M = arith.constant 4096 : i32
  %K = arith.constant 256 : i32
  %sr = arith.constant 256 : i64
  %sc = arith.constant 1 : i64
  %ir = arith.constant 16 : i32
  %icol = arith.constant 2 : i32
  %isr = arith.constant 2 : i64
  %isc = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ir, %icol], [%isr, %isc]
      : <i32>, <16x2xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0, %c0]
      : !tt.tensordesc<16x2xi32> -> tensor<16x2xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x32xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x32xf16>, tensor<16x2xi32>, i32) -> tensor<16x2x32xf16>
  tt.return %data : tensor<16x2x32xf16>
}

// -----
// Result shape 4x8x128: the grid dims swapped relative to the 8x4 case, which
// is what catches a transposed grid.

// CHECK-LABEL:   tt.func @gather_2d_indices_shape_4x8x128(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<4x8x128xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 4096 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 256 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 256 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 4 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 8 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 8 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [4, 8], strides: [8, 1] {coordinate_set = #[[$ATTR_22]], memory_space = #ktdp.memory_space<global>} : memref<4x8xi32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_13]] : memref<4x8xi32> to !tt.tensordesc<4x8xi32>
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_15]], %[[VAL_16]]] {access_tile_order = #[[$ATTR_20]], access_tile_set = #[[$ATTR_22]]} : memref<4x8xi32> -> !ktdp.access_tile<4x8xindex>
// CHECK:           %[[VAL_18:.*]] = ktdp.load %[[VAL_17]] : <4x8xindex> -> tensor<4x8xi32>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_memory_view %[[VAL_19]], sizes: [4096, 256], strides: [256, 1] {coordinate_set = #[[$ATTR_23]], memory_space = #ktdp.memory_space<global>} : memref<4096x256xf16>
// CHECK:           %[[VAL_21:.*]] = builtin.unrealized_conversion_cast %[[VAL_20]] : memref<4096x256xf16> to !tt.tensordesc<1x128xf16>
// CHECK:           %[[VAL_22:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_24:.*]], %[[VAL_25:.*]], %[[VAL_26:.*]]) %[[VAL_20]][ind(%[[VAL_13]]{{\[}}%[[VAL_15]] + %[[VAL_24]], %[[VAL_16]] + %[[VAL_25]]]), (%[[VAL_22]] + %[[VAL_26]])] {variables_space_order = #[[$ATTR_21]], variables_space_set = #[[$ATTR_24]]} : memref<4096x256xf16>, memref<4x8xi32> -> !ktdp.access_tile<4x8x128xindex>
// CHECK:           %[[VAL_27:.*]] = ktdp.load %[[VAL_23]] : <4x8x128xindex> -> tensor<4x8x128xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_27]] : tensor<4x8x128xf16>
// CHECK:         }
// CHECK: #[[$ATTR_25:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_26:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_27:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0)>
// CHECK: #[[$ATTR_28:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_29:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0, d2 >= 0, -d2 + 63 >= 0)>
tt.func @gather_2d_indices_shape_4x8x128(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                         %y_offset: i32) -> tensor<4x8x128xf16> {
  %M = arith.constant 4096 : i32
  %K = arith.constant 256 : i32
  %sr = arith.constant 256 : i64
  %sc = arith.constant 1 : i64
  %ir = arith.constant 4 : i32
  %icol = arith.constant 8 : i32
  %isr = arith.constant 8 : i64
  %isc = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ir, %icol], [%isr, %isc]
      : <i32>, <4x8xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0, %c0]
      : !tt.tensordesc<4x8xi32> -> tensor<4x8xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x128xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x128xf16>, tensor<4x8xi32>, i32) -> tensor<4x8x128xf16>
  tt.return %data : tensor<4x8x128xf16>
}

// -----
// Scatter mirror: the same 8x4 grid drives 32 row writes, with the payload
// arriving as tensor<8x4x64xf16>. Goes through ConvertDescriptorScatter to
// ktdp.store over the same one-indirect-base-dim access tile.
//
// Triton source pattern:
//
//   x_offsets = tl.descriptor_load(idx_desc, [0, 0])    # tensor<8x4xi32>
//   tl.descriptor_scatter(desc, x_offsets, y_offset, value)   # value 8x4x64

// CHECK-LABEL:   tt.func @scatter_2d_indices(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: tensor<8x4x64xf16>) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 8 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 4 : i32
// CHECK:           %[[VAL_10:.*]] = arith.constant 4 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_12:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_13:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_memory_view %[[VAL_13]], sizes: [8, 4], strides: [4, 1] {coordinate_set = #[[$ATTR_27]], memory_space = #ktdp.memory_space<global>} : memref<8x4xi32>
// CHECK:           %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_14]] : memref<8x4xi32> to !tt.tensordesc<8x4xi32>
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_12]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_12]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = ktdp.construct_access_tile %[[VAL_14]]{{\[}}%[[VAL_16]], %[[VAL_17]]] {access_tile_order = #[[$ATTR_25]], access_tile_set = #[[$ATTR_27]]} : memref<8x4xi32> -> !ktdp.access_tile<8x4xindex>
// CHECK:           %[[VAL_19:.*]] = ktdp.load %[[VAL_18]] : <8x4xindex> -> tensor<8x4xi32>
// CHECK:           %[[VAL_20:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_21:.*]] = ktdp.construct_memory_view %[[VAL_20]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_28]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_22:.*]] = builtin.unrealized_conversion_cast %[[VAL_21]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_23:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_24:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_25:.*]], %[[VAL_26:.*]], %[[VAL_27:.*]]) %[[VAL_21]][ind(%[[VAL_14]]{{\[}}%[[VAL_16]] + %[[VAL_25]], %[[VAL_17]] + %[[VAL_26]]]), (%[[VAL_23]] + %[[VAL_27]])] {variables_space_order = #[[$ATTR_26]], variables_space_set = #[[$ATTR_29]]} : memref<1024x128xf16>, memref<8x4xi32> -> !ktdp.access_tile<8x4x64xindex>
// CHECK:           ktdp.store %[[VAL_3]], %[[VAL_24]] : tensor<8x4x64xf16>, <8x4x64xindex>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_30:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_31:.+]] = affine_map<(d0, d1, d2, d3) -> (d0, d1, d2, d3)>
// CHECK: #[[$ATTR_32:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0)>
// CHECK: #[[$ATTR_33:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>
// CHECK: #[[$ATTR_34:.+]] = affine_set<(d0, d1, d2, d3) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 3 >= 0, d2 >= 0, -d2 + 15 >= 0, d3 >= 0, -d3 + 127 >= 0)>
tt.func @scatter_2d_indices(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                            %y_offset: i32, %src: tensor<8x4x64xf16>) {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ir = arith.constant 8 : i32
  %icol = arith.constant 4 : i32
  %isr = arith.constant 4 : i64
  %isc = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ir, %icol], [%isr, %isc]
      : <i32>, <8x4xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0, %c0]
      : !tt.tensordesc<8x4xi32> -> tensor<8x4xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  tt.descriptor_scatter %desc[%x_offsets, %y_offset], %src
      : !tt.tensordesc<1x64xf16>, tensor<8x4xi32>, i32, tensor<8x4x64xf16>
  tt.return
}

// -----
// Rank-2 index grid combined with a rank-3 block: the two relaxations compose.
//
// The grid contributes dims 0 and 1 (both inside the one indirect subscript),
// y_offset lands on dim 2, and the block's trailing inner dim is a direct
// no-offset dim 3 -- so the result is rank 4, tensor<8x4x16x128xf16>. This is
// the case that would break if either relaxation had been implemented assuming
// the other was absent.
//
// Triton source pattern:
//
//   x_offsets = tl.descriptor_load(idx_desc, [0, 0])    # tensor<8x4xi32>
//   data = tl.descriptor_gather(desc, x_offsets, y_offset)  # block [1, B, D]
//   # -> tensor<8 x 4 x B x D x f16>

// CHECK-LABEL:   tt.func @gather_2d_indices_3d_block(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<8x4x16x128xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 16 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 2048 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 8 : i32
// CHECK:           %[[VAL_10:.*]] = arith.constant 4 : i32
// CHECK:           %[[VAL_11:.*]] = arith.constant 4 : i64
// CHECK:           %[[VAL_12:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_13:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [8, 4], strides: [4, 1] {coordinate_set = #[[$ATTR_32]], memory_space = #ktdp.memory_space<global>} : memref<8x4xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_15]] : memref<8x4xi32> to !tt.tensordesc<8x4xi32>
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_13]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.index_cast %[[VAL_13]] : i32 to index
// CHECK:           %[[VAL_19:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_17]], %[[VAL_18]]] {access_tile_order = #[[$ATTR_30]], access_tile_set = #[[$ATTR_32]]} : memref<8x4xi32> -> !ktdp.access_tile<8x4xindex>
// CHECK:           %[[VAL_20:.*]] = ktdp.load %[[VAL_19]] : <8x4xindex> -> tensor<8x4xi32>
// CHECK:           %[[VAL_21:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_memory_view %[[VAL_21]], sizes: [1024, 16, 128], strides: [2048, 128, 1] {coordinate_set = #[[$ATTR_33]], memory_space = #ktdp.memory_space<global>} : memref<1024x16x128xf16>
// CHECK:           %[[VAL_23:.*]] = builtin.unrealized_conversion_cast %[[VAL_22]] : memref<1024x16x128xf16> to !tt.tensordesc<1x16x128xf16>
// CHECK:           %[[VAL_24:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_25:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_26:.*]], %[[VAL_27:.*]], %[[VAL_28:.*]], %[[VAL_29:.*]]) %[[VAL_22]][ind(%[[VAL_15]]{{\[}}%[[VAL_17]] + %[[VAL_26]], %[[VAL_18]] + %[[VAL_27]]]), (%[[VAL_24]] + %[[VAL_28]]), (%[[VAL_29]])] {variables_space_order = #[[$ATTR_31]], variables_space_set = #[[$ATTR_34]]} : memref<1024x16x128xf16>, memref<8x4xi32> -> !ktdp.access_tile<8x4x16x128xindex>
// CHECK:           %[[VAL_30:.*]] = ktdp.load %[[VAL_25]] : <8x4x16x128xindex> -> tensor<8x4x16x128xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_30]] : tensor<8x4x16x128xf16>
// CHECK:         }
tt.func @gather_2d_indices_3d_block(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                    %y_offset: i32) -> tensor<8x4x16x128xf16> {
  %P = arith.constant 1024 : i32
  %B = arith.constant 16 : i32
  %D = arith.constant 128 : i32
  %s0 = arith.constant 2048 : i64
  %s1 = arith.constant 128 : i64
  %s2 = arith.constant 1 : i64
  %ir = arith.constant 8 : i32
  %icol = arith.constant 4 : i32
  %isr = arith.constant 4 : i64
  %isc = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ir, %icol], [%isr, %isc]
      : <i32>, <8x4xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0, %c0]
      : !tt.tensordesc<8x4xi32> -> tensor<8x4xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%P, %B, %D], [%s0, %s1, %s2]
      : <f16>, <1x16x128xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x16x128xf16>, tensor<8x4xi32>, i32) -> tensor<8x4x16x128xf16>
  tt.return %data : tensor<8x4x16x128xf16>
}
