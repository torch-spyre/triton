// RUN: spyre-triton-opt %s -split-input-file --lower-descriptor-memory | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>

// Tests for --lower-descriptor-memory on N-D tt.descriptor_gather (rank >= 3).
//
// Spyre relaxed the upstream rank-2-exactly rule to rank >= 2, so a descriptor
// block can carry trailing dimensions beyond the gathered axis and the column
// slice. buildGatherSubscriptMaps assigns a fixed role to each dimension, and
// that role split is the headline limitation of the N-D form:
//
//   dim 0        indirect, fed by the index buffer   ind(%idx[%c_x + %d0])
//   dim 1        direct, offset by y_offset          (%c_y + %d1)
//   dim i >= 2   direct, no offset at all            (%d_i)
//
// So at every rank there are exactly two movable axes. Every dimension from 2
// upward is a bare induction variable: no offset, no capture, the kernel reads
// that axis's full block extent with no way to slice it. At rank 2 this did not
// matter because there was no dim 2. From rank 3 up it constrains any kernel
// that wants a second offset axis, or wants to gather along anything other than
// the outermost axis. The workaround for the latter is stride permutation, and
// the workaround for the former is to reshape after the gather.
//
// The block's leading dim must still be 1 at every rank -- the relaxation
// widened which ranks are legal, not which dimension carries the page. A
// rank-3 block <2x16x128> is rejected; see
// lower-descriptor-memory-invalid.mlir.
//
// variables_space_set spans the whole result, so it carries 2 constraints per
// dimension: 6 at rank 3, 8 at rank 4, 10 at rank 5. Those counts are the
// cheapest signal that no trailing dimension was silently dropped, and the
// generated checks below pin the full set text.
//
// As in lower-descriptor-memory-gather.mlir, x_offsets is staged through a 1-D
// index descriptor because that is the only provenance buildIndirectAccessTile
// can trace, and two memory views come out of every case -- one for the index

// -----
// Rank 3. Source is NUM_BLOCKS x BLOCK_SIZE x INNER_DIM with block
// <1x16x128xf16>: indices drive dim 0, y_offset lands on dim 1, and dim 2 (the
// contiguous inner axis) is direct with no offset.
//
// The iteration space is 0 <= d0 < 32, 0 <= d1 < 16, 0 <= d2 < 128.
//
// Triton source pattern:
//
//   src_desc = tl.make_tensor_descriptor(
//       src_ptr, shape=[NUM_BLOCKS, BLOCK_SIZE, INNER_DIM],
//       strides=[BLOCK_SIZE * INNER_DIM, INNER_DIM, 1],
//       block_shape=[1, BLOCK_SIZE, INNER_DIM])
//   result = tl.descriptor_gather(src_desc, indices, 0)
//   # -> tensor<32 x BLOCK_SIZE x INNER_DIM x f16>
//
// The guards sit between the gather's ktdp.load and the return. Their gap is
// empty on clean output, which is the normal state of a regression guard; a
// regression is what fills it. Controlling one means injecting into that gap an
// op whose result is consumed and which does not displace the anchor's SSA
// value -- naming the anchor's own text controls nothing.

// CHECK-LABEL:   tt.func @gather_3d(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x16x128xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 16 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 2048 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_13]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_15]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_17:.*]] = ktdp.load %[[VAL_16]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_19:.*]] = ktdp.construct_memory_view %[[VAL_18]], sizes: [1024, 16, 128], strides: [2048, 128, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<1024x16x128xf16>
// CHECK:           %[[VAL_20:.*]] = builtin.unrealized_conversion_cast %[[VAL_19]] : memref<1024x16x128xf16> to !tt.tensordesc<1x16x128xf16>
// CHECK:           %[[VAL_21:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_23:.*]], %[[VAL_24:.*]], %[[VAL_25:.*]]) %[[VAL_19]][ind(%[[VAL_13]]{{\[}}%[[VAL_15]] + %[[VAL_23]]]), (%[[VAL_21]] + %[[VAL_24]]), (%[[VAL_25]])] {variables_space_order = #[[$ATTR_1]], variables_space_set = #[[$ATTR_4]]} : memref<1024x16x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x16x128xindex>
// CHECK:           %[[VAL_26:.*]] = ktdp.load %[[VAL_22]] : <32x16x128xindex> -> tensor<32x16x128xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_26]] : tensor<32x16x128xf16>
// CHECK:         }
// CHECK: #[[$ATTR_5:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0, d1, d2, d3) -> (d0, d1, d2, d3)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0, d1, d2, d3) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 7 >= 0, d2 >= 0, -d2 + 15 >= 0, d3 >= 0, -d3 + 127 >= 0)>
// CHECK: #[[$ATTR_9:.+]] = affine_set<(d0, d1, d2, d3) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 >= 0, d2 >= 0, -d2 + 15 >= 0, d3 >= 0, -d3 + 127 >= 0)>
tt.func @gather_3d(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                   %y_offset: i32) -> tensor<32x16x128xf16> {
  %P = arith.constant 1024 : i32
  %B = arith.constant 16 : i32
  %D = arith.constant 128 : i32
  %s0 = arith.constant 2048 : i64
  %s1 = arith.constant 128 : i64
  %s2 = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%P, %B, %D], [%s0, %s1, %s2]
      : <f16>, <1x16x128xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x16x128xf16>, tensor<32xi32>, i32) -> tensor<32x16x128xf16>
  tt.return %data : tensor<32x16x128xf16>
}

// -----
// Rank 4: an indirect axis plus a group axis that takes the y_offset.
//
// The group axis is permuted to dim 1 so the single y_offset (here a group
// index) lands there; dims 2 and 3 are the inner BLOCK_SIZE and INNER_DIM axes,
// direct with no offset. Note the strides are non-monotone -- the group stride
// (128) is smaller than the row stride (1024) -- because the declared shape
// puts groups at dim 1 while the physical layout stores them inside the rows.
//
// Triton source pattern:
//
//   src_desc = tl.make_tensor_descriptor(
//       src_ptr, shape=[NUM_BLOCKS, NUM_GROUPS, BLOCK_SIZE, INNER_DIM],
//       strides=[B*H*D, D, H*D, 1],
//       block_shape=[1, 1, BLOCK_SIZE, INNER_DIM])
//   result = tl.descriptor_gather(src_desc, indices, group_idx)

// CHECK-LABEL:   tt.func @gather_4d(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x1x16x128xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 64 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 8 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 16 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_7:.*]] = arith.constant 16384 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 1024 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_12:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_13:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_15]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_13]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_17]]] {access_tile_order = #[[$ATTR_5]], access_tile_set = #[[$ATTR_7]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_19:.*]] = ktdp.load %[[VAL_18]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_20:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_21:.*]] = ktdp.construct_memory_view %[[VAL_20]], sizes: [64, 8, 16, 128], strides: [16384, 128, 1024, 1] {coordinate_set = #[[$ATTR_8]], memory_space = #ktdp.memory_space<global>} : memref<64x8x16x128xf16>
// CHECK:           %[[VAL_22:.*]] = builtin.unrealized_conversion_cast %[[VAL_21]] : memref<64x8x16x128xf16> to !tt.tensordesc<1x1x16x128xf16>
// CHECK:           %[[VAL_23:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_24:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_25:.*]], %[[VAL_26:.*]], %[[VAL_27:.*]], %[[VAL_28:.*]]) %[[VAL_21]][ind(%[[VAL_15]]{{\[}}%[[VAL_17]] + %[[VAL_25]]]), (%[[VAL_23]] + %[[VAL_26]]), (%[[VAL_27]]), (%[[VAL_28]])] {variables_space_order = #[[$ATTR_6]], variables_space_set = #[[$ATTR_9]]} : memref<64x8x16x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x1x16x128xindex>
// CHECK:           %[[VAL_29:.*]] = ktdp.load %[[VAL_24]] : <32x1x16x128xindex> -> tensor<32x1x16x128xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_29]] : tensor<32x1x16x128xf16>
// CHECK:         }
// CHECK: #[[$ATTR_10:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_11:.+]] = affine_map<(d0, d1, d2, d3, d4) -> (d0, d1, d2, d3, d4)>
// CHECK: #[[$ATTR_12:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_13:.+]] = affine_set<(d0, d1, d2, d3, d4) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 7 >= 0, d2 >= 0, -d2 + 15 >= 0, d3 >= 0, -d3 + 1 >= 0, d4 >= 0, -d4 + 63 >= 0)>
// CHECK: #[[$ATTR_14:.+]] = affine_set<(d0, d1, d2, d3, d4) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 >= 0, d2 >= 0, -d2 + 15 >= 0, d3 >= 0, -d3 + 1 >= 0, d4 >= 0, -d4 + 63 >= 0)>
tt.func @gather_4d(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                   %group_idx: i32) -> tensor<32x1x16x128xf16> {
  %P = arith.constant 64 : i32
  %H = arith.constant 8 : i32
  %B = arith.constant 16 : i32
  %D = arith.constant 128 : i32
  %s0 = arith.constant 16384 : i64
  %s1 = arith.constant 128 : i64
  %s2 = arith.constant 1024 : i64
  %s3 = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %indices = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%P, %H, %B, %D], [%s0, %s1, %s2, %s3]
      : <f16>, <1x1x16x128xf16>
  %data = tt.descriptor_gather %desc[%indices, %group_idx]
      : (!tt.tensordesc<1x1x16x128xf16>, tensor<32xi32>, i32) -> tensor<32x1x16x128xf16>
  tt.return %data : tensor<32x1x16x128xf16>
}

// -----
// Rank 5: indirect axis, group axis, and a split (stickified) inner dim.
//
// The trailing contiguous axis is split across dim 3 (NUM_STICKS, the stick
// group) and dim 4 (STICK_SIZE, the offset within a stick), so INNER_DIM =
// 2 * 64 = 128. This is endpoint coverage for the relaxed rank range: a
// regression that dropped trailing dimensions would shrink both the result type
// and variables_space_set, and both are pinned.

// CHECK-LABEL:   tt.func @gather_5d(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x1x16x2x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 64 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 8 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 16 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 2 : i32
// CHECK:           %[[VAL_7:.*]] = arith.constant 64 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 16384 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 1024 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 64 : i64
// CHECK:           %[[VAL_12:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_13:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_14:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_15:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_12]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_17]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_15]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_access_tile %[[VAL_17]]{{\[}}%[[VAL_19]]] {access_tile_order = #[[$ATTR_10]], access_tile_set = #[[$ATTR_12]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_21:.*]] = ktdp.load %[[VAL_20]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_22:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_memory_view %[[VAL_22]], sizes: [64, 8, 16, 2, 64], strides: [16384, 128, 1024, 64, 1] {coordinate_set = #[[$ATTR_13]], memory_space = #ktdp.memory_space<global>} : memref<64x8x16x2x64xf16>
// CHECK:           %[[VAL_24:.*]] = builtin.unrealized_conversion_cast %[[VAL_23]] : memref<64x8x16x2x64xf16> to !tt.tensordesc<1x1x16x2x64xf16>
// CHECK:           %[[VAL_25:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_26:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_27:.*]], %[[VAL_28:.*]], %[[VAL_29:.*]], %[[VAL_30:.*]], %[[VAL_31:.*]]) %[[VAL_23]][ind(%[[VAL_17]]{{\[}}%[[VAL_19]] + %[[VAL_27]]]), (%[[VAL_25]] + %[[VAL_28]]), (%[[VAL_29]]), (%[[VAL_30]]), (%[[VAL_31]])] {variables_space_order = #[[$ATTR_11]], variables_space_set = #[[$ATTR_14]]} : memref<64x8x16x2x64xf16>, memref<32xi32> -> !ktdp.access_tile<32x1x16x2x64xindex>
// CHECK:           %[[VAL_32:.*]] = ktdp.load %[[VAL_26]] : <32x1x16x2x64xindex> -> tensor<32x1x16x2x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_32]] : tensor<32x1x16x2x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_15:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_16:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_17:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_18:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>
// CHECK: #[[$ATTR_19:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>
tt.func @gather_5d(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                   %group_idx: i32) -> tensor<32x1x16x2x64xf16> {
  %P = arith.constant 64 : i32
  %H = arith.constant 8 : i32
  %B = arith.constant 16 : i32
  %S = arith.constant 2 : i32
  %SE = arith.constant 64 : i32
  %s0 = arith.constant 16384 : i64
  %s1 = arith.constant 128 : i64
  %s2 = arith.constant 1024 : i64
  %s3 = arith.constant 64 : i64
  %s4 = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %indices = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%P, %H, %B, %S, %SE],
              [%s0, %s1, %s2, %s3, %s4] : <f16>, <1x1x16x2x64xf16>
  %data = tt.descriptor_gather %desc[%indices, %group_idx]
      : (!tt.tensordesc<1x1x16x2x64xf16>, tensor<32xi32>, i32) -> tensor<32x1x16x2x64xf16>
  tt.return %data : tensor<32x1x16x2x64xf16>
}

// -----
// Rank-3 scatter: the write-side mirror, through ConvertDescriptorScatter.
//
// Same indirect-tile machinery, same subscript roles, ktdp.store instead of
// ktdp.load. Worth stating separately because the N-D generalisation had to be
// applied to both patterns; a fix landing only on the read side would leave
// this asymmetric.
//
// Triton source pattern:
//
//   tl.descriptor_scatter(dst_desc, indices, y_offset, value)

// CHECK-LABEL:   tt.func @scatter_3d(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: tensor<32x16x128xf16>) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 16 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_7:.*]] = arith.constant 2048 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_10:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_11:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_12:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_13:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_memory_view %[[VAL_13]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_17]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_14]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_12]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_access_tile %[[VAL_14]]{{\[}}%[[VAL_16]]] {access_tile_order = #[[$ATTR_15]], access_tile_set = #[[$ATTR_17]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_18:.*]] = ktdp.load %[[VAL_17]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_memory_view %[[VAL_19]], sizes: [1024, 16, 128], strides: [2048, 128, 1] {coordinate_set = #[[$ATTR_18]], memory_space = #ktdp.memory_space<global>} : memref<1024x16x128xf16>
// CHECK:           %[[VAL_21:.*]] = builtin.unrealized_conversion_cast %[[VAL_20]] : memref<1024x16x128xf16> to !tt.tensordesc<1x16x128xf16>
// CHECK:           %[[VAL_22:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_24:.*]], %[[VAL_25:.*]], %[[VAL_26:.*]]) %[[VAL_20]][ind(%[[VAL_14]]{{\[}}%[[VAL_16]] + %[[VAL_24]]]), (%[[VAL_22]] + %[[VAL_25]]), (%[[VAL_26]])] {variables_space_order = #[[$ATTR_16]], variables_space_set = #[[$ATTR_19]]} : memref<1024x16x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x16x128xindex>
// CHECK:           ktdp.store %[[VAL_3]], %[[VAL_23]] : tensor<32x16x128xf16>, <32x16x128xindex>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_20:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_21:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_22:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_23:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>
// CHECK: #[[$ATTR_24:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>
tt.func @scatter_3d(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                    %y_offset: i32, %src: tensor<32x16x128xf16>) {
  %P = arith.constant 1024 : i32
  %B = arith.constant 16 : i32
  %D = arith.constant 128 : i32
  %s0 = arith.constant 2048 : i64
  %s1 = arith.constant 128 : i64
  %s2 = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%P, %B, %D], [%s0, %s1, %s2]
      : <f16>, <1x16x128xf16>
  tt.descriptor_scatter %desc[%x_offsets, %y_offset], %src
      : !tt.tensordesc<1x16x128xf16>, tensor<32xi32>, i32, tensor<32x16x128xf16>
  tt.return
}

// -----
// The dim 0 / dim 1 / dim >= 2 role split, stated as its own case.
//
// This is the same rank-3 shape as @gather_3d, kept separate because what it
// pins is the textual form of the three subscripts rather than the surrounding
// structure. The generated check on construct_indirect_access_tile spells all
// three:
//
//   ind(%idx[%c_x + %d0])   dim 0: indirect, capturing the load offset
//   (%c_y + %d1)            dim 1: direct, capturing y_offset
//   (%d2)                   dim 2: direct, bare -- no capture
//
// Without pinning that text, a regression emitting a second indirect axis, or a
// captured offset on a trailing dim, would slip past the structural counts on
// variables_space_set, which only constrain rank and constraint count.

// CHECK-LABEL:   tt.func @gather_3d_subscript_roles(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x16x128xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 16 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 2048 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_22]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_13]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_15]]] {access_tile_order = #[[$ATTR_20]], access_tile_set = #[[$ATTR_22]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_17:.*]] = ktdp.load %[[VAL_16]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_19:.*]] = ktdp.construct_memory_view %[[VAL_18]], sizes: [1024, 16, 128], strides: [2048, 128, 1] {coordinate_set = #[[$ATTR_23]], memory_space = #ktdp.memory_space<global>} : memref<1024x16x128xf16>
// CHECK:           %[[VAL_20:.*]] = builtin.unrealized_conversion_cast %[[VAL_19]] : memref<1024x16x128xf16> to !tt.tensordesc<1x16x128xf16>
// CHECK:           %[[VAL_21:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_23:.*]], %[[VAL_24:.*]], %[[VAL_25:.*]]) %[[VAL_19]][ind(%[[VAL_13]]{{\[}}%[[VAL_15]] + %[[VAL_23]]]), (%[[VAL_21]] + %[[VAL_24]]), (%[[VAL_25]])] {variables_space_order = #[[$ATTR_21]], variables_space_set = #[[$ATTR_24]]} : memref<1024x16x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x16x128xindex>
// CHECK:           %[[VAL_26:.*]] = ktdp.load %[[VAL_22]] : <32x16x128xindex> -> tensor<32x16x128xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_26]] : tensor<32x16x128xf16>
// CHECK:         }
// CHECK: #[[$ATTR_25:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_26:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_27:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_28:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>
// CHECK: #[[$ATTR_29:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>
tt.func @gather_3d_subscript_roles(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                   %y_offset: i32) -> tensor<32x16x128xf16> {
  %P = arith.constant 1024 : i32
  %B = arith.constant 16 : i32
  %D = arith.constant 128 : i32
  %s0 = arith.constant 2048 : i64
  %s1 = arith.constant 128 : i64
  %s2 = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%P, %B, %D], [%s0, %s1, %s2]
      : <f16>, <1x16x128xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x16x128xf16>, tensor<32xi32>, i32) -> tensor<32x16x128xf16>
  tt.return %data : tensor<32x16x128xf16>
}

// -----
// Gathering a physically-inner axis via stride permutation.
//
// The index buffer is wired to dim 0 and there is no way to point it elsewhere.
// A kernel whose physical tensor stores the gathered axis in the middle has one
// option: declare the descriptor's shape with that axis at dim 0 and express
// the real layout through the strides.
//
// Here the tensor is physically [BLOCK_SIZE, NUM_BLOCKS, INNER_DIM] -- block
// row major rather than block id major -- but the kernel still gathers by block
// id. So the declared shape is [NUM_BLOCKS, BLOCK_SIZE, INNER_DIM] and the
// strides are [INNER_DIM, NUM_BLOCKS * INNER_DIM, 1]: the block-id stride (128)
// is now smaller than the block-row stride (131072), the inverse of the
// outermost-block-id case.
//
// From the pass's side nothing changes; the trick is entirely in how the author
// declares the descriptor. The claim being pinned is that the memory view's
// shape comes from the declared shape operands and nothing else -- a lowering
// that re-derived it from the strides would produce a differently-shaped view
// here while every other case stayed green.

// CHECK-LABEL:   tt.func @gather_3d_stride_permutation(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x16x128xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 16 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 131072 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_27]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_13]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_15]]] {access_tile_order = #[[$ATTR_25]], access_tile_set = #[[$ATTR_27]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_17:.*]] = ktdp.load %[[VAL_16]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_19:.*]] = ktdp.construct_memory_view %[[VAL_18]], sizes: [1024, 16, 128], strides: [128, 131072, 1] {coordinate_set = #[[$ATTR_28]], memory_space = #ktdp.memory_space<global>} : memref<1024x16x128xf16>
// CHECK:           %[[VAL_20:.*]] = builtin.unrealized_conversion_cast %[[VAL_19]] : memref<1024x16x128xf16> to !tt.tensordesc<1x16x128xf16>
// CHECK:           %[[VAL_21:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_23:.*]], %[[VAL_24:.*]], %[[VAL_25:.*]]) %[[VAL_19]][ind(%[[VAL_13]]{{\[}}%[[VAL_15]] + %[[VAL_23]]]), (%[[VAL_21]] + %[[VAL_24]]), (%[[VAL_25]])] {variables_space_order = #[[$ATTR_26]], variables_space_set = #[[$ATTR_29]]} : memref<1024x16x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x16x128xindex>
// CHECK:           %[[VAL_26:.*]] = ktdp.load %[[VAL_22]] : <32x16x128xindex> -> tensor<32x16x128xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_26]] : tensor<32x16x128xf16>
// CHECK:         }
// CHECK: #[[$ATTR_30:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_31:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_32:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_33:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 15 >= 0, d2 >= 0, -d2 + 127 >= 0)>
// CHECK: #[[$ATTR_34:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 >= 0, d2 >= 0, -d2 + 127 >= 0)>
tt.func @gather_3d_stride_permutation(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                      %y_offset: i32) -> tensor<32x16x128xf16> {
  %P = arith.constant 1024 : i32
  %B = arith.constant 16 : i32
  %D = arith.constant 128 : i32
  %s0 = arith.constant 128 : i64
  %s1 = arith.constant 131072 : i64
  %s2 = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%P, %B, %D], [%s0, %s1, %s2]
      : <f16>, <1x16x128xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x16x128xf16>, tensor<32xi32>, i32) -> tensor<32x16x128xf16>
  tt.return %data : tensor<32x16x128xf16>
}

// -----
// Block <1x1x128xf16>: a singleton at dim 1 is legal.
//
// The natural shape for an N-D gather where each addressed block holds exactly
// one row, so only the trailing contiguous axis has interior extent. This was
// rejected twice over before the relaxation: once because the block was rank 3
// when rank 2 was required, and again by the TMA min-cols rule, which demanded
// block.shape[1] >= 32 / bitwidth * 8 -- for f16 that is >= 16, so a dim 1 of 1
// failed. Both rules are gone for Spyre.
//
// The trailing 1 must survive into the result type: this is the boundary where
// a lowering that silently rank-reduced size-1 dims would produce
// tensor<32x128xf16> instead of tensor<32x1x128xf16>.

// CHECK-LABEL:   tt.func @gather_3d_inner_dim_one(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x1x128xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 16 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 2048 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_10:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_11:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_32]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_13]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_11]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_15]]] {access_tile_order = #[[$ATTR_30]], access_tile_set = #[[$ATTR_32]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_17:.*]] = ktdp.load %[[VAL_16]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_19:.*]] = ktdp.construct_memory_view %[[VAL_18]], sizes: [1024, 16, 128], strides: [2048, 128, 1] {coordinate_set = #[[$ATTR_33]], memory_space = #ktdp.memory_space<global>} : memref<1024x16x128xf16>
// CHECK:           %[[VAL_20:.*]] = builtin.unrealized_conversion_cast %[[VAL_19]] : memref<1024x16x128xf16> to !tt.tensordesc<1x1x128xf16>
// CHECK:           %[[VAL_21:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_23:.*]], %[[VAL_24:.*]], %[[VAL_25:.*]]) %[[VAL_19]][ind(%[[VAL_13]]{{\[}}%[[VAL_15]] + %[[VAL_23]]]), (%[[VAL_21]] + %[[VAL_24]]), (%[[VAL_25]])] {variables_space_order = #[[$ATTR_31]], variables_space_set = #[[$ATTR_34]]} : memref<1024x16x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x1x128xindex>
// CHECK:           %[[VAL_26:.*]] = ktdp.load %[[VAL_22]] : <32x1x128xindex> -> tensor<32x1x128xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_scatter
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_26]] : tensor<32x1x128xf16>
// CHECK:         }
tt.func @gather_3d_inner_dim_one(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                 %y_offset: i32) -> tensor<32x1x128xf16> {
  %P = arith.constant 1024 : i32
  %B = arith.constant 16 : i32
  %D = arith.constant 128 : i32
  %s0 = arith.constant 2048 : i64
  %s1 = arith.constant 128 : i64
  %s2 = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%P, %B, %D], [%s0, %s1, %s2]
      : <f16>, <1x1x128xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x1x128xf16>, tensor<32xi32>, i32) -> tensor<32x1x128xf16>
  tt.return %data : tensor<32x1x128xf16>
}
