// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// RUN: spyre-triton-opt %s -split-input-file --convert-ttir-functions --distribute-work-to-spyre-cores | FileCheck %s

// Tests for --distribute-work-to-spyre-cores at the default 1-D grid [32].
//
// DistributeWork replaces every tt.get_program_id with one shared, variadic
// ktdp.get_compute_tile_id (one index result per grid dimension) plus a
// per-axis arith.index_cast back to i32, and stamps a `grid` attribute on the
// enclosing function. It does NOT synthesize a wrapping scf.for -- a kernel
// that wants "one program per block" must write its own per-core loop.
//
// `grid` is a pass option, not a per-case one, so the files here are grouped by
// grid value: this one is grid=[32] (the pass default, so no explicit option on
// the RUN line above). Sibling files carry the other grid ranks.
//
// --convert-ttir-functions runs first so the output is func.func, which is the
// post-conversion shape most consumers see. distribute-work-tt-func.mlir omits
// it and pins the tt.func path.
//
// The generated check lines are positive and order-sensitive only: an extra op
// between two matched lines still passes. Cases pinning an *absence* or an
// exact count carry hand-added NOT / COUNT directives, called out where they
// appear.

// -----
// A 1-D kernel (a single program_id x) gets exactly one tile-id op and one
// index cast. No scf.for is synthesized.
//
// Triton source pattern:
//
//   pid = tl.program_id(0)
//   # use pid to compute this core's slice of work
//   offset = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
//
// Hand-added below the generated block: the pass must not invent a loop, must
// consume the pid, and must emit exactly one tile-id op / one cast.

// CHECK-LABEL:   func.func @replace_pid_only(
// CHECK-SAME:  %[[VAL_0:.*]]: index, %[[VAL_1:.*]]: index, %[[VAL_2:.*]]: index) attributes {grid = [32]} {
// CHECK:           %[[VAL_3:.*]] = ktdp.get_compute_tile_id : index
// CHECK:           %[[VAL_4:.*]] = arith.index_cast %[[VAL_3]] : index to i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_6:.*]] = arith.muli %[[VAL_4]], %[[VAL_5]] : i32
// CHECK-NOT:       ktdp.get_compute_tile_id
// CHECK-NOT:       arith.index_cast
// CHECK-NOT:       scf.for
// CHECK-NOT:       tt.get_program_id
// CHECK:           return
// CHECK:         }
tt.func @replace_pid_only(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>) {
  %pid = tt.get_program_id x : i32
  %c1024 = arith.constant 1024 : i32
  %offset = arith.muli %pid, %c1024 : i32
  tt.return
}

// -----
// The kernel already writes its own distribution loop. The pass replaces the
// pid and leaves that scf.for alone -- exactly one loop in, exactly one out.

// CHECK-LABEL:   func.func @explicit_loop(
// CHECK-SAME:  %[[VAL_0:.*]]: index, %[[VAL_1:.*]]: index, %[[VAL_2:.*]]: index) attributes {grid = [32]} {
// CHECK:           %[[VAL_3:.*]] = ktdp.get_compute_tile_id : index
// CHECK:           %[[VAL_4:.*]] = arith.index_cast %[[VAL_3]] : index to i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i32
// CHECK:           %[[VAL_7:.*]] = arith.constant 64 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_9:.*]] = arith.muli %[[VAL_4]], %[[VAL_7]] : i32
// CHECK:           scf.for %[[VAL_10:.*]] = %[[VAL_5]] to %[[VAL_7]] step %[[VAL_6]]  : i32 {
// CHECK:             %[[VAL_11:.*]] = arith.addi %[[VAL_9]], %[[VAL_10]] : i32
// CHECK:             %[[VAL_12:.*]] = arith.muli %[[VAL_11]], %[[VAL_8]] : i32
// CHECK:           }
// CHECK-NOT:       scf.for
// CHECK-NOT:       ktdp.get_compute_tile_id
// CHECK-NOT:       tt.get_program_id
// CHECK:           return
// CHECK:         }
tt.func @explicit_loop(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>) {
  %pid = tt.get_program_id x : i32
  %c0 = arith.constant 0 : i32
  %c1 = arith.constant 1 : i32
  %c64 = arith.constant 64 : i32
  %c1024 = arith.constant 1024 : i32
  %start = arith.muli %pid, %c64 : i32
  scf.for %i = %c0 to %c64 step %c1 : i32 {
    %offset = arith.addi %start, %i : i32
    %byte_off = arith.muli %offset, %c1024 : i32
    scf.yield
  }
  tt.return
}

// -----
// A function with no tt.get_program_id at all. No tile-id op is emitted, but
// the function still gets a grid attribute -- stamped [1], not the pass's
// grid=[32] -- so downstream consumers never have to distinguish "no grid attr
// yet" from "grid attr explicitly set to single-program".

// CHECK-LABEL:   func.func @no_program_id(
// CHECK-SAME:  %[[VAL_0:.*]]: index) attributes {grid = [1]} {
// CHECK-NOT:       ktdp.get_compute_tile_id
// CHECK:           %[[VAL_1:.*]] = arith.constant 0 : i32
// CHECK:           return
// CHECK:         }
tt.func @no_program_id(%arg0: !tt.ptr<f32>) {
  %c0 = arith.constant 0 : i32
  tt.return
}

// -----
// Complement to the 2-D case in distribute-work-multi-axis.mlir: a kernel that
// reads only axis 0 gets a single-result variadic op, printing as ": index" and
// not "index, index".
//
// The type after the op name is what pins the arity. The NOT line below rules
// out a second index result on that same op, which is the regression a plain
// positive check would miss.

// CHECK-LABEL:   func.func @pid_arity_one(
// CHECK-SAME:  %[[VAL_0:.*]]: index) attributes {grid = [32]} {
// CHECK:           %[[VAL_1:.*]] = ktdp.get_compute_tile_id : index{{$}}
// CHECK-NOT:     index, index
// CHECK:           %[[VAL_2:.*]] = arith.index_cast %[[VAL_1]] : index to i32
// CHECK-NOT:     arith.index_cast
// CHECK:           return
// CHECK:         }
tt.func @pid_arity_one(%arg0: !tt.ptr<f32>) {
  %pid = tt.get_program_id x : i32
  tt.return
}

// -----
// Two pid reads on the *same* axis. A rare Triton pattern (the compiler usually
// CSEs it) but legal: both uses rewire to the one i32 cast for axis 0, so one
// tile-id op and one cast come out despite two pid ops going in.

// CHECK-LABEL:   func.func @same_axis_twice(
// CHECK-SAME:  %[[VAL_0:.*]]: index) attributes {grid = [32]} {
// CHECK:           %[[VAL_1:.*]] = ktdp.get_compute_tile_id : index
// CHECK-NOT:     ktdp.get_compute_tile_id
// CHECK:           %[[VAL_2:.*]] = arith.index_cast %[[VAL_1]] : index to i32
// CHECK-NOT:     arith.index_cast
// CHECK:           %[[VAL_3:.*]] = arith.addi %[[VAL_2]], %[[VAL_2]] : i32
// CHECK-NOT:       tt.get_program_id
// CHECK:           return
// CHECK:         }
tt.func @same_axis_twice(%arg0: !tt.ptr<f32>) {
  %pid_a = tt.get_program_id x : i32
  %pid_b = tt.get_program_id x : i32
  %sum = arith.addi %pid_a, %pid_b : i32
  tt.return
}

// -----
// Two functions in one module. The pass takes one grid per run, so both must
// agree on dimensionality; each function gets its own tile-id op (not one
// shared across the module) and its own copy of the grid attribute.
//
// Both labels are matched in one section rather than split, because the claim
// is precisely that the second function is *also* rewritten.


// CHECK-LABEL:   func.func @kernel_a(
// CHECK-SAME:  %[[VAL_0:.*]]: index) attributes {grid = [32]} {
// CHECK:           %[[VAL_1:.*]] = ktdp.get_compute_tile_id : index
// CHECK:           %[[VAL_2:.*]] = arith.index_cast %[[VAL_1]] : index to i32
// CHECK-NOT:       tt.get_program_id
// CHECK:           return
// CHECK:         }
tt.func @kernel_a(%arg0: !tt.ptr<f32>) {
  %pid = tt.get_program_id x : i32
  tt.return
}
// CHECK-LABEL:   func.func @kernel_b(
// CHECK-SAME:  %[[VAL_0:.*]]: index) attributes {grid = [32]} {
// CHECK:           %[[VAL_1:.*]] = ktdp.get_compute_tile_id : index
// CHECK:           %[[VAL_2:.*]] = arith.index_cast %[[VAL_1]] : index to i32
// CHECK-NOT:       tt.get_program_id
// CHECK:           return
// CHECK:         }
tt.func @kernel_b(%arg0: !tt.ptr<f32>) {
  %pid = tt.get_program_id x : i32
  tt.return
}

// -----
// tt.get_num_programs x folds to the grid size on that axis. With grid=[32] the
// op disappears and every use is replaced by arith.constant 32 : i32.
//
// Triton source pattern:
//
//   pid = tl.program_id(0)
//   num_cores = tl.num_programs(0)  # folded to the grid size at compile time
//   num_tiles = tl.cdiv(N, BLOCK_SIZE)
//   tiles_per_core = tl.cdiv(num_tiles, num_cores)
//   start = pid * tiles_per_core
//
// The addi's second operand is captured back to the constant, which is what
// pins the folded *value* rather than merely the constant's presence.

// CHECK-LABEL:   func.func @num_programs_fold_1d(
// CHECK-SAME:  %[[VAL_0:.*]]: index) attributes {grid = [32]} {
// CHECK:           %[[VAL_1:.*]] = ktdp.get_compute_tile_id : index
// CHECK:           %[[VAL_2:.*]] = arith.index_cast %[[VAL_1]] : index to i32
// CHECK:           %[[VAL_3:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_4:.*]] = arith.addi %[[VAL_2]], %[[VAL_3]] : i32
// CHECK-NOT:       tt.get_num_programs
// CHECK-NOT:       tt.get_program_id
// CHECK:           return
// CHECK:         }
tt.func @num_programs_fold_1d(%arg0: !tt.ptr<f32>) {
  %pid = tt.get_program_id x : i32
  %n = tt.get_num_programs x : i32
  %sum = arith.addi %pid, %n : i32
  tt.return
}
