// CHECK:             %[[VAL_22:.*]] = arith.addf %[[VAL_20]], %[[VAL_21]] : f32
// CHECK:             linalg.yield %[[VAL_22]] : f32
// CHECK:           } -> tensor<1x256x64xf32>
// CHECK:           ktdp.store %[[VAL_19]], %[[VAL_17]] : tensor<1x256x64xf32>, <1x256x64xindex>
// CHECK:           tt.return
// CHECK:         }
tt.func @red_on(%a: !tt.ptr<f32>, %o: !tt.ptr<f32>) {
  %c0 = arith.constant 0 : index
  %ai = builtin.unrealized_conversion_cast %a : !tt.ptr<f32> to index
  %av = ktdp.construct_memory_view %ai, sizes: [256, 128], strides: [128, 1] {coordinate_set = #sin, memory_space = #ktdp.memory_space<global>} : memref<256x128xf32>
  %ad = builtin.unrealized_conversion_cast %av : memref<256x128xf32> to !tt.tensordesc<256x128xf32>
  tt.spyre_tensor_layout %ad {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : <256x128xf32>
  %at = ktdp.construct_access_tile %av[%c0, %c0] {access_tile_order = #id2, access_tile_set = #sin} : memref<256x128xf32> -> !ktdp.access_tile<256x128xindex>
  %al = ktdp.load %at : <256x128xindex> -> tensor<256x128xf32>
  %oi = builtin.unrealized_conversion_cast %o : !tt.ptr<f32> to index
  %ov = ktdp.construct_memory_view %oi, sizes: [256, 64], strides: [64, 1] {coordinate_set = #sout, memory_space = #ktdp.memory_space<global>} : memref<256x64xf32>
  %od = builtin.unrealized_conversion_cast %ov : memref<256x64xf32> to !tt.tensordesc<256x64xf32>
  tt.spyre_tensor_layout %od {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : <256x64xf32>
  %ot = ktdp.construct_access_tile %ov[%c0, %c0] {access_tile_order = #id2, access_tile_set = #sout} : memref<256x64xf32> -> !ktdp.access_tile<256x64xindex>
  %e = tensor.empty() : tensor<256x64xf32>
  %r = linalg.generic {indexing_maps = [#in3, #out], iterator_types = ["parallel", "reduction", "parallel"]} ins(%al : tensor<256x128xf32>) outs(%e : tensor<256x64xf32>) {
  ^bb0(%x: f32, %acc: f32):
    %s = arith.addf %x, %acc : f32
    linalg.yield %s : f32
  } -> tensor<256x64xf32>
  ktdp.store %r, %ot : tensor<256x64xf32>, <256x64xindex>
