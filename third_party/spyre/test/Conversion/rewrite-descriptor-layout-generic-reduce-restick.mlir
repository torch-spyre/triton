// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 255 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// RUN: spyre-triton-opt %s --rewrite-descriptor-layout-generic | FileCheck %s

// Case 4b -- reduction ON the stick axis, the lane axis named twice.
//
// Reducing across the sticks destroys the physical dim, so the output needs one
// that re-sticks the surviving lanes. That falls out of the same rule: the
// input's split dim gives two REDUCTION loops (it inherits the reduced dim's
// kind), and the output's own marker splits its lane dim into two PARALLEL loops
// that appear in no other map. Every output element is therefore written by the
// iteration, which is what lets the accumulator be a bare tensor.empty.

#in  = affine_map<(d0, d1) -> (d0, d1)>
#in3 = affine_map<(d0, d1, d2) -> (d0, d1)>
#out = affine_map<(d0, d1, d2) -> (d0, d2)>
#sin  = affine_set<(d0, d1) : (d0 >= 0, -d0 + 255 >= 0, d1 >= 0, -d1 + 127 >= 0)>
#sout = affine_set<(d0, d1) : (d0 >= 0, -d0 + 255 >= 0, d1 >= 0, -d1 + 63 >= 0)>
#id2 = affine_map<(d0, d1) -> (d0, d1)>
module {
// CHECK-LABEL:   tt.func @red_on(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>) {
