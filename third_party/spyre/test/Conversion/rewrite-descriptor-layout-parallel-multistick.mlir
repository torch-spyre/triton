// RUN: spyre-triton-opt %s --lower-descriptor-memory --lower-scalar-load --lower-compute-ops --rewrite-descriptor-layout -split-input-file | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 127 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>

// Parallel multi-stick source operands: an operand whose *parallel*
// (non-reduced) dim spans more than one stick.
//
// `accDims` holds the PER-STICK op-tile extents, because linalg.matmul requires
// its init/result extents to match the A/B slice extents. The full parallel
// extent is therefore assembled by tiling the accumulator: an outer scatter
// loop extracts the pIV'th slab of the logical accumulator, runs the reduction
// loop over it, and inserts the result back. `extractOpSlice` selects the
// parallel IV for parallel floor dims (role >= 0) and the reduction IV for
// reduction floor dims, so the two splits index independently.
//
// The scatter loop inlines at trip <= 1, so an extent-1 parallel floor dim
// (test 2) emits exactly what the plain reduction-only path emits.

// Test 1: A[M=128,K=64] stick-on-M(64) -> phys [M/64, K, M%64] = [2, 64, 64].
// M is parallel with floor extent 2, so expect ONE scf.for (the parallel
// scatter, trip 2) with no inner loop (K is a single stick). Inside it, the
// accumulator is tiled: extract_slice %acc[%iv*64, 0] [64,64] feeds
// linalg.matmul's init, and insert_slice puts the 64x64 result back into the
// 128x64 logical accumulator. A's rank-3 slice indexes the M floor dim with the
// loop IV.
module {
// CHECK-LABEL:   tt.func @parallel_floor_extent_2(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<f16>, %[[VAL_2:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf16>
// CHECK:           %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [128, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<128x64xf16>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_9:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_10:.*]] = arith.divsi %[[VAL_7]], %[[VAL_9]] : index
// CHECK:           %[[VAL_11:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_12:.*]] = arith.remsi %[[VAL_7]], %[[VAL_11]] : index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_10]], %[[VAL_8]], %[[VAL_12]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<2x64x64xf16> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_14:.*]] = ktdp.load %[[VAL_13]] : <2x64x64xindex> -> tensor<2x64x64xf16>
// CHECK:           %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf16>
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_19:.*]] = ktdp.construct_access_tile %[[VAL_16]]{{\[}}%[[VAL_17]], %[[VAL_18]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_4]]} : memref<64x64xf16> -> !ktdp.access_tile<64x64xindex>
// CHECK:           %[[VAL_20:.*]] = ktdp.load %[[VAL_19]] : <64x64xindex> -> tensor<64x64xf16>
// CHECK:           %[[VAL_21:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_memory_view %[[VAL_21]], sizes: [128, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<128x64xf16>
// CHECK:           %[[VAL_23:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_24:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_25:.*]] = ktdp.construct_access_tile %[[VAL_22]]{{\[}}%[[VAL_23]], %[[VAL_24]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<128x64xf16> -> !ktdp.access_tile<128x64xindex>
// CHECK:           %[[VAL_26:.*]] = ktdp.load %[[VAL_25]] : <128x64xindex> -> tensor<128x64xf16>
// CHECK:           %[[VAL_27:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_28:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_29:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_30:.*]] = scf.for %[[VAL_31:.*]] = %[[VAL_27]] to %[[VAL_29]] step %[[VAL_28]] iter_args(%[[VAL_32:.*]] = %[[VAL_26]]) -> (tensor<128x64xf16>) {
// CHECK:             %[[VAL_33:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_34:.*]] = arith.muli %[[VAL_31]], %[[VAL_33]] : index
// CHECK:             %[[VAL_35:.*]] = tensor.extract_slice %[[VAL_32]]{{\[}}%[[VAL_34]], 0] [64, 64] [1, 1] : tensor<128x64xf16> to tensor<64x64xf16>
// CHECK:             %[[VAL_36:.*]] = arith.constant 0 : index
// CHECK:             %[[VAL_37:.*]] = tensor.extract_slice %[[VAL_14]]{{\[}}%[[VAL_31]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf16> to tensor<64x64xf16>
// CHECK:             %[[VAL_38:.*]] = tensor.empty() : tensor<64x64xf16>
// CHECK:             %[[VAL_39:.*]] = linalg.transpose ins(%[[VAL_37]] : tensor<64x64xf16>) outs(%[[VAL_38]] : tensor<64x64xf16>) permutation = [1, 0]
// CHECK:             %[[VAL_40:.*]] = tensor.extract_slice %[[VAL_20]][0, 0] [64, 64] [1, 1] : tensor<64x64xf16> to tensor<64x64xf16>
// CHECK:             %[[VAL_41:.*]] = linalg.matmul ins(%[[VAL_39]], %[[VAL_40]] : tensor<64x64xf16>, tensor<64x64xf16>) outs(%[[VAL_35]] : tensor<64x64xf16>) -> tensor<64x64xf16>
// CHECK:             %[[VAL_42:.*]] = tensor.insert_slice %[[VAL_41]] into %[[VAL_32]]{{\[}}%[[VAL_34]], 0] [64, 64] [1, 1] : tensor<64x64xf16> into tensor<128x64xf16>
// CHECK:             scf.yield %[[VAL_42]] : tensor<128x64xf16>
// CHECK:           }
// CHECK:           %[[VAL_43:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_44:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_45:.*]] = ktdp.construct_access_tile %[[VAL_22]]{{\[}}%[[VAL_43]], %[[VAL_44]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<128x64xf16> -> !ktdp.access_tile<128x64xindex>
// CHECK:           ktdp.store %[[VAL_30]], %[[VAL_45]] : tensor<128x64xf16>, <128x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_5:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @parallel_floor_extent_2(%a: !tt.ptr<f16>, %b: !tt.ptr<f16>, %c: !tt.ptr<f16>) {
  %z = arith.constant 0 : i32
  %m = arith.constant 128 : i32
  %k = arith.constant 64 : i32
  %s64 = arith.constant 64 : i64
  %s1 = arith.constant 1 : i64
  %ad = tt.make_tensor_descriptor %a, [%m, %k], [%s64, %s1] : !tt.ptr<f16>, !tt.tensordesc<128x64xf16>
  tt.spyre_tensor_layout %ad {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf16>
  %av = tt.descriptor_load %ad[%z, %z] : !tt.tensordesc<128x64xf16> -> tensor<128x64xf16>
  %bd = tt.make_tensor_descriptor %b, [%k, %k], [%s64, %s1] : !tt.ptr<f16>, !tt.tensordesc<64x64xf16>
  %bv = tt.descriptor_load %bd[%z, %z] : !tt.tensordesc<64x64xf16> -> tensor<64x64xf16>
  %cd = tt.make_tensor_descriptor %c, [%m, %k], [%s64, %s1] : !tt.ptr<f16>, !tt.tensordesc<128x64xf16>
  %cv = tt.descriptor_load %cd[%z, %z] : !tt.tensordesc<128x64xf16> -> tensor<128x64xf16>
  %d = tt.dot %av, %bv, %cv : tensor<128x64xf16> * tensor<64x64xf16> -> tensor<128x64xf16>
  tt.descriptor_store %cd[%z, %z], %d : !tt.tensordesc<128x64xf16>, tensor<128x64xf16>
  tt.return
}
}

