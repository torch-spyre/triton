// Test 2: same layout shape, M=64 -> phys [1, 64, 64]. The parallel floor dim
// has extent 1, so the scatter loop inlines away entirely: NO scf.for, no
// accumulator extract/insert, and the C load feeds linalg.matmul's init
// directly. This is the byte-identity guard — every pre-existing fixture is in
// this shape and must be unaffected by the parallel path.
module {
// CHECK-LABEL:   tt.func @parallel_floor_extent_1(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<f16>, %[[VAL_2:.*]]: !tt.ptr<f16>) {
