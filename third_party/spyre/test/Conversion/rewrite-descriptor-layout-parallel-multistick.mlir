// CHECK: #[[$ATTR_11:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_12:.+]] = affine_set<(d0, d1, d2, d3, d4) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 1 >= 0, d2 >= 0, -d2 + 1 >= 0, d3 >= 0, -d3 + 63 >= 0, d4 >= 0, -d4 + 63 >= 0)>
// CHECK: #[[$ATTR_13:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 127 >= 0, d2 >= 0, -d2 + 127 >= 0)>
// CHECK: #[[$ATTR_14:.+]] = affine_set<(d0, d1, d2, d3) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 1 >= 0, d2 >= 0, -d2 + 63 >= 0, d3 >= 0, -d3 + 63 >= 0)>
// CHECK: #[[$ATTR_15:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 127 >= 0, d2 >= 0, -d2 + 63 >= 0)>
tt.func @parallel_floor_extent_1(%a: !tt.ptr<f16>, %b: !tt.ptr<f16>, %c: !tt.ptr<f16>) {
  %z = arith.constant 0 : i32
  %m = arith.constant 64 : i32
  %k = arith.constant 64 : i32
  %s64 = arith.constant 64 : i64
  %s1 = arith.constant 1 : i64
  %ad = tt.make_tensor_descriptor %a, [%m, %k], [%s64, %s1] : !tt.ptr<f16>, !tt.tensordesc<64x64xf16>
  tt.spyre_tensor_layout %ad {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf16>
  %av = tt.descriptor_load %ad[%z, %z] : !tt.tensordesc<64x64xf16> -> tensor<64x64xf16>
  %bd = tt.make_tensor_descriptor %b, [%k, %k], [%s64, %s1] : !tt.ptr<f16>, !tt.tensordesc<64x64xf16>
  %bv = tt.descriptor_load %bd[%z, %z] : !tt.tensordesc<64x64xf16> -> tensor<64x64xf16>
  %cd = tt.make_tensor_descriptor %c, [%m, %k], [%s64, %s1] : !tt.ptr<f16>, !tt.tensordesc<64x64xf16>
  %cv = tt.descriptor_load %cd[%z, %z] : !tt.tensordesc<64x64xf16> -> tensor<64x64xf16>
  %d = tt.dot %av, %bv, %cv : tensor<64x64xf16> * tensor<64x64xf16> -> tensor<64x64xf16>
  tt.descriptor_store %cd[%z, %z], %d : !tt.tensordesc<64x64xf16>, tensor<64x64xf16>
  tt.return
}
