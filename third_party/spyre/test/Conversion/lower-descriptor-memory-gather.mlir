// RUN: spyre-triton-opt %s -split-input-file --lower-descriptor-memory | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 511 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>

// Tests for --lower-descriptor-memory on rank-2 tt.descriptor_gather.
//
// A gather reads rows the index buffer names, so it cannot use the plain
// ktdp.construct_access_tile that load and store use -- a direct tile is a
// contiguous window. Instead it builds ktdp.construct_indirect_access_tile,
// which carries one subscript per base dimension and a region of affine maps
// over the iteration space. In the printed form the leading token says which
// kind each subscript is:
//
//   ind(%view[...])   indirect -- the address is read from the index buffer
//   (...)             direct   -- the address is arithmetic on the offsets
//
// For a rank-2 gather that comes out as ind(%idx[%c_x + %d0]) on dim 0 and
// (%c_y + %d1) on dim 1: rows are indirect, columns are a direct slice from
// y_offset.
//
// The descriptor block must have exactly one row (<1x64xf16>): dim 0 is fanned
// out one page at a time by the index buffer, so how many rows are gathered
// comes from x_offsets, not from the block. The result shape is therefore
// [len(x_offsets), block_cols], which is unrelated to the block's own dim 0.
//
// Index-buffer provenance is load-bearing. buildIndirectAccessTile resolves
// x_offsets by walking load -> construct_access_tile -> construct_memory_view
// and reusing that memref, so x_offsets must come from a tt.descriptor_load in
// the same function. A tensor-typed function argument has no such chain and is
// rejected -- see lower-descriptor-memory-invalid.mlir. Every case here stages
// its indices the way real kernels do, through a 1-D index descriptor.
//
// Two memory views per gather, and that count is the real claim.
// One view covers the index buffer and one covers the base table. Before the
// fallback was removed, a trace miss silently built a THIRD view by wrapping
// the SSA value in a fresh memref, and emitted a bare-d0 index map that was
// wrong the moment the load offset was non-zero. So "exactly two views" is
// what pins the fallback's absence, and the cases below state it with the two
//
// Note the pytest suite this replaced asserted the absence of
// unrealized_conversion_cast for the same purpose. That assertion could never
// fire -- StructuralAssertions matches op names by exact equality and the op is
// named builtin.unrealized_conversion_cast -- and the claim was false anyway:
// the pass legitimately emits those casts as type-conversion plumbing (!tt.ptr
// to index, memref back to !tt.tensordesc), and they are visible in the checks
// below. The third memory view is what the removed fallback actually built, and
// what these tests exclude.

// -----
// Rank-2 gather over a 512x128 table. 32 rows named by the index buffer, 64
// columns from y_offset.
//
// Triton source pattern:
//
//   idx_desc = tl.make_tensor_descriptor(idx_ptr, shape=[32], strides=[1],
//                                        block_shape=[32])
//   x_offsets = tl.descriptor_load(idx_desc, [0])       # tensor<32xi32>
//   data = tl.descriptor_gather(desc, x_offsets, y_offset)
//   # -> tensor<32x64xf16>
//
// The guards sit between the gather's ktdp.load and the return, inside the
// function body. Their gap is empty on clean output -- the normal state of a
// regression guard, which a regression is what fills. Controlling one means
// injecting into that gap an op whose result is consumed and which does not
// displace the SSA value the trailing anchor names; naming the anchor's own
// text controls nothing, since the anchor consumes the string.

// CHECK-LABEL:   tt.func @gather_2d_512x128(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 512 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_10]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_11]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_13:.*]] = arith.index_cast %[[VAL_9]] : i32 to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_11]]{{\[}}%[[VAL_13]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [512, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<512x128xf16>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_17]] : memref<512x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_21:.*]], %[[VAL_22:.*]]) %[[VAL_17]][ind(%[[VAL_11]]{{\[}}%[[VAL_13]] + %[[VAL_21]]]), (%[[VAL_19]] + %[[VAL_22]])] {variables_space_order = #[[$ATTR_1]], variables_space_set = #[[$ATTR_4]]} : memref<512x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_20]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_23]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_5:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_9:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @gather_2d_512x128(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                           %y_offset: i32) -> tensor<32x64xf16> {
  %M = arith.constant 512 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<32xi32>, i32) -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// Rank-2 gather over 1024x128. Same 32 indices and 64 columns; only the base
// table grows, so the base view's memref changes while the indirect tile and
// its variables_space_set stay put.

// CHECK-LABEL:   tt.func @gather_2d_1024x128(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_10]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_11]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_13:.*]] = arith.index_cast %[[VAL_9]] : i32 to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_11]]{{\[}}%[[VAL_13]]] {access_tile_order = #[[$ATTR_5]], access_tile_set = #[[$ATTR_7]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_8]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_17]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_21:.*]], %[[VAL_22:.*]]) %[[VAL_17]][ind(%[[VAL_11]]{{\[}}%[[VAL_13]] + %[[VAL_21]]]), (%[[VAL_19]] + %[[VAL_22]])] {variables_space_order = #[[$ATTR_6]], variables_space_set = #[[$ATTR_9]]} : memref<1024x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_20]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_23]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_10:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_11:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_12:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_13:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 2047 >= 0, d1 >= 0, -d1 + 255 >= 0)>
// CHECK: #[[$ATTR_14:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @gather_2d_1024x128(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                            %y_offset: i32) -> tensor<32x64xf16> {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<32xi32>, i32) -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// Rank-2 gather over 2048x256, still reading a 64-wide slice. The gather reads
// 64 of the table's 256 columns, so the base view must span all 256 for the
// y_offset slice to be addressable.

// CHECK-LABEL:   tt.func @gather_2d_2048x256(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 2048 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 256 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 256 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_10]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_12]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_11]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_13:.*]] = arith.index_cast %[[VAL_9]] : i32 to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_11]]{{\[}}%[[VAL_13]]] {access_tile_order = #[[$ATTR_10]], access_tile_set = #[[$ATTR_12]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [2048, 256], strides: [256, 1] {coordinate_set = #[[$ATTR_13]], memory_space = #ktdp.memory_space<global>} : memref<2048x256xf16>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_17]] : memref<2048x256xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_21:.*]], %[[VAL_22:.*]]) %[[VAL_17]][ind(%[[VAL_11]]{{\[}}%[[VAL_13]] + %[[VAL_21]]]), (%[[VAL_19]] + %[[VAL_22]])] {variables_space_order = #[[$ATTR_11]], variables_space_set = #[[$ATTR_14]]} : memref<2048x256xf16>, memref<32xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_20]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_23]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_15:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_16:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_17:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_18:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_19:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @gather_2d_2048x256(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                            %y_offset: i32) -> tensor<32x64xf16> {
  %M = arith.constant 2048 : i32
  %K = arith.constant 256 : i32
  %sr = arith.constant 256 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<32xi32>, i32) -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// The base view spans the full table, not the block.
//
// The block is <1x64xf16> and only 64 columns are read per gather, but the view
// must still cover all 1024x128 so any y_offset column is addressable. The
// guard pins the negative directly: a view of memref<1x64xf16> would be the
// block shape leaking into the wrong op.

// CHECK-LABEL:   tt.func @gather_base_view_is_full_shape(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_10]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_17]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_11]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_13:.*]] = arith.index_cast %[[VAL_9]] : i32 to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_11]]{{\[}}%[[VAL_13]]] {access_tile_order = #[[$ATTR_15]], access_tile_set = #[[$ATTR_17]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_18]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_17]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_21:.*]], %[[VAL_22:.*]]) %[[VAL_17]][ind(%[[VAL_11]]{{\[}}%[[VAL_13]] + %[[VAL_21]]]), (%[[VAL_19]] + %[[VAL_22]])] {variables_space_order = #[[$ATTR_16]], variables_space_set = #[[$ATTR_19]]} : memref<1024x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_20]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       memref<1x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_23]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_20:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_21:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_22:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_23:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_24:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @gather_base_view_is_full_shape(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                        %y_offset: i32) -> tensor<32x64xf16> {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<32xi32>, i32) -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// The descriptor-load trace path, with a zero offset.
//
// This is the case the removed fallback used to handle wrongly. The trace
// succeeds, so the index buffer's own view is reused for the indirect
// subscript rather than a fresh one being conjured. Exactly two views come
// fallback would make three.

// CHECK-LABEL:   tt.func @gather_traces_index_view(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_10]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_22]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_11]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_13:.*]] = arith.index_cast %[[VAL_9]] : i32 to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_11]]{{\[}}%[[VAL_13]]] {access_tile_order = #[[$ATTR_20]], access_tile_set = #[[$ATTR_22]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_23]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_17]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_21:.*]], %[[VAL_22:.*]]) %[[VAL_17]][ind(%[[VAL_11]]{{\[}}%[[VAL_13]] + %[[VAL_21]]]), (%[[VAL_19]] + %[[VAL_22]])] {variables_space_order = #[[$ATTR_21]], variables_space_set = #[[$ATTR_24]]} : memref<1024x128xf16>, memref<32xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_20]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_23]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_25:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_26:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_27:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
// CHECK: #[[$ATTR_28:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_29:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_30:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @gather_traces_index_view(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                  %y_offset: i32) -> tensor<32x64xf16> {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<32xi32>, i32) -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// The descriptor-load offset must reach the indirect subscript.
//
// Regression test for the embedding-fixture row-tile bug. When a kernel does
// idx_desc.load([offset_m]) inside a loop and then gathers with those indices,
// the gather must read indices[offset_m + d0], not indices[d0]. The old
// traceToSourceMemoryView discarded the load's offset operand, so every loop
// iteration re-read the index buffer's prefix -- rows 0-7 came out right and
// rows 8+ were identical copies of them.
//
// The fix captures the offset in the tile's captured variables, so the printed
// indirect subscript is ind(%idx[%off + %d0]) rather than ind(%idx[%d0]). The
// offset is a function argument here rather than a constant, so it stays
// visibly named in the output instead of folding into the affine map.
//
// Triton source pattern:
//
//   idx = idx_desc.load([offset_m])                 # non-zero offset
//   result = tl.descriptor_gather(desc, idx, y_offset)
//   # -> ind(%idx[%offset_m + %d0]) in the indirect access tile

// CHECK-LABEL:   tt.func @gather_captures_load_offset(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_4:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : i32
// CHECK:           %[[VAL_9:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_10]], sizes: [64], strides: [1] {coordinate_set = #[[$ATTR_27]], memory_space = #ktdp.memory_space<global>} : memref<64xi32>
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_11]] : memref<64xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_13:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_11]]{{\[}}%[[VAL_13]]] {access_tile_order = #[[$ATTR_25]], access_tile_set = #[[$ATTR_28]]} : memref<64xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_29]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_17]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_21:.*]], %[[VAL_22:.*]]) %[[VAL_17]][ind(%[[VAL_11]]{{\[}}%[[VAL_13]] + %[[VAL_21]]]), (%[[VAL_19]] + %[[VAL_22]])] {variables_space_order = #[[$ATTR_26]], variables_space_set = #[[$ATTR_30]]} : memref<1024x128xf16>, memref<64xi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_20]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_23]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_31:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_32:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_33:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_34:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_35:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @gather_captures_load_offset(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                     %offset: i32, %y_offset: i32) -> tensor<32x64xf16> {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 64 : i32
  %is = arith.constant 1 : i64
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%offset] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<32xi32>, i32) -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// A signed descriptor block type traces cleanly.
//
// Triton's frontend produces an asymmetry for an !tt.ptr<i32> index buffer:
// the descriptor block comes out <32xsi32> (signed) while tt.descriptor_load
// canonicalizes its result tensor to signless tensor<32xi32>. resolveIndexView
// therefore compares element types by integer bit width rather than identity.
// Without that, its "ConvertDescriptorLoad invariant violated" assert would
// fire on every compiled gather kernel.
//
// Note the signedness survives into the memref: the index view is
// memref<32xsi32> and the indirect tile's second operand type matches, so the
// bit-width compare is what reconciles them rather than a silent cast.

// CHECK-LABEL:   tt.func @gather_signed_index_block(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x64xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 128 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 128 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_10]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_33]], memory_space = #ktdp.memory_space<global>} : memref<32xsi32>
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_11]] : memref<32xsi32> to !tt.tensordesc<32xsi32>
// CHECK:           %[[VAL_13:.*]] = arith.index_cast %[[VAL_9]] : i32 to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_11]]{{\[}}%[[VAL_13]]] {access_tile_order = #[[$ATTR_31]], access_tile_set = #[[$ATTR_33]]} : memref<32xsi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [1024, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_34]], memory_space = #ktdp.memory_space<global>} : memref<1024x128xf16>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_17]] : memref<1024x128xf16> to !tt.tensordesc<1x64xf16>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_21:.*]], %[[VAL_22:.*]]) %[[VAL_17]][ind(%[[VAL_11]]{{\[}}%[[VAL_13]] + %[[VAL_21]]]), (%[[VAL_19]] + %[[VAL_22]])] {variables_space_order = #[[$ATTR_32]], variables_space_set = #[[$ATTR_35]]} : memref<1024x128xf16>, memref<32xsi32> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_20]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_23]] : tensor<32x64xf16>
// CHECK:         }
// CHECK: #[[$ATTR_36:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_37:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_38:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_39:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 >= 0)>
// CHECK: #[[$ATTR_40:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 >= 0)>
tt.func @gather_signed_index_block(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                   %y_offset: i32) -> tensor<32x64xf16> {
  %M = arith.constant 1024 : i32
  %K = arith.constant 128 : i32
  %sr = arith.constant 128 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xsi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xsi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <1x64xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x64xf16>, tensor<32xi32>, i32) -> tensor<32x64xf16>
  tt.return %data : tensor<32x64xf16>
}

// -----
// A 1-D source gathered as a [K, 1] column matrix.
//
// tt.descriptor_gather indexes the descriptor's outermost dimension, and the
// verifier requires the block to be at least rank 2: dim 0 is the indirect
// axis and must be size 1 in the block, and at least one trailing direct dim
// has to exist. A rank-1 block has no separate indirect axis, so it is
// structurally undefined and rejected -- see the rank-1 case in
// lower-descriptor-memory-invalid.mlir.
//
// So out[i] = in_1d[idx[i]] cannot be written with a rank-1 descriptor. The
// supported idiom is to model the same K elements as a [K, 1] column matrix
// with block_shape [1, 1]: the gather indexes dim 0 (size K) and produces a
// [32, 1] result the kernel can collapse afterwards. This case is the positive
// half of that pair -- if the verifier is ever relaxed to accept rank 1, this
// and the rejection should be revisited together.
//
// Triton source pattern:
//
//   in_desc = tl.make_tensor_descriptor(in_ptr, shape=[K, 1], strides=[1, 1],
//                                       block_shape=[1, 1])
//   out = tl.descriptor_gather(in_desc, idx, 0)   # tensor<K_INDICES x 1>

// CHECK-LABEL:   tt.func @gather_1d_source_as_column(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: i32) -> tensor<32x1xf16> {
// CHECK:           %[[VAL_3:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 1 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_6:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 32 : i32
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_10]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_38]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_11]] : memref<32xi32> to !tt.tensordesc<32xi32>
// CHECK:           %[[VAL_13:.*]] = arith.index_cast %[[VAL_9]] : i32 to index
// CHECK:           %[[VAL_14:.*]] = ktdp.construct_access_tile %[[VAL_11]]{{\[}}%[[VAL_13]]] {access_tile_order = #[[$ATTR_36]], access_tile_set = #[[$ATTR_38]]} : memref<32xi32> -> !ktdp.access_tile<32xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_14]] : <32xindex> -> tensor<32xi32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [1024, 1], strides: [1, 1] {coordinate_set = #[[$ATTR_39]], memory_space = #ktdp.memory_space<global>} : memref<1024x1xf16>
// CHECK:           %[[VAL_18:.*]] = builtin.unrealized_conversion_cast %[[VAL_17]] : memref<1024x1xf16> to !tt.tensordesc<1x1xf16>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_21:.*]], %[[VAL_22:.*]]) %[[VAL_17]][ind(%[[VAL_11]]{{\[}}%[[VAL_13]] + %[[VAL_21]]]), (%[[VAL_19]] + %[[VAL_22]])] {variables_space_order = #[[$ATTR_37]], variables_space_set = #[[$ATTR_40]]} : memref<1024x1xf16>, memref<32xi32> -> !ktdp.access_tile<32x1xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_20]] : <32x1xindex> -> tensor<32x1xf16>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       tt.descriptor_gather
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return %[[VAL_23]] : tensor<32x1xf16>
// CHECK:         }
tt.func @gather_1d_source_as_column(%ptr: !tt.ptr<f16>, %idx_ptr: !tt.ptr<i32>,
                                    %y_offset: i32) -> tensor<32x1xf16> {
  %K = arith.constant 1024 : i32
  %one = arith.constant 1 : i32
  %sr = arith.constant 1 : i64
  %sc = arith.constant 1 : i64
  %ic = arith.constant 32 : i32
  %is = arith.constant 1 : i64
  %c0 = arith.constant 0 : i32
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%ic], [%is] : <i32>, <32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0] : !tt.tensordesc<32xi32> -> tensor<32xi32>
  %desc = tt.make_tensor_descriptor %ptr, [%K, %one], [%sr, %sc] : <f16>, <1x1xf16>
  %data = tt.descriptor_gather %desc[%x_offsets, %y_offset]
      : (!tt.tensordesc<1x1xf16>, tensor<32xi32>, i32) -> tensor<32x1xf16>
  tt.return %data : tensor<32x1xf16>
}
