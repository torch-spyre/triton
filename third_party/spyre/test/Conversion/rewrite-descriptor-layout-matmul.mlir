// Test 7: Matmul source+sink — A[64x128] stick-on-K(64) (2 K-sticks, reduction loop),
// B[128x64] stick-on-N(64), D[64x64] stick-on-N(64) annotated output.
// Expected: scf.for K-reduction loop (source) + tensor.insert_slice scatter (sink)
//           + ktdp.store with physical shape [1, 64, 64].
module {
// CHECK-LABEL:   tt.func @matmul_annotated_output(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_34]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf32>
// CHECK:           %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [64, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_35]], memory_space = #ktdp.memory_space<global>} : memref<64x128xf32>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_9:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_10:.*]] = arith.divsi %[[VAL_8]], %[[VAL_9]] : index
// CHECK:           %[[VAL_11:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_12:.*]] = arith.remsi %[[VAL_8]], %[[VAL_11]] : index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_10]], %[[VAL_7]], %[[VAL_12]]] {access_tile_order = #[[$ATTR_33]], access_tile_set = #[[$ATTR_34]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_14:.*]] = ktdp.load %[[VAL_13]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:           %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [1, 128, 64], strides: [8192, 64, 1] {coordinate_set = #[[$ATTR_36]], memory_space = #ktdp.memory_space<global>} : memref<1x128x64xf32>
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [128, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_37]], memory_space = #ktdp.memory_space<global>} : memref<128x64xf32>
// CHECK:           %[[VAL_18:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_21:.*]] = arith.divsi %[[VAL_19]], %[[VAL_20]] : index
// CHECK:           %[[VAL_22:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_23:.*]] = arith.remsi %[[VAL_19]], %[[VAL_22]] : index
// CHECK:           %[[VAL_24:.*]] = ktdp.construct_access_tile %[[VAL_16]]{{\[}}%[[VAL_21]], %[[VAL_18]], %[[VAL_23]]] {access_tile_order = #[[$ATTR_33]], access_tile_set = #[[$ATTR_36]]} : memref<1x128x64xf32> -> !ktdp.access_tile<1x128x64xindex>
// CHECK:           %[[VAL_25:.*]] = ktdp.load %[[VAL_24]] : <1x128x64xindex> -> tensor<1x128x64xf32>
// CHECK:           %[[VAL_26:.*]] = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
// CHECK:           %[[VAL_27:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_28:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_29:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_30:.*]] = scf.for %[[VAL_31:.*]] = %[[VAL_27]] to %[[VAL_29]] step %[[VAL_28]] iter_args(%[[VAL_32:.*]] = %[[VAL_26]]) -> (tensor<64x64xf32>) {
// CHECK:             %[[VAL_33:.*]] = tensor.extract_slice %[[VAL_14]]{{\[}}%[[VAL_31]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_34:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_35:.*]] = arith.muli %[[VAL_31]], %[[VAL_34]] : index
// CHECK:             %[[VAL_36:.*]] = tensor.extract_slice %[[VAL_25]][0, %[[VAL_35]], 0] [1, 64, 64] [1, 1, 1] : tensor<1x128x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_37:.*]] = linalg.matmul ins(%[[VAL_33]], %[[VAL_36]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_32]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:             scf.yield %[[VAL_37]] : tensor<64x64xf32>
// CHECK:           }
// CHECK:           %[[VAL_38:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_39:.*]] = ktdp.construct_memory_view %[[VAL_38]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_38]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_40:.*]] = ktdp.construct_memory_view %[[VAL_38]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_39]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_41:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_42:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_43:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_44:.*]] = arith.divsi %[[VAL_42]], %[[VAL_43]] : index
// CHECK:           %[[VAL_45:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_46:.*]] = arith.remsi %[[VAL_42]], %[[VAL_45]] : index
// CHECK:           %[[VAL_47:.*]] = ktdp.construct_access_tile %[[VAL_39]]{{\[}}%[[VAL_44]], %[[VAL_41]], %[[VAL_46]]] {access_tile_order = #[[$ATTR_33]], access_tile_set = #[[$ATTR_38]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_48:.*]] = tensor.empty() : tensor<1x64x64xf32>
// CHECK:           %[[VAL_49:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_50:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_51:.*]] = arith.muli %[[VAL_50]], %[[VAL_49]] : index
// CHECK:           %[[VAL_52:.*]] = tensor.extract_slice %[[VAL_30]][0, %[[VAL_51]]] [64, 64] [1, 1] : tensor<64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_53:.*]] = tensor.insert_slice %[[VAL_52]] into %[[VAL_48]]{{\[}}%[[VAL_50]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<64x64xf32> into tensor<1x64x64xf32>
// CHECK:           ktdp.store %[[VAL_53]], %[[VAL_47]] : tensor<1x64x64xf32>, <1x64x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_40:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_41:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_42:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_43:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 127 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// CHECK: #[[$ATTR_44:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_45:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @matmul_annotated_output(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %d_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 128] stick-on-K(64): phys [K/64, M, K%64] = [2, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>

  // B[128, 64] stick-on-N(64): phys [N/64, K, N%64] = [1, 128, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>

  // Zero init (unannotated)
  %zero = arith.constant dense<0.0> : tensor<64x64xf32>

  %d = tt.dot %a, %b, %zero : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>

  // D[64, 64] stick-on-N(64): phys [N/64, M, N%64] = [1, 64, 64]
  //   Annotated output descriptor.
  %d_desc = tt.make_tensor_descriptor %d_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %d_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>

  tt.descriptor_store %d_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}


