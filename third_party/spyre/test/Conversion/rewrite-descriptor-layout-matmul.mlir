// CHECK:           %[[VAL_47:.*]] = ktdp.construct_access_tile %[[VAL_39]]{{\[}}%[[VAL_44]], %[[VAL_41]], %[[VAL_46]]] {access_tile_order = #[[$ATTR_40]], access_tile_set = #[[$ATTR_44]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_48:.*]] = tensor.empty() : tensor<1x64x64xf32>
// CHECK:           %[[VAL_49:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_50:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_51:.*]] = arith.muli %[[VAL_50]], %[[VAL_49]] : index
// CHECK:           %[[VAL_52:.*]] = tensor.extract_slice %[[VAL_30]][0, %[[VAL_51]]] [64, 64] [1, 1] : tensor<64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_53:.*]] = tensor.insert_slice %[[VAL_52]] into %[[VAL_48]]{{\[}}%[[VAL_50]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<64x64xf32> into tensor<1x64x64xf32>
// CHECK:           ktdp.store %[[VAL_53]], %[[VAL_47]] : tensor<1x64x64xf32>, <1x64x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_46:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_47:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_48:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// CHECK: #[[$ATTR_49:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 31 >= 0)>
tt.func @matmul_k_split_annotated_output(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %d_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 128] stick-on-K(64): phys [K/64, M, K%64] = [2, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>

  // B[128, 64] stick-on-K(64): phys [K/64, N, K%64] = [2, 64, 64]
  //   phys_src=[0,1,0] phys_op=[1,0,2] phys_arg=[64,0,64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>

  // Zero init (unannotated)
  %zero = arith.constant dense<0.0> : tensor<64x64xf32>

  %d = tt.dot %a, %b, %zero : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>

  // D[64, 64] stick-on-N(64): phys [N/64, M, N%64] = [1, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %d_desc = tt.make_tensor_descriptor %d_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %d_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>

  tt.descriptor_store %d_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}


