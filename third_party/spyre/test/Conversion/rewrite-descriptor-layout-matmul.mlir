// CHECK:           %[[VAL_40:.*]] = ktdp.construct_memory_view %[[VAL_38]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_45]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
