// Test 4: A stick-on-M, B stick-on-N (both parallel, trip=1 each).
// A[64x128] stick-on-M(64): phys [M/64, K, M%64] = [1, 128, 64]
// B[128x64] stick-on-N(64): phys [N/64, K, N%64] = [1, 128, 64]
// C unannotated [64x64].
// Expected: no scf.for (trip=1 inlined), linalg.transpose on A, no transpose on B.
module {
// CHECK-LABEL:   tt.func @matmul_both_parallel(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1, 128, 64], strides: [8192, 64, 1] {coordinate_set = #[[$ATTR_16]], memory_space = #ktdp.memory_space<global>} : memref<1x128x64xf32>
// CHECK:           %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [64, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_17]], memory_space = #ktdp.memory_space<global>} : memref<64x128xf32>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_9:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_10:.*]] = arith.divsi %[[VAL_7]], %[[VAL_9]] : index
// CHECK:           %[[VAL_11:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_12:.*]] = arith.remsi %[[VAL_7]], %[[VAL_11]] : index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_10]], %[[VAL_8]], %[[VAL_12]]] {access_tile_order = #[[$ATTR_14]], access_tile_set = #[[$ATTR_16]]} : memref<1x128x64xf32> -> !ktdp.access_tile<1x128x64xindex>
// CHECK:           %[[VAL_14:.*]] = ktdp.load %[[VAL_13]] : <1x128x64xindex> -> tensor<1x128x64xf32>
// CHECK:           %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [1, 128, 64], strides: [8192, 64, 1] {coordinate_set = #[[$ATTR_16]], memory_space = #ktdp.memory_space<global>} : memref<1x128x64xf32>
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [128, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_18]], memory_space = #ktdp.memory_space<global>} : memref<128x64xf32>
// CHECK:           %[[VAL_18:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_21:.*]] = arith.divsi %[[VAL_19]], %[[VAL_20]] : index
// CHECK:           %[[VAL_22:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_23:.*]] = arith.remsi %[[VAL_19]], %[[VAL_22]] : index
// CHECK:           %[[VAL_24:.*]] = ktdp.construct_access_tile %[[VAL_16]]{{\[}}%[[VAL_21]], %[[VAL_18]], %[[VAL_23]]] {access_tile_order = #[[$ATTR_14]], access_tile_set = #[[$ATTR_16]]} : memref<1x128x64xf32> -> !ktdp.access_tile<1x128x64xindex>
// CHECK:           %[[VAL_25:.*]] = ktdp.load %[[VAL_24]] : <1x128x64xindex> -> tensor<1x128x64xf32>
// CHECK:           %[[VAL_26:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_27:.*]] = ktdp.construct_memory_view %[[VAL_26]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_19]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_28:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_29:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_30:.*]] = ktdp.construct_access_tile %[[VAL_27]]{{\[}}%[[VAL_28]], %[[VAL_29]]] {access_tile_order = #[[$ATTR_15]], access_tile_set = #[[$ATTR_19]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           %[[VAL_31:.*]] = ktdp.load %[[VAL_30]] : <64x64xindex> -> tensor<64x64xf32>
// CHECK:           %[[VAL_32:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_33:.*]] = tensor.extract_slice %[[VAL_14]][0, 0, 0] [1, 128, 64] [1, 1, 1] : tensor<1x128x64xf32> to tensor<128x64xf32>
// CHECK:           %[[VAL_34:.*]] = tensor.empty() : tensor<64x128xf32>
// CHECK:           %[[VAL_35:.*]] = linalg.transpose ins(%[[VAL_33]] : tensor<128x64xf32>) outs(%[[VAL_34]] : tensor<64x128xf32>) permutation = [1, 0]
// CHECK:           %[[VAL_36:.*]] = tensor.extract_slice %[[VAL_25]][0, 0, 0] [1, 128, 64] [1, 1, 1] : tensor<1x128x64xf32> to tensor<128x64xf32>
// CHECK:           %[[VAL_37:.*]] = linalg.matmul ins(%[[VAL_35]], %[[VAL_36]] : tensor<64x128xf32>, tensor<128x64xf32>) outs(%[[VAL_31]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:           %[[VAL_38:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_39:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_40:.*]] = ktdp.construct_access_tile %[[VAL_27]]{{\[}}%[[VAL_38]], %[[VAL_39]]] {access_tile_order = #[[$ATTR_15]], access_tile_set = #[[$ATTR_19]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           ktdp.store %[[VAL_37]], %[[VAL_40]] : tensor<64x64xf32>, <64x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_20:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_21:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_22:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_23:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_24:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 127 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// CHECK: #[[$ATTR_25:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @matmul_both_parallel(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64
  // A[M=64, K=128] stick-on-M(64): phys [M/64, K, M%64] = [1, 128, 64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>
  // B[K=128, N=64] stick-on-N(64): phys [N/64, K, N%64] = [1, 128, 64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>
  // C unannotated [64x64]
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>
  %d = tt.dot %a, %b, %c : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>
  tt.descriptor_store %c_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}


