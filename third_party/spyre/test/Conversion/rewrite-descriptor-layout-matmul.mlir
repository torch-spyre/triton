// Test 9: Sink scatter with trip > 1 — A[64x64] stick-on-K(64), B[64x64] stick-on-N(64),
// D[64x64] stick-on-N(32) => phys [N/32, M, N%32] = [2, 64, 32].
// Source: no reduction loop (trip=1 on both inputs).
// Sink: scatter loop with trip=2 (inserting 64x32 slices into [2, 64, 32]).
module {
// CHECK-LABEL:   tt.func @matmul_parallel_scatter_output(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_47]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_48]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_9:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_10:.*]] = arith.divsi %[[VAL_8]], %[[VAL_9]] : index
// CHECK:           %[[VAL_11:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_12:.*]] = arith.remsi %[[VAL_8]], %[[VAL_11]] : index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_10]], %[[VAL_7]], %[[VAL_12]]] {access_tile_order = #[[$ATTR_46]], access_tile_set = #[[$ATTR_47]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_14:.*]] = ktdp.load %[[VAL_13]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:           %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_47]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_48]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_18:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_21:.*]] = arith.divsi %[[VAL_19]], %[[VAL_20]] : index
// CHECK:           %[[VAL_22:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_23:.*]] = arith.remsi %[[VAL_19]], %[[VAL_22]] : index
// CHECK:           %[[VAL_24:.*]] = ktdp.construct_access_tile %[[VAL_16]]{{\[}}%[[VAL_21]], %[[VAL_18]], %[[VAL_23]]] {access_tile_order = #[[$ATTR_46]], access_tile_set = #[[$ATTR_47]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_25:.*]] = ktdp.load %[[VAL_24]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:           %[[VAL_26:.*]] = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
// CHECK:           %[[VAL_27:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_28:.*]] = tensor.extract_slice %[[VAL_14]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_29:.*]] = tensor.extract_slice %[[VAL_25]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_30:.*]] = linalg.matmul ins(%[[VAL_28]], %[[VAL_29]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_26]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:           %[[VAL_31:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_32:.*]] = ktdp.construct_memory_view %[[VAL_31]], sizes: [2, 64, 32], strides: [2048, 32, 1] {coordinate_set = #[[$ATTR_49]], memory_space = #ktdp.memory_space<global>} : memref<2x64x32xf32>
// CHECK:           %[[VAL_33:.*]] = ktdp.construct_memory_view %[[VAL_31]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_48]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_34:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_35:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_36:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_37:.*]] = arith.divsi %[[VAL_35]], %[[VAL_36]] : index
// CHECK:           %[[VAL_38:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_39:.*]] = arith.remsi %[[VAL_35]], %[[VAL_38]] : index
// CHECK:           %[[VAL_40:.*]] = ktdp.construct_access_tile %[[VAL_32]]{{\[}}%[[VAL_37]], %[[VAL_34]], %[[VAL_39]]] {access_tile_order = #[[$ATTR_46]], access_tile_set = #[[$ATTR_49]]} : memref<2x64x32xf32> -> !ktdp.access_tile<2x64x32xindex>
// CHECK:           %[[VAL_41:.*]] = tensor.empty() : tensor<2x64x32xf32>
// CHECK:           %[[VAL_42:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_43:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_44:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_45:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_46:.*]] = scf.for %[[VAL_47:.*]] = %[[VAL_43]] to %[[VAL_45]] step %[[VAL_44]] iter_args(%[[VAL_48:.*]] = %[[VAL_41]]) -> (tensor<2x64x32xf32>) {
// CHECK:             %[[VAL_49:.*]] = arith.muli %[[VAL_47]], %[[VAL_42]] : index
// CHECK:             %[[VAL_50:.*]] = tensor.extract_slice %[[VAL_30]][0, %[[VAL_49]]] [64, 32] [1, 1] : tensor<64x64xf32> to tensor<64x32xf32>
// CHECK:             %[[VAL_51:.*]] = tensor.insert_slice %[[VAL_50]] into %[[VAL_48]]{{\[}}%[[VAL_47]], 0, 0] [1, 64, 32] [1, 1, 1] : tensor<64x32xf32> into tensor<2x64x32xf32>
// CHECK:             scf.yield %[[VAL_51]] : tensor<2x64x32xf32>
// CHECK:           }
// CHECK:           ktdp.store %[[VAL_46]], %[[VAL_40]] : tensor<2x64x32xf32>, <2x64x32xindex>
// CHECK:           tt.return
// CHECK:         }
tt.func @matmul_parallel_scatter_output(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %d_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 64] stick-on-K(64): phys [K/64, M, K%64] = [1, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // B[64, 64] stick-on-N(64): phys [N/64, K, N%64] = [1, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // Zero init (unannotated)
  %zero = arith.constant dense<0.0> : tensor<64x64xf32>

  %d = tt.dot %a, %b, %zero : tensor<64x64xf32> * tensor<64x64xf32> -> tensor<64x64xf32>

  // D[64, 64] stick-on-N(32): phys [N/32, M, N%32] = [2, 64, 32]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[32,0,32]
  %d_desc = tt.make_tensor_descriptor %d_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %d_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 32, 0, 32>} : !tt.tensordesc<64x64xf32>

  tt.descriptor_store %d_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}
