// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// RUN: spyre-triton-opt %s -split-input-file --convert-ttir-functions | FileCheck %s

// Tests for the --convert-ttir-functions pass: tt.func → func.func,
// tt.return → func.return, and !tt.ptr function arguments → index.
//
// The CHECK lines are autogenerated. The generator only emits positive checks,
// which assert that a line is present and that matched lines appear in order —
// an unexpected extra op between two matched lines still passes. Two of the
// cases below therefore carry a hand-added CHECK-NOT, called out where it
// appears; everything else is generator output left as-is.

// -----
// Visibility must survive the conversion. func::FuncOp::create always produces
// a public function, so each non-public marker has to be copied deliberately.
// A private helper relabeled public tells symbol-DCE and the inliner the
// opposite of the truth, and looks like a second entry point.
//
// The generated CHECK-LABEL transcribes the marker as part of the function
// line, so it pins the marker in both directions on its own: a dropped
// `private` and a spuriously added one both break the label match.

// CHECK-LABEL:   func.func @public_stays_public(
// CHECK-SAME:  %[[VAL_0:.*]]: i32) -> i32 {
// CHECK:           return %[[VAL_0]] : i32
// CHECK:         }
tt.func public @public_stays_public(%arg0: i32) -> i32 {
  tt.return %arg0 : i32
}

// -----

// CHECK-LABEL:   func.func private @private_stays_private(
// CHECK-SAME:  %[[VAL_0:.*]]: i32) -> i32 {
// CHECK:           return %[[VAL_0]] : i32
// CHECK:         }
tt.func private @private_stays_private(%arg0: i32) -> i32 {
  tt.return %arg0 : i32
}

// -----

// CHECK-LABEL:   func.func nested @nested_stays_nested(
// CHECK-SAME:  %[[VAL_0:.*]]: i32) -> i32 {
// CHECK:           return %[[VAL_0]] : i32
// CHECK:         }
tt.func nested @nested_stays_nested(%arg0: i32) -> i32 {
  tt.return %arg0 : i32
}

// -----
// Block-count independence. Nothing in the pipeline produces a CFG body today —
// Triton keeps control flow in structured scf regions — so these cases are
// pinned deliberately rather than because a fixture exercises them. They are
// the regression guard for the whole-body move: a body is carried across in one
// piece, so the number of blocks cannot matter. Copying block by block used to
// leave every non-entry block behind, and the cloned branch kept pointing at
// blocks that were then erased.
//
// The generated checks catch that failure without help: each `^bbN:` label is
// its own positive check, so a dropped block fails the match.

// The lower endpoint: one block, the shape everything produces today.

// CHECK-LABEL:   func.func @one_block(
// CHECK-SAME:  %[[VAL_0:.*]]: i32) -> i32 {
// CHECK:           return %[[VAL_0]] : i32
// CHECK:         }
tt.func public @one_block(%arg0: i32) -> i32 {
  tt.return %arg0 : i32
}

// -----
// The smallest case that used to fail: an unconditional branch to a second
// block.

// CHECK-LABEL:   func.func @two_blocks() {
// CHECK:           cf.br ^bb1
// CHECK:         ^bb1:
// CHECK:           return
// CHECK:         }
tt.func public @two_blocks() {
  cf.br ^bb1
^bb1:
  tt.return
}

// -----
// Three blocks with no values crossing between them. This pins that the old
// failure was about successor references alone, not about values that outlive
// their defining block.

// CHECK-LABEL:   func.func @three_blocks_no_values(
// CHECK-SAME:  %[[VAL_0:.*]]: i1) {
// CHECK:           cf.cond_br %[[VAL_0]], ^bb1, ^bb2
// CHECK:         ^bb1:
// CHECK:           return
// CHECK:         ^bb2:
// CHECK:           return
// CHECK:         }
tt.func public @three_blocks_no_values(%cond: i1) {
  cf.cond_br %cond, ^bb1, ^bb2
^bb1:
  tt.return
^bb2:
  tt.return
}

// -----
// Values crossing a block boundary, carried as a block argument on the
// successor. Block arguments on non-entry blocks are created by the move
// itself, which the no-values case above does not exercise. The generated
// %[[VAL_1]] binding ties the returned value to the block argument, so a move
// that produced the right shape with the wrong dataflow would still fail.

// CHECK-LABEL:   func.func @values_cross_blocks(
// CHECK-SAME:  %[[VAL_0:.*]]: i32) -> i32 {
// CHECK:           cf.br ^bb1(%[[VAL_0]] : i32)
// CHECK:         ^bb1(%[[VAL_1:.*]]: i32):
// CHECK:           return %[[VAL_1]] : i32
// CHECK:         }
tt.func public @values_cross_blocks(%arg0: i32) -> i32 {
  cf.br ^bb1(%arg0 : i32)
^bb1(%a: i32):
  tt.return %a : i32
}

// -----
// A diamond: two predecessors converge on one block. Pins that a block reached
// from more than one place is neither duplicated nor dropped.

// CHECK-LABEL:   func.func @diamond(
// CHECK-SAME:  %[[VAL_0:.*]]: i1) {
// CHECK:           cf.cond_br %[[VAL_0]], ^bb1, ^bb2
// CHECK:         ^bb1:
// CHECK:           cf.br ^bb3
// CHECK:         ^bb2:
// CHECK:           cf.br ^bb3
// CHECK:         ^bb3:
// CHECK:           return
// CHECK:         }
tt.func public @diamond(%cond: i1) {
  cf.cond_br %cond, ^bb1, ^bb2
^bb1:
  cf.br ^bb3
^bb2:
  cf.br ^bb3
^bb3:
  tt.return
}

// -----
// Passthrough. The pass rewrites tt.func and tt.return and nothing else. Ops
// from other dialects must survive untouched, including ops that carry their
// own nested region — a body is moved whole, not flattened. The generated
// checks keep scf.for's nested linalg.fill indented inside it, so a flattened
// body fails the match.

// CHECK-LABEL:   func.func @passthrough(
// CHECK-SAME:  %[[VAL_0:.*]]: index, %[[VAL_1:.*]]: index, %[[VAL_2:.*]]: index, %[[VAL_3:.*]]: f32) {
// CHECK:           %[[VAL_4:.*]] = tensor.empty() : tensor<8xf32>
// CHECK:           scf.for %[[VAL_5:.*]] = %[[VAL_0]] to %[[VAL_1]] step %[[VAL_2]] {
// CHECK:             %[[VAL_6:.*]] = linalg.fill ins(%[[VAL_3]] : f32) outs(%[[VAL_4]] : tensor<8xf32>) -> tensor<8xf32>
// CHECK:           }
// CHECK:           return
// CHECK:         }
tt.func public @passthrough(%lb: index, %ub: index, %step: index, %v: f32) {
  %e = tensor.empty() : tensor<8xf32>
  scf.for %i = %lb to %ub step %step {
    %filled = linalg.fill ins(%v : f32) outs(%e : tensor<8xf32>) -> tensor<8xf32>
  }
  tt.return
}

// -----
// !tt.ptr arguments become index, and the unrealized_conversion_cast
// placeholders that earlier memory passes leave behind via getBasePtrAsIndex
// are folded away — after the retype they would be index-to-index no-ops.
//
// CHECK-NOT is hand-added here. This failure mode is residue rather than
// absence: a surviving cast is an extra line between two matched ones, which
// positive checks alone accept. Verified by injecting a cast into the pass
// output — without the CHECK-NOT the generated checks still pass.

// CHECK-LABEL:   func.func @ptr_arg(
// CHECK-SAME:  %[[VAL_0:.*]]: index) -> index {
// CHECK-NOT:       unrealized_conversion_cast
// CHECK:           return %[[VAL_0]] : index
// CHECK:         }
tt.func public @ptr_arg(%p: !tt.ptr<f32>) -> index {
  %i = builtin.unrealized_conversion_cast %p : !tt.ptr<f32> to index
  tt.return %i : index
}

// -----
// A mixed signature: only the !tt.ptr positions change type, and every argument
// keeps its position. Position is the only key that survives this pass — later
// passes such as MaterializeBaseAddresses are positional as a result — so a
// reordering here would break them silently. The generated CHECK-SAME pins all
// three types on one line, and the %[[VAL_1]] binding on the return pins that
// it is the i32 that comes back.

// CHECK-LABEL:   func.func @mixed_signature(
// CHECK-SAME:  %[[VAL_0:.*]]: index, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: index) -> i32 {
// CHECK:           return %[[VAL_1]] : i32
// CHECK:         }
tt.func public @mixed_signature(%p0: !tt.ptr<f32>, %n: i32, %p1: !tt.ptr<f16>) -> i32 {
  tt.return %n : i32
}

// -----
// No !tt.ptr argument at all: the signature is left exactly as it was. This is
// the early-return path in finalizeFunctionSignatures.

// CHECK-LABEL:   func.func @no_ptr_args(
// CHECK-SAME:  %[[VAL_0:.*]]: i32, %[[VAL_1:.*]]: f32) -> i32 {
// CHECK:           return %[[VAL_0]] : i32
// CHECK:         }
tt.func public @no_ptr_args(%a: i32, %b: f32) -> i32 {
  tt.return %a : i32
}

// -----
// Multi-block *and* a !tt.ptr argument. The signature rewrite reads the
// function's entry block, so it has to see the moved body's real entry block.
// This is the case that catches a stray empty block left ahead of it.
//
// CHECK-NOT is hand-added for the same reason as in @ptr_arg, and pins the
// interaction: the cast fold has to still happen when the body has more than
// one block.

// CHECK-LABEL:   func.func @multi_block_ptr_arg(
// CHECK-SAME:  %[[VAL_0:.*]]: index) -> index {
// CHECK-NOT:       unrealized_conversion_cast
// CHECK:           cf.br ^bb1
// CHECK:         ^bb1:
// CHECK:           return %[[VAL_0]] : index
// CHECK:         }
tt.func public @multi_block_ptr_arg(%p: !tt.ptr<f32>) -> index {
  %i = builtin.unrealized_conversion_cast %p : !tt.ptr<f32> to index
  cf.br ^bb1
^bb1:
  tt.return %i : index
}

// -----
// A tt.func inside a nested builtin.module. tt.func is HasParent<"ModuleOp">,
// which a nested module satisfies, so this is legal input. Every traversal in
// the pass has to reach the same set of functions: converting only the direct
// children of the top-level module while still rewriting tt.return everywhere
// left a surviving tt.func whose terminator was func.return, which fails
// verification because tt.return is HasParent<"FuncOp">.
//
// CHECK-NOT is hand-added, and pins that no tt.func or tt.return survives at
// either depth. It is placed after the last positive check because it guards
// the remainder of the output.

// CHECK-LABEL:   func.func @outer_fn(
// CHECK-SAME:  %[[VAL_0:.*]]: i32) -> i32 {
// CHECK:           return %[[VAL_0]] : i32
// CHECK:         }
// CHECK:         module {
// CHECK-LABEL:   func.func @inner_fn(
// CHECK-SAME:  %[[VAL_0:.*]]: i32) -> i32 {
// CHECK:           return %[[VAL_0]] : i32
// CHECK:         }
// CHECK-NOT:     tt.func
// CHECK-NOT:     tt.return
tt.func public @outer_fn(%arg0: i32) -> i32 {
  tt.return %arg0 : i32
}

builtin.module {
  tt.func public @inner_fn(%arg0: i32) -> i32 {
    tt.return %arg0 : i32
  }
}
