// RUN: spyre-triton-opt %s --lower-descriptor-memory --lower-scalar-load --lower-compute-ops --rewrite-descriptor-layout | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0, d1, d2, d3) -> (d0, d1, d2, d3)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1, d2, d3) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 1 >= 0, d2 >= 0, -d2 + 63 >= 0, d3 >= 0, -d3 + 63 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 127 >= 0)>

// Parallel scatter inside an enclosing scf.for that carries the accumulator as
// an iter_arg — the P @ V attention inner loop.
//
//   scf.for %i iter_args(%acc = zeros : tensor<1x64x128xf16>) {
//     %v  = <stick-on-N load>                  // physical [1, 2, 64, 64]
//     %na = tt.dot %p, %v, %acc                // -> linalg.batch_matmul
//     scf.yield %na
//   }
//
// V is stick-on-N with a parallel floor extent of 2, so the scatter loop fires.
// The regression this pins: emitSourceStage must return a value of the
// CANONICAL LOGICAL type. If it returned the physical scatter container
// (tensor<2x1x64x64xf16>) instead, replaceAllUsesWith would rewrite the
// scf.yield operand while leaving the enclosing loop's iter_arg and result at
// tensor<1x64x128xf16>, and the scf.for verifier would reject:
//   'scf.for' op region iter_arg and yielded value have different type
// Scattering into `cVal` itself keeps the invariant by construction: `cVal`
// already has the full logical output shape, so no enclosing-loop retyping is
// ever needed.
//
// P is unannotated (a logical scratchpad), which is legal here because the
// shared contraction axis (K) is not stickified, so that restriction does not apply.
module {
// CHECK-LABEL:   tt.func @attn_pv(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<f16>, %[[VAL_2:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 1 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 2 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant dense<0.000000e+00> : tensor<1x64x128xf16>
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [1, 64, 64], strides: [1, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf16>
// CHECK:           %[[VAL_9:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_10:.*]] = ktdp.construct_memory_view %[[VAL_9]], sizes: [1, 2, 64, 64], strides: [8192, 4096, 64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<1x2x64x64xf16>
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_9]], sizes: [1, 64, 128], strides: [8192, 128, 1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<1x64x128xf16>
// CHECK:           %[[VAL_12:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_memory_view %[[VAL_12]], sizes: [1, 64, 128], strides: [8192, 128, 1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<1x64x128xf16>
// CHECK:           %[[VAL_14:.*]] = scf.for %[[VAL_15:.*]] = %[[VAL_3]] to %[[VAL_5]] step %[[VAL_4]] iter_args(%[[VAL_16:.*]] = %[[VAL_6]]) -> (tensor<1x64x128xf16>)  : i32 {
// CHECK:             %[[VAL_17:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_18:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_19:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_20:.*]] = ktdp.construct_access_tile %[[VAL_8]]{{\[}}%[[VAL_17]], %[[VAL_18]], %[[VAL_19]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1x64x64xf16> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:             %[[VAL_21:.*]] = ktdp.load %[[VAL_20]] : <1x64x64xindex> -> tensor<1x64x64xf16>
// CHECK:             %[[VAL_22:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_23:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_24:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:             %[[VAL_25:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_26:.*]] = arith.divsi %[[VAL_24]], %[[VAL_25]] : index
// CHECK:             %[[VAL_27:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_28:.*]] = arith.remsi %[[VAL_24]], %[[VAL_27]] : index
// CHECK:             %[[VAL_29:.*]] = ktdp.construct_access_tile %[[VAL_10]]{{\[}}%[[VAL_22]], %[[VAL_26]], %[[VAL_23]], %[[VAL_28]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<1x2x64x64xf16> -> !ktdp.access_tile<1x2x64x64xindex>
// CHECK:             %[[VAL_30:.*]] = ktdp.load %[[VAL_29]] : <1x2x64x64xindex> -> tensor<1x2x64x64xf16>
// CHECK:             %[[VAL_31:.*]] = arith.constant 0 : index
// CHECK:             %[[VAL_32:.*]] = arith.constant 1 : index
// CHECK:             %[[VAL_33:.*]] = arith.constant 2 : index
// CHECK:             %[[VAL_34:.*]] = scf.for %[[VAL_35:.*]] = %[[VAL_31]] to %[[VAL_33]] step %[[VAL_32]] iter_args(%[[VAL_36:.*]] = %[[VAL_16]]) -> (tensor<1x64x128xf16>) {
// CHECK:               %[[VAL_37:.*]] = arith.constant 64 : index
// CHECK:               %[[VAL_38:.*]] = arith.muli %[[VAL_35]], %[[VAL_37]] : index
// CHECK:               %[[VAL_39:.*]] = tensor.extract_slice %[[VAL_36]][0, 0, %[[VAL_38]]] [1, 64, 64] [1, 1, 1] : tensor<1x64x128xf16> to tensor<1x64x64xf16>
// CHECK:               %[[VAL_40:.*]] = arith.constant 0 : index
// CHECK:               %[[VAL_41:.*]] = tensor.extract_slice %[[VAL_21]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf16> to tensor<1x64x64xf16>
// CHECK:               %[[VAL_42:.*]] = tensor.extract_slice %[[VAL_30]][0, %[[VAL_35]], 0, 0] [1, 1, 64, 64] [1, 1, 1, 1] : tensor<1x2x64x64xf16> to tensor<1x64x64xf16>
// CHECK:               %[[VAL_43:.*]] = linalg.batch_matmul ins(%[[VAL_41]], %[[VAL_42]] : tensor<1x64x64xf16>, tensor<1x64x64xf16>) outs(%[[VAL_39]] : tensor<1x64x64xf16>) -> tensor<1x64x64xf16>
// CHECK:               %[[VAL_44:.*]] = tensor.insert_slice %[[VAL_43]] into %[[VAL_36]][0, 0, %[[VAL_38]]] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf16> into tensor<1x64x128xf16>
// CHECK:               scf.yield %[[VAL_44]] : tensor<1x64x128xf16>
// CHECK:             }
// CHECK:             scf.yield %[[VAL_34]] : tensor<1x64x128xf16>
// CHECK:           }
// CHECK:           %[[VAL_45:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_46:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_47:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_48:.*]] = ktdp.construct_access_tile %[[VAL_13]]{{\[}}%[[VAL_45]], %[[VAL_46]], %[[VAL_47]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_4]]} : memref<1x64x128xf16> -> !ktdp.access_tile<1x64x128xindex>
// CHECK:           ktdp.store %[[VAL_14]], %[[VAL_48]] : tensor<1x64x128xf16>, <1x64x128xindex>
// CHECK:           tt.return
// CHECK:         }
tt.func @attn_pv(%p_ptr: !tt.ptr<f16>, %v_ptr: !tt.ptr<f16>, %out_ptr: !tt.ptr<f16>) {
  %c0 = arith.constant 0 : i32
  %c1 = arith.constant 1 : i32
  %c2 = arith.constant 2 : i32
  %b1 = arith.constant 1 : i32
  %k64 = arith.constant 64 : i32
  %n128 = arith.constant 128 : i32
  %s1 = arith.constant 1 : i64
  %s64 = arith.constant 64 : i64
  %s128 = arith.constant 128 : i64
  %s8192 = arith.constant 8192 : i64
  %zf = arith.constant dense<0.0> : tensor<1x64x128xf16>
  %pd = tt.make_tensor_descriptor %p_ptr, [%b1, %k64, %k64], [%s1, %s64, %s1] : !tt.ptr<f16>, !tt.tensordesc<1x64x64xf16>
  // V[B=1,K=64,N=128] stick-on-N(64) -> phys [B, N/64, K, N%64] = [1, 2, 64, 64]
  %vd = tt.make_tensor_descriptor %v_ptr, [%b1, %k64, %n128], [%s8192, %s128, %s1] : !tt.ptr<f16>, !tt.tensordesc<1x64x128xf16>
  tt.spyre_tensor_layout %vd {phys_src = array<i64: 0, 2, 1, 2>, phys_op = array<i64: 0, 1, 0, 2>, phys_arg = array<i64: 0, 64, 0, 64>} : !tt.tensordesc<1x64x128xf16>
  %od = tt.make_tensor_descriptor %out_ptr, [%b1, %k64, %n128], [%s8192, %s128, %s1] : !tt.ptr<f16>, !tt.tensordesc<1x64x128xf16>
  %r = scf.for %i = %c0 to %c2 step %c1 iter_args(%acc = %zf) -> (tensor<1x64x128xf16>) : i32 {
    %pv = tt.descriptor_load %pd[%c0, %c0, %c0] : !tt.tensordesc<1x64x64xf16> -> tensor<1x64x64xf16>
    %vv = tt.descriptor_load %vd[%c0, %c0, %c0] : !tt.tensordesc<1x64x128xf16> -> tensor<1x64x128xf16>
    %na = tt.dot %pv, %vv, %acc : tensor<1x64x64xf16> * tensor<1x64x128xf16> -> tensor<1x64x128xf16>
    scf.yield %na : tensor<1x64x128xf16>
  }
  tt.descriptor_store %od[%c0, %c0, %c0], %r : !tt.tensordesc<1x64x128xf16>, tensor<1x64x128xf16>
  tt.return
}
}
