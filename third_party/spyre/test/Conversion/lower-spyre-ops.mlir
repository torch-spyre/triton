// arith.divf on scalar f32 operands -> spyreop.realdiv.
module {
// CHECK-LABEL:   tt.func @divf_f32(
// CHECK-SAME:  %[[VAL_0:.*]]: f32, %[[VAL_1:.*]]: f32) -> f32 {
// CHECK:           %[[VAL_2:.*]] = spyreop.realdiv %[[VAL_0]], %[[VAL_1]] : f32
// CHECK:           tt.return %[[VAL_2]] : f32
// CHECK:         }
// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
tt.func @divf_f32(%a: f32, %b: f32) -> f32 {
  %0 = arith.divf %a, %b : f32
  tt.return %0 : f32
}
}

// -----

// arith.addi is also plain index/address arithmetic, so it is only matched
// inside a linalg.generic body -- the structural signal (left behind by
// ConvertElementwiseToLinalg) that this is scalarized elementwise compute,
// not address math. i32 -> spyreop.addi32toi32.
module {
// CHECK-LABEL:   tt.func @addi_i32_inside_generic(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4xi32>) -> tensor<4xi32> {
// CHECK:           %[[VAL_1:.*]] = tensor.empty() : tensor<4xi32>
// CHECK:           %[[VAL_2:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_0]], #[[$ATTR_0]]], iterator_types = ["parallel"]} ins(%[[VAL_0]] : tensor<4xi32>) outs(%[[VAL_1]] : tensor<4xi32>) {
// CHECK:           ^bb0(%[[VAL_3:.*]]: i32, %[[VAL_4:.*]]: i32):
// CHECK:             %[[VAL_5:.*]] = spyreop.addi32toi32 %[[VAL_3]], %[[VAL_3]]
// CHECK:             linalg.yield %[[VAL_5]] : i32
// CHECK:           } -> tensor<4xi32>
// CHECK:           tt.return %[[VAL_2]] : tensor<4xi32>
// CHECK:         }
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0) -> (d0)>
tt.func @addi_i32_inside_generic(%t: tensor<4xi32>) -> tensor<4xi32> {
  %init = tensor.empty() : tensor<4xi32>
  %0 = linalg.generic {
      indexing_maps = [affine_map<(d0) -> (d0)>, affine_map<(d0) -> (d0)>],
      iterator_types = ["parallel"]}
      ins(%t : tensor<4xi32>) outs(%init : tensor<4xi32>) {
  ^bb0(%in: i32, %out: i32):
    %1 = arith.addi %in, %in : i32
    linalg.yield %1 : i32
  } -> tensor<4xi32>
  tt.return %0 : tensor<4xi32>
}
}

