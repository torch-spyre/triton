// CHECK:           ^bb0(%[[VAL_3:.*]]: i16, %[[VAL_4:.*]]: i16):
// CHECK:             %[[VAL_5:.*]] = arith.addi %[[VAL_3]], %[[VAL_3]] : i16
// CHECK:             linalg.yield %[[VAL_5]] : i16
// CHECK:           } -> tensor<4xi16>
// CHECK:           tt.return %[[VAL_2]] : tensor<4xi16>
// CHECK:         }
tt.func @addi_i16_inside_generic_survives(%t: tensor<4xi16>) -> tensor<4xi16> {
  %init = tensor.empty() : tensor<4xi16>
  %0 = linalg.generic {
      indexing_maps = [affine_map<(d0) -> (d0)>, affine_map<(d0) -> (d0)>],
      iterator_types = ["parallel"]}
      ins(%t : tensor<4xi16>) outs(%init : tensor<4xi16>) {
  ^bb0(%in: i16, %out: i16):
    %1 = arith.addi %in, %in : i16
    linalg.yield %1 : i16
  } -> tensor<4xi16>
  tt.return %0 : tensor<4xi16>
}
}

