// Plain scalar arith.addi outside any linalg.generic is index/address
// arithmetic, not scalarized compute -- left alone.
module {
// CHECK-LABEL:   tt.func @addi_i32_outside_generic_survives(
// CHECK-SAME:  %[[VAL_0:.*]]: i32, %[[VAL_1:.*]]: i32) -> i32 {
// CHECK:           %[[VAL_2:.*]] = arith.addi %[[VAL_0]], %[[VAL_1]] : i32
// CHECK:           tt.return %[[VAL_2]] : i32
// CHECK:         }
// CHECK: #[[$ATTR_3:.+]] = affine_map<(d0) -> (d0)>
tt.func @addi_i32_outside_generic_survives(%a: i32, %b: i32) -> i32 {
  %0 = arith.addi %a, %b : i32
  tt.return %0 : i32
}
}

