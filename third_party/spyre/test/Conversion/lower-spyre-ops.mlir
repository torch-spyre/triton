// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// RUN: spyre-triton-opt %s --lower-spyre-ops -split-input-file | FileCheck %s

// math.sqrt on a scalar f32 operand -> spyreop.sqrt.
module {
// CHECK-LABEL:   tt.func @sqrt_f32(
// CHECK-SAME:  %[[VAL_0:.*]]: f32) -> f32 {
// CHECK:           %[[VAL_1:.*]] = spyreop.sqrt %[[VAL_0]] : f32
// CHECK:           tt.return %[[VAL_1]] : f32
// CHECK:         }
tt.func @sqrt_f32(%s: f32) -> f32 {
  %0 = math.sqrt %s : f32
  tt.return %0 : f32
}
}

// -----

// math.sqrt on a scalar f16 operand -> spyreop.sqrt.
module {
// CHECK-LABEL:   tt.func @sqrt_f16(
// CHECK-SAME:  %[[VAL_0:.*]]: f16) -> f16 {
// CHECK:           %[[VAL_1:.*]] = spyreop.sqrt %[[VAL_0]] : f16
// CHECK:           tt.return %[[VAL_1]] : f16
// CHECK:         }
tt.func @sqrt_f16(%s: f16) -> f16 {
  %0 = math.sqrt %s : f16
  tt.return %0 : f16
}
}

// -----

// spyreop's intrinsics are scalar-only. A math.sqrt still on a tensor (not
// yet scalarized by ConvertElementwiseToLinalg) is left legal, quietly.
module {
// CHECK-LABEL:   tt.func @sqrt_tensor_survives(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4xf32>) -> tensor<4xf32> {
// CHECK:           %[[VAL_1:.*]] = math.sqrt %[[VAL_0]] : tensor<4xf32>
// CHECK:           tt.return %[[VAL_1]] : tensor<4xf32>
// CHECK:         }
tt.func @sqrt_tensor_survives(%t: tensor<4xf32>) -> tensor<4xf32> {
  %0 = math.sqrt %t : tensor<4xf32>
  tt.return %0 : tensor<4xf32>
}
}

