// -----
// Dynamic 1-D: %N is a tt.func argument, so getConstantInt sees no
// arith.constant and emits kDynamic, producing memref<?xf16>. The view gains
// an arith.index_cast'd dynamic size operand and coordinate_set becomes
// symbolic (-d0 + s0 - 1 >= 0 rather than a literal bound), so the range
// constraint is still exact but resolved at runtime.
//
// This is the store-side counterpart of the dynamic load case. The load-side
// rank-1 dynamic claim is already pinned by
// Conversion/lower-scalar-load-feeds-descriptor-shape.mlir under both pass
// orderings, so only the store direction is stated here.
//
// Triton source pattern:
//
//   # N is a runtime kernel argument
//   desc = tl.make_tensor_descriptor(ptr, shape=[N], strides=[1],
//                                    block_shape=[BLOCK])
//   tl.descriptor_store(desc, tile, [pid * BLOCK])

// CHECK-LABEL:   tt.func @store_dynamic_1d(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: tensor<64xf16>) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_5:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = ktdp.construct_memory_view %[[VAL_5]], sizes: {{\[}}%[[VAL_6]]], strides: [1] {coordinate_set = #[[$ATTR_19]], memory_space = #ktdp.memory_space<global>} : memref<?xf16>
// CHECK:           %[[VAL_8:.*]] = builtin.unrealized_conversion_cast %[[VAL_7]] : memref<?xf16> to !tt.tensordesc<64xf16>
// CHECK:           %[[VAL_9:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_10:.*]] = ktdp.construct_access_tile %[[VAL_7]]{{\[}}%[[VAL_9]]] {access_tile_order = #[[$ATTR_18]], access_tile_set = #[[$ATTR_20]]} : memref<?xf16> -> !ktdp.access_tile<64xindex>
// CHECK:           ktdp.store %[[VAL_3]], %[[VAL_10]] : tensor<64xf16>, <64xindex>
// CHECK-NOT:       tt.descriptor_store
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_21:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_22:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// CHECK: #[[$ATTR_23:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @store_dynamic_1d(%ptr: !tt.ptr<f16>, %off: i32, %N: i32,
                          %data: tensor<64xf16>) {
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
  tt.descriptor_store %desc[%off], %data : !tt.tensordesc<64xf16>, tensor<64xf16>
  tt.return
}

// -----
// Two independent descriptors in one function, one loaded and one stored.
//
// Each tt.make_tensor_descriptor is rewritten in place, so two views and two
// access tiles come out -- the pass keeps no per-function singleton. The load
// feeds the store directly, which also shows the two directions sharing one
// tile-construction path.
//
// for both descriptors, or built a spurious third, shows up here. The
//
// Triton source pattern:
//
//   a_desc = tl.make_tensor_descriptor(a_ptr, shape=[M, K], strides=[K, 1],
//                                      block_shape=[BLOCK_M, BLOCK_K])
//   b_desc = tl.make_tensor_descriptor(b_ptr, shape=[M, K], strides=[K, 1],
//                                      block_shape=[BLOCK_M, BLOCK_K])
//   tl.descriptor_store(b_desc, tl.descriptor_load(a_desc, [m, k]), [m, k])

// CHECK-LABEL:   tt.func @store_multi_descriptor(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<f16>, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: i32) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 1024 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 64 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 64 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_8:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_9:.*]] = ktdp.construct_memory_view %[[VAL_8]], sizes: [1024, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_22]], memory_space = #ktdp.memory_space<global>} : memref<1024x64xf16>
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_9]] : memref<1024x64xf16> to !tt.tensordesc<32x64xf16>
// CHECK:           %[[VAL_11:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_memory_view %[[VAL_11]], sizes: [1024, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_22]], memory_space = #ktdp.memory_space<global>} : memref<1024x64xf16>
// CHECK:           %[[VAL_13:.*]] = builtin.unrealized_conversion_cast %[[VAL_12]] : memref<1024x64xf16> to !tt.tensordesc<32x64xf16>
// CHECK:           %[[VAL_14:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_15:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_access_tile %[[VAL_9]]{{\[}}%[[VAL_14]], %[[VAL_15]]] {access_tile_order = #[[$ATTR_21]], access_tile_set = #[[$ATTR_23]]} : memref<1024x64xf16> -> !ktdp.access_tile<32x64xindex>
// CHECK:           %[[VAL_17:.*]] = ktdp.load %[[VAL_16]] : <32x64xindex> -> tensor<32x64xf16>
// CHECK:           %[[VAL_18:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_access_tile %[[VAL_12]]{{\[}}%[[VAL_18]], %[[VAL_19]]] {access_tile_order = #[[$ATTR_21]], access_tile_set = #[[$ATTR_23]]} : memref<1024x64xf16> -> !ktdp.access_tile<32x64xindex>
// CHECK:           ktdp.store %[[VAL_17]], %[[VAL_20]] : tensor<32x64xf16>, <32x64xindex>
// CHECK-NOT:       ktdp.construct_memory_view
// CHECK-NOT:       ktdp.construct_access_tile
// CHECK-NOT:       tt.descriptor_store
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
tt.func @store_multi_descriptor(%ptr_a: !tt.ptr<f16>, %ptr_b: !tt.ptr<f16>,
                                %m: i32, %k: i32) {
  %M = arith.constant 1024 : i32
  %K = arith.constant 64 : i32
  %sr = arith.constant 64 : i64
  %sc = arith.constant 1 : i64
  %desc_a = tt.make_tensor_descriptor %ptr_a, [%M, %K], [%sr, %sc] : <f16>, <32x64xf16>
  %desc_b = tt.make_tensor_descriptor %ptr_b, [%M, %K], [%sr, %sc] : <f16>, <32x64xf16>
  %data = tt.descriptor_load %desc_a[%m, %k] : !tt.tensordesc<32x64xf16> -> tensor<32x64xf16>
  tt.descriptor_store %desc_b[%m, %k], %data : !tt.tensordesc<32x64xf16>, tensor<32x64xf16>
  tt.return
}
