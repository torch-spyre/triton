// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_6]] : memref<1024xf16> to !tt.tensordesc<64xf16>
// CHECK:           %[[VAL_8:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_9:.*]] = ktdp.construct_access_tile %[[VAL_6]]{{\[}}%[[VAL_8]]] {access_tile_order = #[[$ATTR_3]], access_tile_set = #[[$ATTR_5]]} : memref<1024xf16> -> !ktdp.access_tile<64xindex>
// CHECK:           ktdp.store %[[VAL_2]], %[[VAL_9]] : tensor<64xf16>, <64xindex>
// CHECK-NOT:       tt.descriptor_store
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 4095 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @store_static_1d_1024(%ptr: !tt.ptr<f16>, %off: i32, %data: tensor<64xf16>) {
  %N = arith.constant 1024 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
  tt.descriptor_store %desc[%off], %data : !tt.tensordesc<64xf16>, tensor<64xf16>
  tt.return
}

