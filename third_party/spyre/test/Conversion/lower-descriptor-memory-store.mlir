// -----
// Static 2-D, 512x64 tensor with a 32x64 block. Rank 2 adds a second index
// operand and index_cast, and a d1 constraint pair to each affine set.
//
// Triton source pattern:
//
//   desc = tl.make_tensor_descriptor(ptr, shape=[M, K], strides=[K, 1],
//                                    block_shape=[BLOCK_M, BLOCK_K])
//   tl.descriptor_store(desc, tile, [pid_m * BLOCK_M, pid_k * BLOCK_K])

// CHECK-LABEL:   tt.func @store_static_2d_512x64(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: tensor<32x64xf16>) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 512 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 64 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant 64 : i64
// CHECK:           %[[VAL_7:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_8:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_9:.*]] = ktdp.construct_memory_view %[[VAL_8]], sizes: [512, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_10]], memory_space = #ktdp.memory_space<global>} : memref<512x64xf16>
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_9]] : memref<512x64xf16> to !tt.tensordesc<32x64xf16>
// CHECK:           %[[VAL_11:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_12:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_access_tile %[[VAL_9]]{{\[}}%[[VAL_11]], %[[VAL_12]]] {access_tile_order = #[[$ATTR_9]], access_tile_set = #[[$ATTR_11]]} : memref<512x64xf16> -> !ktdp.access_tile<32x64xindex>
// CHECK:           ktdp.store %[[VAL_3]], %[[VAL_13]] : tensor<32x64xf16>, <32x64xindex>
// CHECK-NOT:       tt.descriptor_store
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_12:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_13:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1023 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_14:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @store_static_2d_512x64(%ptr: !tt.ptr<f16>, %m: i32, %k: i32,
                                %data: tensor<32x64xf16>) {
  %M = arith.constant 512 : i32
  %K = arith.constant 64 : i32
  %sr = arith.constant 64 : i64
  %sc = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%M, %K], [%sr, %sc] : <f16>, <32x64xf16>
  tt.descriptor_store %desc[%m, %k], %data : !tt.tensordesc<32x64xf16>, tensor<32x64xf16>
  tt.return
}

