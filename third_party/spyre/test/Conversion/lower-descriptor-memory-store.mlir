// RUN: spyre-triton-opt %s -split-input-file --lower-descriptor-memory | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_1:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 511 >= 0)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>

// Tests for --lower-descriptor-memory on tt.descriptor_store.
//
// Structurally the mirror of tt.descriptor_load: the same
// ktdp.construct_memory_view over the full tensor and the same
// ktdp.construct_access_tile positioned at the store indices, with ktdp.store
// in place of ktdp.load. Only the direction of data movement differs, so the
// interesting question these cases answer is whether the view/tile split is
// really shared or was reimplemented per direction.
//
// The full-tensor-versus-block distinction is the same as on the load side:
// tt.make_tensor_descriptor's [shape...] operands give the memref extent,
// while the !tt.tensordesc<...> type gives the access tile extent. So a 512
// tensor stored in 64-wide tiles is memref<512xf16> plus
// access_tile<64xindex>, and coordinate_set's bound is 511 while
// access_tile_set's is 63.
//
// A store consumes a tensor rather than producing one, so DCE cannot erase it
// for having no users -- the ops here need no artificial return value, unlike
// the load cases. The tile being written arrives as a function argument.
//
// The builtin.unrealized_conversion_cast ops in the output are the same
// type-conversion plumbing described in lower-descriptor-memory-load.mlir:
// !tt.ptr to index for the view, and memref back to !tt.tensordesc for uses
// this pass has not rewritten. ConvertFunctions resolves them later.

// -----
// Static 1-D, N=512. The view spans 512 elements; the 64-wide tile is placed
// at %off and ktdp.store writes %data through it.
//
// Triton source pattern:
//
//   desc = tl.make_tensor_descriptor(ptr, shape=[N], strides=[1],
//                                    block_shape=[BLOCK])
//   tl.descriptor_store(desc, tile, [pid * BLOCK])
//
// The guards sit between the store and the return so they are inside the
// function body. Their gap is empty on clean output -- that is the normal
// state of a regression guard, and a regression is what fills it. Controlling
// one means injecting into that gap an op whose result is consumed, or running
// fewer passes so the excluded op survives; naming the trailing anchor's own
// text controls nothing, since the anchor consumes the string.

// CHECK-LABEL:   tt.func @store_static_1d_512(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: tensor<64xf16>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 512 : i32
// CHECK:           %[[VAL_4:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_5:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_5]], sizes: [512], strides: [1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.memory_space<global>} : memref<512xf16>
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_6]] : memref<512xf16> to !tt.tensordesc<64xf16>
// CHECK:           %[[VAL_8:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_9:.*]] = ktdp.construct_access_tile %[[VAL_6]]{{\[}}%[[VAL_8]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<512xf16> -> !ktdp.access_tile<64xindex>
// CHECK:           ktdp.store %[[VAL_2]], %[[VAL_9]] : tensor<64xf16>, <64xindex>
// CHECK-NOT:       tt.descriptor_store
// CHECK-NOT:       tt.descriptor_load
// CHECK-NOT:       tt.make_tensor_descriptor
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_3:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 1023 >= 0)>
// CHECK: #[[$ATTR_5:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @store_static_1d_512(%ptr: !tt.ptr<f16>, %off: i32, %data: tensor<64xf16>) {
  %N = arith.constant 512 : i32
  %stride = arith.constant 1 : i64
  %desc = tt.make_tensor_descriptor %ptr, [%N], [%stride] : <f16>, <64xf16>
  tt.descriptor_store %desc[%off], %data : !tt.tensordesc<64xf16>, tensor<64xf16>
  tt.return
}

// -----
// Static 1-D, N=1024. Same 64-wide block, larger tensor -- the view tracks the
// shape operand, not the descriptor type.

// CHECK-LABEL:   tt.func @store_static_1d_1024(
