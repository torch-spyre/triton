// CHECK:           %[[VAL_42:.*]] = tensor.insert_slice %[[VAL_41]] into %[[VAL_37]]{{\[}}%[[VAL_39]], 0] [1, 64] [1, 1] : tensor<64xf32> into tensor<1x64xf32>
