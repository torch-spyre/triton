// RUN: spyre-triton-opt %s --lower-descriptor-memory --lower-scalar-load --lower-compute-ops --rewrite-descriptor-layout -split-input-file | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>


// Test 1: Reduce source-only — input A[64x128] stick-on-N(64),
// reduce along dim 1 (N) => 1D output [64].
// Layout: stick-on-N for A (N=128, stick=64 => 2 N-sticks => reduction loop).
// Expected: scf.for over 2 sticks, extract_slice + linalg.reduce inside.
module {
// CHECK-LABEL:   tt.func @reduce_stick_loop(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_2:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf32>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [64, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<64x128xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_7]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_7]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_9]], %[[VAL_6]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [64], strides: [1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<64xf32>
// CHECK:           %[[VAL_16:.*]] = arith.constant 0.000000e+00 : f32
// CHECK:           %[[VAL_17:.*]] = tensor.empty() : tensor<64xf32>
// CHECK:           %[[VAL_18:.*]] = linalg.fill ins(%[[VAL_16]] : f32) outs(%[[VAL_17]] : tensor<64xf32>) -> tensor<64xf32>
// CHECK:           %[[VAL_19:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_20:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_21:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_22:.*]] = scf.for %[[VAL_23:.*]] = %[[VAL_19]] to %[[VAL_21]] step %[[VAL_20]] iter_args(%[[VAL_24:.*]] = %[[VAL_18]]) -> (tensor<64xf32>) {
// CHECK:             %[[VAL_25:.*]] = tensor.extract_slice %[[VAL_13]]{{\[}}%[[VAL_23]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_26:.*]] = linalg.reduce ins(%[[VAL_25]] : tensor<64x64xf32>) outs(%[[VAL_24]] : tensor<64xf32>) dimensions = [1]
// CHECK:               (%[[VAL_27:.*]]: f32, %[[VAL_28:.*]]: f32) {
// CHECK:                 %[[VAL_29:.*]] = arith.addf %[[VAL_27]], %[[VAL_28]] : f32
// CHECK:                 linalg.yield %[[VAL_29]] : f32
// CHECK:               }
// CHECK:             scf.yield %[[VAL_26]] : tensor<64xf32>
// CHECK:           }
// CHECK:           %[[VAL_30:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_31:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_30]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_4]]} : memref<64xf32> -> !ktdp.access_tile<64xindex>
// CHECK:           ktdp.store %[[VAL_22]], %[[VAL_31]] : tensor<64xf32>, <64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_5:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_9:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// CHECK: #[[$ATTR_10:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @reduce_stick_loop(%a_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 128] stick-on-N(64): phys [N/64, M, N%64] = [2, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>

  // C[64] — unannotated output
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32], [%c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32] : !tt.tensordesc<64xf32> -> tensor<64xf32>

  %r = "tt.reduce"(%a) ({
  ^bb0(%arg0: f32, %arg1: f32):
    %add = arith.addf %arg0, %arg1 : f32
    tt.reduce.return %add : f32
  }) {axis = 1 : i32} : (tensor<64x128xf32>) -> tensor<64xf32>

  tt.descriptor_store %c_desc[%c0_i32], %r : !tt.tensordesc<64xf32>, tensor<64xf32>
  tt.return
}
}


