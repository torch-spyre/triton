// Test 2: Reduce source+sink — A[64x128] stick-on-N(64), output C[64]
// stick-on-M(64). Reduce dim 1, then sink scatter into [1, 64] = [M/64, M%64].
module {
// CHECK-LABEL:   tt.func @reduce_annotated_output(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_2:.*]] = arith.constant 0 : i32
