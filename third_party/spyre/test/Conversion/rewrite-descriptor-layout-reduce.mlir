// Test 3: Reduce on M (dim 0) — Input[128x64] stick-on-M(64),
// reduce along dim 0 (M) => 1D output [64].
// The floor dim IS the reduction axis; expect scf.for + reduce. The per-stick
// slice is already (N, M%64), i.e. (parallel, reduced), so no transpose is
// needed — the square 64x64 extents previously hid a spurious [1, 0].
module {
// CHECK-LABEL:   tt.func @reduce_on_M(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_2:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_13]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf32>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [128, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_14]], memory_space = #ktdp.memory_space<global>} : memref<128x64xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_6]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_6]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_9]], %[[VAL_7]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_11]], access_tile_set = #[[$ATTR_13]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [64], strides: [1] {coordinate_set = #[[$ATTR_15]], memory_space = #ktdp.memory_space<global>} : memref<64xf32>
// CHECK:           %[[VAL_16:.*]] = arith.constant 0.000000e+00 : f32
// CHECK:           %[[VAL_17:.*]] = tensor.empty() : tensor<64xf32>
// CHECK:           %[[VAL_18:.*]] = linalg.fill ins(%[[VAL_16]] : f32) outs(%[[VAL_17]] : tensor<64xf32>) -> tensor<64xf32>
// CHECK:           %[[VAL_19:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_20:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_21:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_22:.*]] = scf.for %[[VAL_23:.*]] = %[[VAL_19]] to %[[VAL_21]] step %[[VAL_20]] iter_args(%[[VAL_24:.*]] = %[[VAL_18]]) -> (tensor<64xf32>) {
// The slice is (N, M%64) — reduced axis already trailing, so NO transpose.
// CHECK:             %[[VAL_25:.*]] = tensor.extract_slice %[[VAL_13]]{{\[}}%[[VAL_23]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK-NEXT:        %[[VAL_26:.*]] = linalg.reduce ins(%[[VAL_25]] : tensor<64x64xf32>) outs(%[[VAL_24]] : tensor<64xf32>) dimensions = [1]
// CHECK:               (%[[VAL_27:.*]]: f32, %[[VAL_28:.*]]: f32) {
// CHECK:                 %[[VAL_29:.*]] = arith.addf %[[VAL_27]], %[[VAL_28]] : f32
// CHECK:                 linalg.yield %[[VAL_29]] : f32
// CHECK:               }
// CHECK:             scf.yield %[[VAL_26]] : tensor<64xf32>
// CHECK:           }
// CHECK:           %[[VAL_30:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_31:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_30]]] {access_tile_order = #[[$ATTR_12]], access_tile_set = #[[$ATTR_15]]} : memref<64xf32> -> !ktdp.access_tile<64xindex>
// CHECK:           ktdp.store %[[VAL_22]], %[[VAL_31]] : tensor<64xf32>, <64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_16:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_17:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_18:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>
// CHECK: #[[$ATTR_19:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 63 >= 0)>
tt.func @reduce_on_M(%a_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[128, 64] stick-on-M(64): phys [M/64, N, M%64] = [2, 64, 64]
  //   phys_src=[0,1,0] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>

  // C[64] — unannotated output
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32], [%c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32] : !tt.tensordesc<64xf32> -> tensor<64xf32>

  %r = "tt.reduce"(%a) ({
  ^bb0(%arg0: f32, %arg1: f32):
    %add = arith.addf %arg0, %arg1 : f32
    tt.reduce.return %add : f32
  }) {axis = 0 : i32} : (tensor<128x64xf32>) -> tensor<64xf32>

  tt.descriptor_store %c_desc[%c0_i32], %r : !tt.tensordesc<64xf32>, tensor<64xf32>
  tt.return
}
}


// -----


// Test 4: Identity layout — Input[64x64] with no floordiv/mod tiling.
// The pass should handle this without synthesizing a stick loop.
module {
// CHECK-LABEL:   tt.func @reduce_identity_layout(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_2:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_18]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_18]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_6]], %[[VAL_7]]] {access_tile_order = #[[$ATTR_16]], access_tile_set = #[[$ATTR_18]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <64x64xindex> -> tensor<64x64xf32>
// CHECK:           %[[VAL_10:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_memory_view %[[VAL_10]], sizes: [64], strides: [1] {coordinate_set = #[[$ATTR_19]], memory_space = #ktdp.memory_space<global>} : memref<64xf32>
// CHECK:           %[[VAL_12:.*]] = arith.constant 0.000000e+00 : f32
// CHECK:           %[[VAL_13:.*]] = tensor.empty() : tensor<64xf32>
// CHECK:           %[[VAL_14:.*]] = linalg.fill ins(%[[VAL_12]] : f32) outs(%[[VAL_13]] : tensor<64xf32>) -> tensor<64xf32>
// CHECK:           %[[VAL_15:.*]] = linalg.reduce ins(%[[VAL_9]] : tensor<64x64xf32>) outs(%[[VAL_14]] : tensor<64xf32>) dimensions = [1]
// CHECK:             (%[[VAL_16:.*]]: f32, %[[VAL_17:.*]]: f32) {
// CHECK:               %[[VAL_18:.*]] = arith.addf %[[VAL_16]], %[[VAL_17]] : f32
// CHECK:               linalg.yield %[[VAL_18]] : f32
// CHECK:             }
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_access_tile %[[VAL_11]]{{\[}}%[[VAL_19]]] {access_tile_order = #[[$ATTR_17]], access_tile_set = #[[$ATTR_19]]} : memref<64xf32> -> !ktdp.access_tile<64xindex>
// CHECK:           ktdp.store %[[VAL_15]], %[[VAL_20]] : tensor<64xf32>, <64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_20:.+]] = affine_map<(d0, d1, d2, d3) -> (d0, d1, d2, d3)>
// CHECK: #[[$ATTR_21:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_22:.+]] = affine_set<(d0, d1, d2, d3) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 1 >= 0, d2 >= 0, -d2 + 63 >= 0, d3 >= 0, -d3 + 63 >= 0)>
// CHECK: #[[$ATTR_23:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_24:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @reduce_identity_layout(%a_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 64] identity layout: phys_src=[0,1] phys_op=[0,0] phys_arg=[0,0]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 0, 1>, phys_op = array<i64: 0, 0>, phys_arg = array<i64: 0, 0>} : !tt.tensordesc<64x64xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // C[64] — unannotated output
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32], [%c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32] : !tt.tensordesc<64xf32> -> tensor<64xf32>

  %r = "tt.reduce"(%a) ({
  ^bb0(%arg0: f32, %arg1: f32):
    %add = arith.addf %arg0, %arg1 : f32
    tt.reduce.return %add : f32
  }) {axis = 1 : i32} : (tensor<64x64xf32>) -> tensor<64xf32>

  tt.descriptor_store %c_desc[%c0_i32], %r : !tt.tensordesc<64xf32>, tensor<64xf32>
  tt.return
}
}


