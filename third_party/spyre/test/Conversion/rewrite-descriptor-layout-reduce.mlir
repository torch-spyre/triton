// CHECK:           %[[VAL_22:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_23:.*]] = scf.for %[[VAL_24:.*]] = %[[VAL_20]] to %[[VAL_22]] step %[[VAL_21]] iter_args(%[[VAL_25:.*]] = %[[VAL_19]]) -> (tensor<64xf32>) {
// CHECK:             %[[VAL_26:.*]] = tensor.extract_slice %[[VAL_13]]{{\[}}%[[VAL_24]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
