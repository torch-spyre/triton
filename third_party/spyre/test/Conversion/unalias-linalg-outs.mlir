// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// minimized and named to reflect the test intent.

// RUN: spyre-triton-opt %s --unalias-linalg-outs -split-input-file | FileCheck %s

// Tests for --unalias-linalg-outs, which replaces a linalg `outs` operand
// that is the same SSA value as one of the op's `ins` operands with a fresh
// tensor.empty of the same type.
//
// A linalg op is in destination-passing style: an `outs` operand supplies both
// the shape of the result and the initial value of each output element.
// tensor.empty keeps the shape and drops the initial value, so the rewrite is
// only valid where the op body never reads that initial value. The pass decides
// this per operand via LinalgOp::payloadUsesValueFromOperand — an elementwise
// body (which ignores its %out block argument) is rewritten; an accumulating
// body (linalg.reduce, linalg.matmul) is rejected, since dropping a live
// accumulator would silently change the result.
//
// The aliasing this pass removes is introduced upstream by
// --convert-elementwise-to-linalg, which reuses the first type-matching operand
// as `outs` rather than creating a fresh one. Downstream, the Spyre
// dataflow-scheduler maps each operand of a compute op to a freshly loaded
// value, so a value in both `ins` and `outs` is mapped twice and the second
// mapping overwrites the first. Inputs below are written in the already-linalg
// form the pass actually sees, so these tests do not depend on upstream's
// choice of which operand to reuse.
//
// Rejection cases (aliased outs whose initial value is read, non-tensor outs,
// dynamically shaped outs) are in unalias-linalg-outs-invalid.mlir.

#map = affine_map<(d0) -> (d0)>

// A two-input elementwise generic whose outs aliases its *first* ins operand.
// This is the exact shape --convert-elementwise-to-linalg produces for
// `arith.addf %a, %b : tensor<4xf32>`. The body ignores %out, so the initial
// value is dead and the rewrite applies.

// CHECK-LABEL:   func.func @outs_aliases_first_in(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4xf32>, %[[VAL_1:.*]]: tensor<4xf32>) -> tensor<4xf32> {
// CHECK:           %[[VAL_2:.*]] = tensor.empty() : tensor<4xf32>
// CHECK:           %[[VAL_3:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_0]], #[[$ATTR_0]], #[[$ATTR_0]]], iterator_types = ["parallel"]} ins(%[[VAL_0]], %[[VAL_1]] : tensor<4xf32>, tensor<4xf32>) outs(%[[VAL_2]] : tensor<4xf32>) {
// CHECK:           ^bb0(%[[VAL_4:.*]]: f32, %[[VAL_5:.*]]: f32, %[[VAL_6:.*]]: f32):
// CHECK:             %[[VAL_7:.*]] = arith.addf %[[VAL_4]], %[[VAL_5]] : f32
// CHECK:             linalg.yield %[[VAL_7]] : f32
// CHECK:           } -> tensor<4xf32>
// CHECK:           return %[[VAL_3]] : tensor<4xf32>
// CHECK:         }
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0) -> (d0)>
func.func @outs_aliases_first_in(%a: tensor<4xf32>, %b: tensor<4xf32>) -> tensor<4xf32> {
  %0 = linalg.generic {indexing_maps = [#map, #map, #map],
                       iterator_types = ["parallel"]}
       ins(%a, %b : tensor<4xf32>, tensor<4xf32>) outs(%a : tensor<4xf32>) {
  ^bb0(%in: f32, %in_0: f32, %out: f32):
    %1 = arith.addf %in, %in_0 : f32
    linalg.yield %1 : f32
  } -> tensor<4xf32>
  return %0 : tensor<4xf32>
}

// -----

// Aliasing the *second* ins operand is rewritten too — the pass tests every
// outs operand against the whole ins set, not just ins[0].

#map = affine_map<(d0) -> (d0)>

// CHECK-LABEL:   func.func @outs_aliases_second_in(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4xf32>, %[[VAL_1:.*]]: tensor<4xf32>) -> tensor<4xf32> {
// CHECK:           %[[VAL_2:.*]] = tensor.empty() : tensor<4xf32>
// CHECK:           %[[VAL_3:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_1]], #[[$ATTR_1]], #[[$ATTR_1]]], iterator_types = ["parallel"]} ins(%[[VAL_0]], %[[VAL_1]] : tensor<4xf32>, tensor<4xf32>) outs(%[[VAL_2]] : tensor<4xf32>) {
// CHECK:           ^bb0(%[[VAL_4:.*]]: f32, %[[VAL_5:.*]]: f32, %[[VAL_6:.*]]: f32):
// CHECK:             %[[VAL_7:.*]] = arith.addf %[[VAL_4]], %[[VAL_5]] : f32
// CHECK:             linalg.yield %[[VAL_7]] : f32
// CHECK:           } -> tensor<4xf32>
// CHECK:           return %[[VAL_3]] : tensor<4xf32>
// CHECK:         }
func.func @outs_aliases_second_in(%a: tensor<4xf32>, %b: tensor<4xf32>) -> tensor<4xf32> {
  %0 = linalg.generic {indexing_maps = [#map, #map, #map],
                       iterator_types = ["parallel"]}
       ins(%a, %b : tensor<4xf32>, tensor<4xf32>) outs(%b : tensor<4xf32>) {
  ^bb0(%in: f32, %in_0: f32, %out: f32):
    %1 = arith.addf %in, %in_0 : f32
    linalg.yield %1 : f32
  } -> tensor<4xf32>
  return %0 : tensor<4xf32>
}

// -----

// Named linalg ops carry the same LinalgOp interface as linalg.generic, so
// matching on the interface covers them without a per-op list. linalg.add's
// region is built by its region builder and does not read %out.

// CHECK-LABEL:   func.func @named_op(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<8x4xf32>, %[[VAL_1:.*]]: tensor<8x4xf32>) -> tensor<8x4xf32> {
// CHECK:           %[[VAL_2:.*]] = tensor.empty() : tensor<8x4xf32>
// CHECK:           %[[VAL_3:.*]] = linalg.add ins(%[[VAL_0]], %[[VAL_1]] : tensor<8x4xf32>, tensor<8x4xf32>) outs(%[[VAL_2]] : tensor<8x4xf32>) -> tensor<8x4xf32>
// CHECK:           return %[[VAL_3]] : tensor<8x4xf32>
// CHECK:         }
// CHECK: #[[$ATTR_2:.+]] = affine_map<(d0) -> (d0)>
func.func @named_op(%a: tensor<8x4xf32>, %b: tensor<8x4xf32>) -> tensor<8x4xf32> {
  %0 = linalg.add ins(%a, %b : tensor<8x4xf32>, tensor<8x4xf32>)
                  outs(%a : tensor<8x4xf32>) -> tensor<8x4xf32>
  return %0 : tensor<8x4xf32>
}

// -----

// A generic with two results and two aliased outs gets one fresh tensor.empty
// per operand, each matching that operand's own type. A single shared empty
// would be wrong here since the two results differ in element type.

#map = affine_map<(d0) -> (d0)>

// CHECK-LABEL:   func.func @two_aliased_outs(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4xf32>, %[[VAL_1:.*]]: tensor<4xi32>) -> (tensor<4xf32>, tensor<4xi32>) {
// CHECK:           %[[VAL_2:.*]] = tensor.empty() : tensor<4xf32>
// CHECK:           %[[VAL_3:.*]] = tensor.empty() : tensor<4xi32>
// CHECK:           %[[VAL_4:.*]]:2 = linalg.generic {indexing_maps = [#[[$ATTR_2]], #[[$ATTR_2]], #[[$ATTR_2]], #[[$ATTR_2]]], iterator_types = ["parallel"]} ins(%[[VAL_0]], %[[VAL_1]] : tensor<4xf32>, tensor<4xi32>) outs(%[[VAL_2]], %[[VAL_3]] : tensor<4xf32>, tensor<4xi32>) {
// CHECK:           ^bb0(%[[VAL_5:.*]]: f32, %[[VAL_6:.*]]: i32, %[[VAL_7:.*]]: f32, %[[VAL_8:.*]]: i32):
// CHECK:             %[[VAL_9:.*]] = arith.addf %[[VAL_5]], %[[VAL_5]] : f32
// CHECK:             %[[VAL_10:.*]] = arith.addi %[[VAL_6]], %[[VAL_6]] : i32
// CHECK:             linalg.yield %[[VAL_9]], %[[VAL_10]] : f32, i32
// CHECK:           } -> (tensor<4xf32>, tensor<4xi32>)
// CHECK:           return %[[VAL_11:.*]]#0, %[[VAL_11]]#1 : tensor<4xf32>, tensor<4xi32>
// CHECK:         }
// CHECK: #[[$ATTR_3:.+]] = affine_map<(d0) -> (d0)>
func.func @two_aliased_outs(%a: tensor<4xf32>, %b: tensor<4xi32>)
    -> (tensor<4xf32>, tensor<4xi32>) {
  %0:2 = linalg.generic {indexing_maps = [#map, #map, #map, #map],
                         iterator_types = ["parallel"]}
         ins(%a, %b : tensor<4xf32>, tensor<4xi32>)
         outs(%a, %b : tensor<4xf32>, tensor<4xi32>) {
  ^bb0(%inf: f32, %ini: i32, %outf: f32, %outi: i32):
    %f = arith.addf %inf, %inf : f32
    %i = arith.addi %ini, %ini : i32
    linalg.yield %f, %i : f32, i32
  } -> (tensor<4xf32>, tensor<4xi32>)
  return %0#0, %0#1 : tensor<4xf32>, tensor<4xi32>
}

// -----

// Only the aliased outs is replaced. The second outs is already a distinct
// value and must be left as-is, not swapped for a new empty — the pass is
// scoped to removing aliasing, not to rewriting every outs it sees.

#map = affine_map<(d0) -> (d0)>

// CHECK-LABEL:   func.func @only_aliased_outs_replaced(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4xf32>, %[[VAL_1:.*]]: tensor<4xi32>) -> (tensor<4xf32>, tensor<4xi32>) {
// CHECK:           %[[VAL_2:.*]] = tensor.empty() : tensor<4xi32>
// CHECK:           %[[VAL_3:.*]] = tensor.empty() : tensor<4xf32>
// CHECK:           %[[VAL_4:.*]]:2 = linalg.generic {indexing_maps = [#[[$ATTR_3]], #[[$ATTR_3]], #[[$ATTR_3]], #[[$ATTR_3]]], iterator_types = ["parallel"]} ins(%[[VAL_0]], %[[VAL_1]] : tensor<4xf32>, tensor<4xi32>) outs(%[[VAL_3]], %[[VAL_2]] : tensor<4xf32>, tensor<4xi32>) {
// CHECK:           ^bb0(%[[VAL_5:.*]]: f32, %[[VAL_6:.*]]: i32, %[[VAL_7:.*]]: f32, %[[VAL_8:.*]]: i32):
// CHECK:             %[[VAL_9:.*]] = arith.addf %[[VAL_5]], %[[VAL_5]] : f32
// CHECK:             %[[VAL_10:.*]] = arith.addi %[[VAL_6]], %[[VAL_6]] : i32
// CHECK:             linalg.yield %[[VAL_9]], %[[VAL_10]] : f32, i32
// CHECK:           } -> (tensor<4xf32>, tensor<4xi32>)
// CHECK:           return %[[VAL_11:.*]]#0, %[[VAL_11]]#1 : tensor<4xf32>, tensor<4xi32>
// CHECK:         }
// CHECK: #[[$ATTR_4:.+]] = affine_map<(d0) -> (d0)>
func.func @only_aliased_outs_replaced(%a: tensor<4xf32>, %b: tensor<4xi32>)
    -> (tensor<4xf32>, tensor<4xi32>) {
  %keep = tensor.empty() : tensor<4xi32>
  %0:2 = linalg.generic {indexing_maps = [#map, #map, #map, #map],
                         iterator_types = ["parallel"]}
         ins(%a, %b : tensor<4xf32>, tensor<4xi32>)
         outs(%a, %keep : tensor<4xf32>, tensor<4xi32>) {
  ^bb0(%inf: f32, %ini: i32, %outf: f32, %outi: i32):
    %f = arith.addf %inf, %inf : f32
    %i = arith.addi %ini, %ini : i32
    linalg.yield %f, %i : f32, i32
  } -> (tensor<4xf32>, tensor<4xi32>)
  return %0#0, %0#1 : tensor<4xf32>, tensor<4xi32>
}

// -----

// An op with no aliasing is left byte-for-byte alone: no new tensor.empty is
// introduced. The counted match below pins that the only empty in the output is
// the one already present in the input.

#map = affine_map<(d0) -> (d0)>

// CHECK-LABEL:   func.func @no_aliasing(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4xf32>, %[[VAL_1:.*]]: tensor<4xf32>) -> tensor<4xf32> {
// CHECK:           %[[VAL_2:.*]] = tensor.empty() : tensor<4xf32>
// CHECK:           %[[VAL_3:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_4]], #[[$ATTR_4]], #[[$ATTR_4]]], iterator_types = ["parallel"]} ins(%[[VAL_0]], %[[VAL_1]] : tensor<4xf32>, tensor<4xf32>) outs(%[[VAL_2]] : tensor<4xf32>) {
// CHECK:           ^bb0(%[[VAL_4:.*]]: f32, %[[VAL_5:.*]]: f32, %[[VAL_6:.*]]: f32):
// CHECK:             %[[VAL_7:.*]] = arith.addf %[[VAL_4]], %[[VAL_5]] : f32
// CHECK:             linalg.yield %[[VAL_7]] : f32
// CHECK:           } -> tensor<4xf32>
// CHECK:           return %[[VAL_3]] : tensor<4xf32>
// CHECK:         }
func.func @no_aliasing(%a: tensor<4xf32>, %b: tensor<4xf32>) -> tensor<4xf32> {
  %init = tensor.empty() : tensor<4xf32>
  %0 = linalg.generic {indexing_maps = [#map, #map, #map],
                       iterator_types = ["parallel"]}
       ins(%a, %b : tensor<4xf32>, tensor<4xf32>) outs(%init : tensor<4xf32>) {
  ^bb0(%in: f32, %in_0: f32, %out: f32):
    %1 = arith.addf %in, %in_0 : f32
    linalg.yield %1 : f32
  } -> tensor<4xf32>
  return %0 : tensor<4xf32>
}

// -----

// A reduction whose outs is NOT aliased is left alone. This guards the guard:
// the pass must not reach for its accumulator-reads-outs rejection on every
// linalg.reduce it walks, only on one that actually aliases. LowerComputeOps
// emits this shape for tt.reduce, so it is present in the real pipeline.

// CHECK-LABEL:   func.func @unaliased_reduction(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4x8xf32>) -> tensor<4xf32> {
// CHECK:           %[[VAL_1:.*]] = tensor.empty() : tensor<4xf32>
// CHECK:           %[[VAL_2:.*]] = linalg.reduce ins(%[[VAL_0]] : tensor<4x8xf32>) outs(%[[VAL_1]] : tensor<4xf32>) dimensions = [1]
// CHECK:             (%[[VAL_3:.*]]: f32, %[[VAL_4:.*]]: f32) {
// CHECK:               %[[VAL_5:.*]] = arith.addf %[[VAL_3]], %[[VAL_4]] : f32
// CHECK:               linalg.yield %[[VAL_5]] : f32
// CHECK:             }
// CHECK:           return %[[VAL_2]] : tensor<4xf32>
// CHECK:         }
// CHECK: #[[$ATTR_5:.+]] = affine_map<(d0) -> (d0)>
func.func @unaliased_reduction(%a: tensor<4x8xf32>) -> tensor<4xf32> {
  %init = tensor.empty() : tensor<4xf32>
  %r = linalg.reduce ins(%a : tensor<4x8xf32>) outs(%init : tensor<4xf32>)
       dimensions = [1]
    (%in: f32, %acc: f32) {
      %s = arith.addf %in, %acc : f32
      linalg.yield %s : f32
    }
  return %r : tensor<4xf32>
}

// -----

// Aliasing inside a region (here an scf.for body) is rewritten too: the pass
// walks the whole module, not just the top level of each function. The fresh
// tensor.empty must land inside the loop body, before the op it feeds.

#map = affine_map<(d0) -> (d0)>

// CHECK-LABEL:   func.func @aliased_inside_region(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4xf32>) -> tensor<4xf32> {
// CHECK:           %[[VAL_1:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_2:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_3:.*]] = arith.constant 4 : index
// CHECK:           %[[VAL_4:.*]] = scf.for %[[VAL_5:.*]] = %[[VAL_1]] to %[[VAL_3]] step %[[VAL_2]] iter_args(%[[VAL_6:.*]] = %[[VAL_0]]) -> (tensor<4xf32>) {
// CHECK:             %[[VAL_7:.*]] = tensor.empty() : tensor<4xf32>
// CHECK:             %[[VAL_8:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_5]], #[[$ATTR_5]]], iterator_types = ["parallel"]} ins(%[[VAL_6]] : tensor<4xf32>) outs(%[[VAL_7]] : tensor<4xf32>) {
// CHECK:             ^bb0(%[[VAL_9:.*]]: f32, %[[VAL_10:.*]]: f32):
// CHECK:               %[[VAL_11:.*]] = arith.mulf %[[VAL_9]], %[[VAL_9]] : f32
// CHECK:               linalg.yield %[[VAL_11]] : f32
// CHECK:             } -> tensor<4xf32>
// CHECK:             scf.yield %[[VAL_8]] : tensor<4xf32>
// CHECK:           }
// CHECK:           return %[[VAL_4]] : tensor<4xf32>
// CHECK:         }
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0, d1) -> (d0, d1)>
func.func @aliased_inside_region(%a: tensor<4xf32>) -> tensor<4xf32> {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %c4 = arith.constant 4 : index
  %r = scf.for %i = %c0 to %c4 step %c1 iter_args(%acc = %a) -> tensor<4xf32> {
    %0 = linalg.generic {indexing_maps = [#map, #map],
                         iterator_types = ["parallel"]}
         ins(%acc : tensor<4xf32>) outs(%acc : tensor<4xf32>) {
    ^bb0(%in: f32, %out: f32):
      %1 = arith.mulf %in, %in : f32
      linalg.yield %1 : f32
    } -> tensor<4xf32>
    scf.yield %0 : tensor<4xf32>
  }
  return %r : tensor<4xf32>
}

// -----

// A dynamically shaped outs is rewritten too. tensor.empty needs one size
// operand per '?' dimension, so the pass measures each dynamic extent off the
// value it is replacing with a tensor.dim. That value is an ins operand of the
// same op, so it is already defined at the insertion point. The static
// dimension (4) comes from the type and produces no tensor.dim.

#map2 = affine_map<(d0, d1) -> (d0, d1)>

// CHECK-LABEL:   func.func @dynamic_shape(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<?x4xf32>) -> tensor<?x4xf32> {
// CHECK:           %[[VAL_1:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_2:.*]] = tensor.dim %[[VAL_0]], %[[VAL_1]] : tensor<?x4xf32>
// CHECK:           %[[VAL_3:.*]] = tensor.empty(%[[VAL_2]]) : tensor<?x4xf32>
// CHECK:           %[[VAL_4:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_6]], #[[$ATTR_6]]], iterator_types = ["parallel", "parallel"]} ins(%[[VAL_0]] : tensor<?x4xf32>) outs(%[[VAL_3]] : tensor<?x4xf32>) {
// CHECK:           ^bb0(%[[VAL_5:.*]]: f32, %[[VAL_6:.*]]: f32):
// CHECK:             %[[VAL_7:.*]] = arith.mulf %[[VAL_5]], %[[VAL_5]] : f32
// CHECK:             linalg.yield %[[VAL_7]] : f32
// CHECK:           } -> tensor<?x4xf32>
// CHECK:           return %[[VAL_4]] : tensor<?x4xf32>
// CHECK:         }
func.func @dynamic_shape(%a: tensor<?x4xf32>) -> tensor<?x4xf32> {
  %0 = linalg.generic {indexing_maps = [#map2, #map2],
                       iterator_types = ["parallel", "parallel"]}
       ins(%a : tensor<?x4xf32>) outs(%a : tensor<?x4xf32>) {
  ^bb0(%in: f32, %out: f32):
    %1 = arith.mulf %in, %in : f32
    linalg.yield %1 : f32
  } -> tensor<?x4xf32>
  return %0 : tensor<?x4xf32>
}
