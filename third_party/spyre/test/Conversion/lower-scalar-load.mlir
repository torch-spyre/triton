// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_1:.+]] = affine_set<(d0) : (d0 >= 0, -d0 >= 0)>
// RUN: spyre-triton-opt %s --lower-scalar-load -split-input-file | FileCheck %s

// Tests for --lower-scalar-load: a *scalar* tt.load (pointer operand
// !tt.ptr<ElemT>, scalar result ElemT), as opposed to tensor-of-pointers
// tt.load (out of scope for this pass; see [LowerPointerChainMemory] in
// Passes.td).
//
// Every positive case lowers to the single-element 1-D chain:
//   ktdp.construct_memory_view -> ktdp.construct_access_tile -> ktdp.load
//   -> tensor.extract
// A single dim of extent 1, not rank 0 -- rank-0 shaped types are not a
// supported interchange form downstream, while a single-element 1-D vector
// is.
//
// For masked loads, the mask must be a compile-time constant (a
// materialized arith.constant i1) -- Spyre has no runtime control-flow
// divergence, so a mask that might depend on runtime data is refused with a
// diagnostic rather than lowered to a runtime branch; see
// lower-scalar-load-invalid.mlir for those cases.

// -----

// Load a scalar through a bare pointer (no addptr chain, no mask). The
// pointer is cast straight to `index` (via `getBasePtrAsIndex`, an
// unrealized_conversion_cast that survives until ConvertFunctions) and used
// directly as the single-element 1-D memory view's offset -- no
// arith.addi folding is needed since there's no tt.addptr chain.
//
// Triton source:
//   x = tl.load(ptr)  # ptr: tl.pointer_type(tl.float16), scalar load
//
// The loaded value is stored back out via tt.store (left untouched by this
// pass -- raw scalar stores are out of scope), matching how a scalar load
// is typically consumed in a real kernel. The coordinate_set /
// access_tile_set affine set is pinned literally here (1 dim, 0 symbols, 2
// constraints); later cases elide it since it is incidental there.
// CHECK-LABEL:   tt.func @bare_pointer(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_2:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_2]], sizes: [1], strides: [1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.memory_space<global>} : memref<1xf16>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_3]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_1]]} : memref<1xf16> -> !ktdp.access_tile<1xindex>
// CHECK:           %[[VAL_6:.*]] = ktdp.load %[[VAL_5]] : <1xindex> -> tensor<1xf16>
// CHECK:           %[[VAL_7:.*]] = tensor.extract %[[VAL_6]]{{\[}}%[[VAL_3]]] : tensor<1xf16>
// CHECK:           tt.store %[[VAL_1]], %[[VAL_7]] : !tt.ptr<f16>
// CHECK:           tt.return
// CHECK:         }
// CHECK-NOT:     tt.load
// CHECK: #[[$ATTR_2:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0) : (d0 >= 0, -d0 >= 0)>
tt.func @bare_pointer(%ptr: !tt.ptr<f16>, %out: !tt.ptr<f16>) {
  %v = tt.load %ptr : !tt.ptr<f16>
  tt.store %out, %v : !tt.ptr<f16>
  tt.return
}

// -----

// A scalar tt.addptr chain feeding the load is folded into a single index
// offset with plain arith.addi -- no element-size scaling (striding is the
// kernel author's responsibility).
//
// Triton source:
//   p = ptr + idx        # tt.addptr, offset in elements -- no scaling
//   x = tl.load(p)        # scalar load through the shifted pointer
//
// The tt.addptr op itself becomes dead once the fold consumes it and the
// tt.load is replaced; cleanupDeadOps sweeps it at the end of the pass, so
// it must be absent from the result.
// CHECK-LABEL:   tt.func @addptr_chain_folded(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_3:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_5:.*]] = arith.addi %[[VAL_4]], %[[VAL_3]] : index
// CHECK:           %[[VAL_6:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_7:.*]] = ktdp.construct_memory_view %[[VAL_5]], sizes: [1], strides: [1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<1xf16>
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_access_tile %[[VAL_7]]{{\[}}%[[VAL_6]]] {access_tile_order = #[[$ATTR_2]], access_tile_set = #[[$ATTR_3]]} : memref<1xf16> -> !ktdp.access_tile<1xindex>
// CHECK:           %[[VAL_9:.*]] = ktdp.load %[[VAL_8]] : <1xindex> -> tensor<1xf16>
// CHECK:           %[[VAL_10:.*]] = tensor.extract %[[VAL_9]]{{\[}}%[[VAL_6]]] : tensor<1xf16>
// CHECK:           tt.store %[[VAL_2]], %[[VAL_10]] : !tt.ptr<f16>
// CHECK:           tt.return
// CHECK:         }
// CHECK-NOT:     tt.load
// CHECK-NOT:     tt.addptr
// CHECK-NOT:     arith.muli
// CHECK: #[[$ATTR_4:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_5:.+]] = affine_set<(d0) : (d0 >= 0, -d0 >= 0)>
tt.func @addptr_chain_folded(%ptr: !tt.ptr<f16>, %idx: i32, %out: !tt.ptr<f16>) {
  %p = tt.addptr %ptr, %idx : !tt.ptr<f16>, i32
  %v = tt.load %p : !tt.ptr<f16>
  tt.store %out, %v : !tt.ptr<f16>
  tt.return
}

// -----

// resolveScalarAddress loops over an arbitrary-length tt.addptr chain, not
// just a single hop: two chained tt.addptr ops must fold into one
// arith.addi chain -- exactly two adds, both tt.addptr ops swept as dead.
//
// Triton source:
//   p = ptr + a         # tt.addptr, offset in elements
//   p = p + b            # a second tt.addptr on the shifted pointer
//   x = tl.load(p)        # scalar load through the twice-shifted pointer
//
// CHECK-LABEL:   tt.func @addptr_chain_multi_hop(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: i32, %[[VAL_3:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_4:.*]] = arith.index_cast %[[VAL_2]] : i32 to index
// CHECK:           %[[VAL_5:.*]] = arith.index_cast %[[VAL_1]] : i32 to index
// CHECK:           %[[VAL_6:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK-NEXT:      %[[VAL_7:.*]] = arith.addi %[[VAL_6]], %[[VAL_5]] : index
// CHECK-NEXT:      %[[VAL_8:.*]] = arith.addi %[[VAL_7]], %[[VAL_4]] : index
// CHECK-NOT:       arith.addi
// CHECK:           %[[VAL_9:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_10:.*]] = ktdp.construct_memory_view %[[VAL_8]], sizes: [1], strides: [1] {coordinate_set = #[[$ATTR_5]], memory_space = #ktdp.memory_space<global>} : memref<1xf16>
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_access_tile %[[VAL_10]]{{\[}}%[[VAL_9]]] {access_tile_order = #[[$ATTR_4]], access_tile_set = #[[$ATTR_5]]} : memref<1xf16> -> !ktdp.access_tile<1xindex>
// CHECK:           %[[VAL_12:.*]] = ktdp.load %[[VAL_11]] : <1xindex> -> tensor<1xf16>
// CHECK:           %[[VAL_13:.*]] = tensor.extract %[[VAL_12]]{{\[}}%[[VAL_9]]] : tensor<1xf16>
// CHECK:           tt.store %[[VAL_3]], %[[VAL_13]] : !tt.ptr<f16>
// CHECK:           tt.return
// CHECK:         }
// CHECK-NOT:     tt.addptr
// CHECK-NOT:     arith.muli
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0) : (d0 >= 0, -d0 >= 0)>
tt.func @addptr_chain_multi_hop(%ptr: !tt.ptr<f16>, %a: i32, %b: i32, %out: !tt.ptr<f16>) {
  %p0 = tt.addptr %ptr, %a : !tt.ptr<f16>, i32
  %p1 = tt.addptr %p0, %b : !tt.ptr<f16>, i32
  %v = tt.load %p1 : !tt.ptr<f16>
  tt.store %out, %v : !tt.ptr<f16>
  tt.return
}

