// The pass is not element-type-specific: integer and float types of
// various widths all lower to the same single-element 1-D chain, just with
// a different element type. One function per type, each split off into its
// own section below.
// CHECK-LABEL:   tt.func @elem_i32(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<i32>, %[[VAL_1:.*]]: !tt.ptr<i32>) {
// CHECK:           %[[VAL_2:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_2]], sizes: [1], strides: [1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<1xi32>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_access_tile %[[VAL_4]]{{\[}}%[[VAL_3]]] {access_tile_order = #[[$ATTR_6]], access_tile_set = #[[$ATTR_7]]} : memref<1xi32> -> !ktdp.access_tile<1xindex>
// CHECK:           %[[VAL_6:.*]] = ktdp.load %[[VAL_5]] : <1xindex> -> tensor<1xi32>
// CHECK:           %[[VAL_7:.*]] = tensor.extract %[[VAL_6]]{{\[}}%[[VAL_3]]] : tensor<1xi32>
// CHECK:           tt.store %[[VAL_1]], %[[VAL_7]] : !tt.ptr<i32>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_8:.+]] = affine_map<(d0) -> (d0)>
// CHECK: #[[$ATTR_9:.+]] = affine_set<(d0) : (d0 >= 0, -d0 >= 0)>
tt.func @elem_i32(%ptr: !tt.ptr<i32>, %out: !tt.ptr<i32>) {
  %v = tt.load %ptr : !tt.ptr<i32>
  tt.store %out, %v : !tt.ptr<i32>
  tt.return
}

