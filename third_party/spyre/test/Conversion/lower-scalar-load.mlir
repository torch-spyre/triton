// -----

// A masked scalar load whose mask is a materialized arith.constant true
// drops straight through to the unconditional read -- no runtime branch is
// ever emitted, since Spyre has no runtime control-flow divergence to lower
// one to.
//
// Triton source:
//   x = tl.load(ptr, mask=True)  # compile-time-true guard, unconditional read
// CHECK-LABEL:   tt.func @masked_constant_true(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: f16, %[[VAL_2:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant true
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_5:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1], strides: [1] {coordinate_set = #[[$ATTR_17]], memory_space = #ktdp.memory_space<global>} : memref<1xf16>
// CHECK:           %[[VAL_7:.*]] = ktdp.construct_access_tile %[[VAL_6]]{{\[}}%[[VAL_5]]] {access_tile_order = #[[$ATTR_16]], access_tile_set = #[[$ATTR_17]]} : memref<1xf16> -> !ktdp.access_tile<1xindex>
// CHECK:           %[[VAL_8:.*]] = ktdp.load %[[VAL_7]] : <1xindex> -> tensor<1xf16>
// CHECK:           %[[VAL_9:.*]] = tensor.extract %[[VAL_8]]{{\[}}%[[VAL_5]]] : tensor<1xf16>
// CHECK:           tt.store %[[VAL_2]], %[[VAL_9]] : !tt.ptr<f16>
// CHECK:           tt.return
// CHECK:         }
// CHECK-NOT:     tt.load
// CHECK-NOT:     scf.if
tt.func @masked_constant_true(%ptr: !tt.ptr<f16>, %other: f16, %out: !tt.ptr<f16>) {
  %mask = arith.constant true
  %v = tt.load %ptr, %mask, %other : !tt.ptr<f16>
  tt.store %out, %v : !tt.ptr<f16>
  tt.return
}

// -----

// A masked scalar load whose mask is a materialized arith.constant false,
// with an explicit `other`, performs no read at all -- the op is replaced
// directly by `other`.
//
// Triton source:
//   x = tl.load(ptr, mask=False, other=0.0)  # compile-time-false guard, explicit fallback
//
// No zero fallback constant is materialized -- %other is used directly.
// The one surviving arith.constant is the now-dead mask value, left for
// the pipeline's later canonicalize/CSE rather than swept here -- see
// LowerScalarLoad.cpp's narrowed cleanup. The block below is pinned line
// for line so a second constant sneaking in would break the match.
// CHECK-LABEL:   tt.func @masked_constant_false_with_other(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: f16, %[[VAL_2:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant false
// CHECK-NEXT:      %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK-NEXT:      tt.store %[[VAL_2]], %[[VAL_1]] : !tt.ptr<f16>
// CHECK-NEXT:      tt.return
// CHECK-NEXT:    }
// CHECK-NOT:     ktdp.load
// CHECK-NOT:     scf.if
// CHECK-NOT:     tt.load
tt.func @masked_constant_false_with_other(%ptr: !tt.ptr<f16>, %other: f16, %out: !tt.ptr<f16>) {
  %mask = arith.constant false
  %v = tt.load %ptr, %mask, %other : !tt.ptr<f16>
  tt.store %out, %v : !tt.ptr<f16>
  tt.return
}

// -----

// A masked scalar load whose mask is a materialized arith.constant false,
// with no `other`, performs no read and yields a materialized zero of the
// element type instead.
//
// Triton source:
//   x = tl.load(ptr, mask=False)  # compile-time-false guard, implicit zero fallback
// CHECK-LABEL:   tt.func @masked_constant_false_without_other(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_2:.*]] = arith.constant false
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_4:.*]] = arith.constant 0.000000e+00 : f16
// CHECK:           tt.store %[[VAL_1]], %[[VAL_4]] : !tt.ptr<f16>
// CHECK:           tt.return
// CHECK:         }
// CHECK-NOT:     ktdp.load
// CHECK-NOT:     scf.if
// CHECK-NOT:     tt.load
tt.func @masked_constant_false_without_other(%ptr: !tt.ptr<f16>, %out: !tt.ptr<f16>) {
  %mask = arith.constant false
  %v = tt.load %ptr, %mask : !tt.ptr<f16>
  tt.store %out, %v : !tt.ptr<f16>
  tt.return
}

// -----

// A tensor-of-pointers tt.load (pointer operand shaped as a tensor of
// !tt.ptr<ElemT>, not a bare scalar pointer) is out of scope for this pass
// and must remain legal/untouched -- the dynamic legality predicate must
// not fire for it.
//
// Triton source:
//   x = tl.load(ptr + tl.arange(0, BLOCK))  # tensor-of-pointers load
//   # NOT handled by this pass: pointer operand is a tensor of pointers,
//   # not a bare scalar !tt.ptr -- that path belongs to the separate,
//   # still-unimplemented [LowerPointerChainMemory].
// CHECK-LABEL:   tt.func @tensor_of_pointers_untouched(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<4x!tt.ptr<f16>>) {
// CHECK:           %[[VAL_1:.*]] = tt.load %[[VAL_0]] : tensor<4x!tt.ptr<f16>>
// CHECK:           tt.store %[[VAL_0]], %[[VAL_1]] : tensor<4x!tt.ptr<f16>>
// CHECK:           tt.return
// CHECK:         }
// CHECK-NOT:     ktdp.construct_memory_view
// CHECK-NOT:     ktdp.construct_access_tile
tt.func @tensor_of_pointers_untouched(%ptrs: tensor<4x!tt.ptr<f16>>) {
  %v = tt.load %ptrs : tensor<4x!tt.ptr<f16>>
  tt.store %ptrs, %v : tensor<4x!tt.ptr<f16>>
  tt.return
}

// -----

// A pointer-to-pointer tt.load (!tt.ptr<!tt.ptr<f16>> -- valid Triton IR,
// since PointerType::verify only rejects tensor pointees, not pointer
// pointees) must be left legal/untouched, not matched by isScalarPtr. Only
// integer/float pointees are lowerable: the single-element 1-D
// memref/tensor chain requires a MemRefElementTypeInterface element type,
// and the zero-fallback path requires getZeroAttr to have a case for it --
// neither holds for PointerType.
// CHECK-LABEL:   tt.func @ptr_to_ptr_untouched(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<!tt.ptr<f16>>, %[[VAL_1:.*]]: !tt.ptr<!tt.ptr<f16>>) {
// CHECK:           %[[VAL_2:.*]] = tt.load %[[VAL_0]] : !tt.ptr<!tt.ptr<f16>>
// CHECK:           tt.store %[[VAL_1]], %[[VAL_2]] : !tt.ptr<!tt.ptr<f16>>
// CHECK:           tt.return
// CHECK:         }
// CHECK-NOT:     ktdp.construct_memory_view
tt.func @ptr_to_ptr_untouched(%ptr: !tt.ptr<!tt.ptr<f16>>, %out: !tt.ptr<!tt.ptr<f16>>) {
  %v = tt.load %ptr : !tt.ptr<!tt.ptr<f16>>
  tt.store %out, %v : !tt.ptr<!tt.ptr<f16>>
  tt.return
}
