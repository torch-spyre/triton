// RUN: spyre-triton-opt %s --lower-descriptor-memory --lower-scalar-load --lower-compute-ops --rewrite-descriptor-layout -split-input-file | FileCheck %s

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_1:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_2:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 511 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_3:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 511 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_4:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 31 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_5:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 127 >= 0)>


// Test: Gather with layout annotation on the source descriptor.
// The indirect access tile should be rebuilt on the physical memView,
// with the physical block shape and remapped subscript maps.

module {
// CHECK-LABEL:   tt.func @gather_with_layout(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [2, 512, 64], strides: [32768, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<2x512x64xf32>
// CHECK:           %[[VAL_9:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [512, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<512x128xf32>
// CHECK:           %[[VAL_10:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_11:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_12:.*]], %[[VAL_13:.*]], %[[VAL_14:.*]]) %[[VAL_8]][((%[[VAL_10]] + %[[VAL_12]] * 64 + %[[VAL_14]]) floordiv 64), ind(%[[VAL_5]]{{\[}}%[[VAL_6]] + %[[VAL_13]]]), ((%[[VAL_10]] + %[[VAL_12]] * 64 + %[[VAL_14]]) mod 64)] {variables_space_order = #[[$ATTR_0]], variables_space_set = #[[$ATTR_4]]} : memref<2x512x64xf32>, memref<32xi32> -> !ktdp.access_tile<2x32x64xindex>
// CHECK:           %[[VAL_15:.*]] = ktdp.load %[[VAL_11]] : <2x32x64xindex> -> tensor<2x32x64xf32>
// CHECK:           %[[VAL_16:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [2, 32, 64], strides: [2048, 64, 1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<2x32x64xf32>
// CHECK:           %[[VAL_18:.*]] = ktdp.construct_memory_view %[[VAL_16]], sizes: [32, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_5]], memory_space = #ktdp.memory_space<global>} : memref<32x128xf32>
// CHECK:           %[[VAL_19:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_20:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_21:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_22:.*]] = arith.divsi %[[VAL_20]], %[[VAL_21]] : index
// CHECK:           %[[VAL_23:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_24:.*]] = arith.remsi %[[VAL_20]], %[[VAL_23]] : index
// CHECK:           %[[VAL_25:.*]] = ktdp.construct_access_tile %[[VAL_17]]{{\[}}%[[VAL_22]], %[[VAL_19]], %[[VAL_24]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_4]]} : memref<2x32x64xf32> -> !ktdp.access_tile<2x32x64xindex>
// CHECK:           ktdp.store %[[VAL_15]], %[[VAL_25]] : tensor<2x32x64xf32>, <2x32x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_8:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 511 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_9:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 127 >= 0)>
tt.func @gather_with_layout(%data_ptr: !tt.ptr<f32>, %idx_ptr: !tt.ptr<i32>, %out_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c512_i32 = arith.constant 512 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c1_i64 = arith.constant 1 : i64
  %c32_i32 = arith.constant 32 : i32
  %c32_i64 = arith.constant 32 : i64

  // Index descriptor: 32-element 1-D tensor holding row indices.
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%c32_i32], [%c1_i64]
      : !tt.ptr<i32>, !tt.tensordesc<32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0_i32] : !tt.tensordesc<32xi32> -> tensor<32xi32>

  // Data descriptor: [512, 128] with stick-on-N layout (stick=64).
  //   phys_src=[1, 0, 1] phys_op=[1, 0, 2] phys_arg=[64, 0, 64]
  //   => physical shape [N/64, M, N%64] = [2, 512, 64]
  %data_desc = tt.make_tensor_descriptor %data_ptr, [%c512_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<1x128xf32>
  tt.spyre_tensor_layout %data_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<1x128xf32>

  // Gather 32 non-contiguous rows.
  %gathered = tt.descriptor_gather %data_desc[%x_offsets, %c0_i32]
      : (!tt.tensordesc<1x128xf32>, tensor<32xi32>, i32) -> tensor<32x128xf32>

  // Store the gathered result to a physical-annotated output.
  %out_desc = tt.make_tensor_descriptor %out_ptr, [%c32_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<32x128xf32>
  tt.spyre_tensor_layout %out_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<32x128xf32>
  tt.descriptor_store %out_desc[%c0_i32, %c0_i32], %gathered : !tt.tensordesc<32x128xf32>, tensor<32x128xf32>

  tt.return
}
}


// -----

// Test: Gather without layout annotation — indirect access tile stays logical.
// The marker is NOT on the gather source, so the pass should not touch it.

module {
// CHECK-LABEL:   tt.func @gather_no_layout(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [512, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_8]], memory_space = #ktdp.memory_space<global>} : memref<512x128xf32>
// CHECK:           %[[VAL_9:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_10:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_11:.*]], %[[VAL_12:.*]]) %[[VAL_8]][ind(%[[VAL_5]]{{\[}}%[[VAL_6]] + %[[VAL_11]]]), (%[[VAL_9]] + %[[VAL_12]])] {variables_space_order = #[[$ATTR_6]], variables_space_set = #[[$ATTR_9]]} : memref<512x128xf32>, memref<32xi32> -> !ktdp.access_tile<32x128xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_10]] : <32x128xindex> -> tensor<32x128xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [32, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_9]], memory_space = #ktdp.memory_space<global>} : memref<32x128xf32>
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_16]], %[[VAL_17]]] {access_tile_order = #[[$ATTR_6]], access_tile_set = #[[$ATTR_9]]} : memref<32x128xf32> -> !ktdp.access_tile<32x128xindex>
// CHECK:           ktdp.store %[[VAL_13]], %[[VAL_18]] : tensor<32x128xf32>, <32x128xindex>
// CHECK:           tt.return
// CHECK:         }
tt.func @gather_no_layout(%data_ptr: !tt.ptr<f32>, %idx_ptr: !tt.ptr<i32>, %out_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c512_i32 = arith.constant 512 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c1_i64 = arith.constant 1 : i64
  %c32_i32 = arith.constant 32 : i32
  %c32_i64 = arith.constant 32 : i64

  // Index descriptor.
  %idx_desc = tt.make_tensor_descriptor %idx_ptr, [%c32_i32], [%c1_i64]
      : !tt.ptr<i32>, !tt.tensordesc<32xi32>
  %x_offsets = tt.descriptor_load %idx_desc[%c0_i32] : !tt.tensordesc<32xi32> -> tensor<32xi32>

  // Data descriptor: NO layout annotation.
  %data_desc = tt.make_tensor_descriptor %data_ptr, [%c512_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<1x128xf32>

  // Gather 32 non-contiguous rows — stays logical.
  %gathered = tt.descriptor_gather %data_desc[%x_offsets, %c0_i32]
      : (!tt.tensordesc<1x128xf32>, tensor<32xi32>, i32) -> tensor<32x128xf32>

  // Store to keep alive.
  %out_desc = tt.make_tensor_descriptor %out_ptr, [%c32_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<32x128xf32>
  tt.descriptor_store %out_desc[%c0_i32, %c0_i32], %gathered : !tt.tensordesc<32x128xf32>, tensor<32x128xf32>

  tt.return
}
}
