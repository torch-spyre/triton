// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<(d0) -> (d0)>
// RUN: spyre-triton-opt %s --convert-elementwise-to-linalg -split-input-file | FileCheck %s

// Tests for upstream MLIR's --convert-elementwise-to-linalg, which the Spyre
// TTIR->KTDP pipeline appends after LowerComputeOps. The pass rewrites every op
// carrying the ElementwiseMappable trait (all of arith and math) that has at
// least one ranked-tensor operand into a linalg.generic with identity indexing
// maps and the original op, now scalar, in the body.
//
// The pass itself is upstream code and is not re-tested here. These tests pin
// the two carve-outs the Spyre backend depends on: scalar-only ops are left
// alone (linalg.reduce combiner regions are built from scalar arith and would
// become malformed otherwise), and dense arith.constant is left alone (it does
// not carry the trait; rewriting it to tensor.empty + linalg.fill is deferred).
//
// Most CHECK lines below are autogenerated and transcribe each converted body
// in full, so a tensor-typed op surviving the pass would break the ordered
// match on its own. CHECK-NOT is used only where an invariant is about an op
// that must never be *created*, which a transcript of what was created cannot
// express.

// A tensor-typed binary op becomes a linalg.generic with the op in its body.
// Tile width 7 divides no natural vector width, so a shape-assuming
// implementation would break here.

// CHECK-LABEL:   tt.func @binary_f32(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<7xf32>, %[[VAL_1:.*]]: tensor<7xf32>) -> tensor<7xf32> {
// CHECK:           %[[VAL_2:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_0]], #[[$ATTR_0]], #[[$ATTR_0]]], iterator_types = ["parallel"]} ins(%[[VAL_0]], %[[VAL_1]] : tensor<7xf32>, tensor<7xf32>) outs(%[[VAL_0]] : tensor<7xf32>) {
// CHECK:           ^bb0(%[[VAL_3:.*]]: f32, %[[VAL_4:.*]]: f32, %[[VAL_5:.*]]: f32):
// CHECK:             %[[VAL_6:.*]] = arith.mulf %[[VAL_3]], %[[VAL_4]] : f32
// CHECK:             linalg.yield %[[VAL_6]] : f32
// CHECK:           } -> tensor<7xf32>
// CHECK:           tt.return %[[VAL_2]] : tensor<7xf32>
// CHECK:         }
// CHECK: #[[$ATTR_1:.+]] = affine_map<(d0) -> (d0)>
tt.func @binary_f32(%a: tensor<7xf32>, %b: tensor<7xf32>) -> tensor<7xf32> {
  %r = arith.mulf %a, %b : tensor<7xf32>
  tt.return %r : tensor<7xf32>
}

// -----

// The math dialect is separate from arith, so it needs its own coverage even
// though the same trait drives the conversion. A width of 1 is the smallest
// legal tensor extent.

// CHECK-LABEL:   tt.func @unary_math(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<1xf32>) -> tensor<1xf32> {
// CHECK:           %[[VAL_1:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_1]], #[[$ATTR_1]]], iterator_types = ["parallel"]} ins(%[[VAL_0]] : tensor<1xf32>) outs(%[[VAL_0]] : tensor<1xf32>) {
// CHECK:           ^bb0(%[[VAL_2:.*]]: f32, %[[VAL_3:.*]]: f32):
// CHECK:             %[[VAL_4:.*]] = math.exp %[[VAL_2]] : f32
// CHECK:             linalg.yield %[[VAL_4]] : f32
// CHECK:           } -> tensor<1xf32>
// CHECK:           tt.return %[[VAL_1]] : tensor<1xf32>
// CHECK:         }
// CHECK: #[[$ATTR_2:.+]] = affine_map<(d0) -> (d0)>
tt.func @unary_math(%a: tensor<1xf32>) -> tensor<1xf32> {
  %r = math.exp %a : tensor<1xf32>
  tt.return %r : tensor<1xf32>
}

// -----

// Integer ops convert too. MLIR's i32 is signless, so signed and unsigned
// division are distinct ops; andi has no named linalg equivalent, which is
// exactly why linalg.generic is the right target rather than a named op.

// CHECK-LABEL:   tt.func @integer_ops(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<3xi32>, %[[VAL_1:.*]]: tensor<3xi32>) -> tensor<3xi32> {
// CHECK:           %[[VAL_2:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_2]], #[[$ATTR_2]], #[[$ATTR_2]]], iterator_types = ["parallel"]} ins(%[[VAL_0]], %[[VAL_1]] : tensor<3xi32>, tensor<3xi32>) outs(%[[VAL_0]] : tensor<3xi32>) {
// CHECK:           ^bb0(%[[VAL_3:.*]]: i32, %[[VAL_4:.*]]: i32, %[[VAL_5:.*]]: i32):
// CHECK:             %[[VAL_6:.*]] = arith.divsi %[[VAL_3]], %[[VAL_4]] : i32
// CHECK:             linalg.yield %[[VAL_6]] : i32
// CHECK:           } -> tensor<3xi32>
// CHECK:           %[[VAL_7:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_2]], #[[$ATTR_2]], #[[$ATTR_2]]], iterator_types = ["parallel"]} ins(%[[VAL_2]], %[[VAL_1]] : tensor<3xi32>, tensor<3xi32>) outs(%[[VAL_2]] : tensor<3xi32>) {
// CHECK:           ^bb0(%[[VAL_8:.*]]: i32, %[[VAL_9:.*]]: i32, %[[VAL_10:.*]]: i32):
// CHECK:             %[[VAL_11:.*]] = arith.divui %[[VAL_8]], %[[VAL_9]] : i32
// CHECK:             linalg.yield %[[VAL_11]] : i32
// CHECK:           } -> tensor<3xi32>
// CHECK:           %[[VAL_12:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_2]], #[[$ATTR_2]], #[[$ATTR_2]]], iterator_types = ["parallel"]} ins(%[[VAL_7]], %[[VAL_1]] : tensor<3xi32>, tensor<3xi32>) outs(%[[VAL_7]] : tensor<3xi32>) {
// CHECK:           ^bb0(%[[VAL_13:.*]]: i32, %[[VAL_14:.*]]: i32, %[[VAL_15:.*]]: i32):
// CHECK:             %[[VAL_16:.*]] = arith.andi %[[VAL_13]], %[[VAL_14]] : i32
// CHECK:             linalg.yield %[[VAL_16]] : i32
// CHECK:           } -> tensor<3xi32>
// CHECK:           tt.return %[[VAL_12]] : tensor<3xi32>
// CHECK:         }
// CHECK: #[[$ATTR_3:.+]] = affine_map<(d0) -> (d0)>
tt.func @integer_ops(%a: tensor<3xi32>, %b: tensor<3xi32>) -> tensor<3xi32> {
  %s = arith.divsi %a, %b : tensor<3xi32>
  %u = arith.divui %s, %b : tensor<3xi32>
  %r = arith.andi %u, %b : tensor<3xi32>
  tt.return %r : tensor<3xi32>
}

// -----

// A comparison on tensor<Nxf32> yields tensor<Nxi1>. Because the result element
// type differs from the operands', the conversion cannot reuse an operand as the
// destination tensor and must create a fresh tensor.empty -- a path the
// same-element-type cases never exercise.

// CHECK-LABEL:   tt.func @compare_result_type_differs(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<7xf32>, %[[VAL_1:.*]]: tensor<7xf32>) -> tensor<7xi1> {
// CHECK:           %[[VAL_2:.*]] = tensor.empty() : tensor<7xi1>
// CHECK:           %[[VAL_3:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_3]], #[[$ATTR_3]], #[[$ATTR_3]]], iterator_types = ["parallel"]} ins(%[[VAL_0]], %[[VAL_1]] : tensor<7xf32>, tensor<7xf32>) outs(%[[VAL_2]] : tensor<7xi1>) {
// CHECK:           ^bb0(%[[VAL_4:.*]]: f32, %[[VAL_5:.*]]: f32, %[[VAL_6:.*]]: i1):
// CHECK:             %[[VAL_7:.*]] = arith.cmpf ogt, %[[VAL_4]], %[[VAL_5]] : f32
// CHECK:             linalg.yield %[[VAL_7]] : i1
// CHECK:           } -> tensor<7xi1>
// CHECK:           tt.return %[[VAL_3]] : tensor<7xi1>
// CHECK:         }
// CHECK: #[[$ATTR_4:.+]] = affine_map<(d0) -> (d0)>
tt.func @compare_result_type_differs(%a: tensor<7xf32>, %b: tensor<7xf32>) -> tensor<7xi1> {
  %r = arith.cmpf ogt, %a, %b : tensor<7xf32>
  tt.return %r : tensor<7xi1>
}

// -----

// Carve-out 1: scalar-only ops are left at function level even when tensor
// arith converts alongside them. If the conversion keyed on the dialect instead
// of the operand types, the scalar addf would become a rank-0 linalg.generic and
// every linalg.reduce combiner region in the backend would be malformed.
//
// The CHECK-NOT pins that no rank-0 generic (iterator_types = [], the shape a
// converted scalar op would take) appears between the function label and the
// scalar addf. A transcript of the ops that were produced cannot state that a
// particular op was never produced.

// CHECK-LABEL:   tt.func @scalar_operands_untouched(
// CHECK-SAME:  %[[VAL_0:.*]]: f32, %[[VAL_1:.*]]: tensor<7xf32>) -> (f32, tensor<7xf32>) {
// CHECK-NOT:       iterator_types = []
// CHECK:           %[[VAL_2:.*]] = arith.addf %[[VAL_0]], %[[VAL_0]] : f32
// CHECK:           %[[VAL_3:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_4]], #[[$ATTR_4]], #[[$ATTR_4]]], iterator_types = ["parallel"]} ins(%[[VAL_1]], %[[VAL_1]] : tensor<7xf32>, tensor<7xf32>) outs(%[[VAL_1]] : tensor<7xf32>) {
// CHECK:           ^bb0(%[[VAL_4:.*]]: f32, %[[VAL_5:.*]]: f32, %[[VAL_6:.*]]: f32):
// CHECK:             %[[VAL_7:.*]] = arith.mulf %[[VAL_4]], %[[VAL_5]] : f32
// CHECK:             linalg.yield %[[VAL_7]] : f32
// CHECK:           } -> tensor<7xf32>
// CHECK:           tt.return %[[VAL_2]], %[[VAL_3]] : f32, tensor<7xf32>
// CHECK:         }
// CHECK: #[[$ATTR_5:.+]] = affine_map<(d0) -> (d0)>
tt.func @scalar_operands_untouched(%s: f32, %t: tensor<7xf32>) -> (f32, tensor<7xf32>) {
  %x = arith.addf %s, %s : f32
  %y = arith.mulf %t, %t : tensor<7xf32>
  tt.return %x, %y : f32, tensor<7xf32>
}

// -----

// Carve-out 2: a dense arith.constant survives as a tensor-typed constant and
// is read as an input by the generic that replaced its consumer. Rewriting it
// into tensor.empty + linalg.fill is deferred; the CHECK-NOT below marks that
// boundary so it cannot move silently. When the rewrite lands this test fails
// loudly rather than silently accepting either behaviour.

// CHECK-LABEL:   tt.func @dense_constant_survives(
// CHECK-SAME:  %[[VAL_0:.*]]: tensor<7xf32>) -> tensor<7xf32> {
// CHECK-NOT:       linalg.fill
// CHECK:           %[[VAL_1:.*]] = arith.constant dense<2.000000e+00> : tensor<7xf32>
// CHECK:           %[[VAL_2:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_5]], #[[$ATTR_5]], #[[$ATTR_5]]], iterator_types = ["parallel"]} ins(%[[VAL_0]], %[[VAL_1]] : tensor<7xf32>, tensor<7xf32>) outs(%[[VAL_0]] : tensor<7xf32>) {
// CHECK:           ^bb0(%[[VAL_3:.*]]: f32, %[[VAL_4:.*]]: f32, %[[VAL_5:.*]]: f32):
// CHECK:             %[[VAL_6:.*]] = arith.mulf %[[VAL_3]], %[[VAL_4]] : f32
// CHECK:             linalg.yield %[[VAL_6]] : f32
// CHECK:           } -> tensor<7xf32>
// CHECK:           tt.return %[[VAL_2]] : tensor<7xf32>
// CHECK:         }
tt.func @dense_constant_survives(%t: tensor<7xf32>) -> tensor<7xf32> {
  %c = arith.constant dense<2.0> : tensor<7xf32>
  %r = arith.mulf %t, %c : tensor<7xf32>
  tt.return %r : tensor<7xf32>
}

// -----

// A non-splat dense constant cannot be expressed as a linalg.fill, which takes
// a single scalar. Today it passes through untouched and is not rejected.
// Guarded separately from the splat case because the eventual implementation
// will treat the two differently: splats become linalg.fill, non-splats need a
// diagnostic. The CHECK-NOTs assert the pass does no work at all here, which is
// the whole claim of this test -- a transcript of what was produced cannot
// express "and nothing else was added". They are interleaved between the two
// positive matches rather than trailing the closing brace: a CHECK-NOT after
// the last positive would run to end-of-file and be satisfied by the next
// split's legitimate linalg.generic, silently guarding nothing.

// CHECK-LABEL:   tt.func @non_splat_constant_survives() -> tensor<3xf32> {
// CHECK-NOT:       linalg.fill
// CHECK-NOT:       linalg.generic
// CHECK:           %[[VAL_0:.*]] = arith.constant dense<[0.000000e+00, 1.000000e+00, 2.000000e+00]> : tensor<3xf32>
// CHECK-NOT:       linalg.fill
// CHECK-NOT:       linalg.generic
// CHECK:           tt.return %[[VAL_0]] : tensor<3xf32>
// CHECK: #[[$ATTR_6:.+]] = affine_map<(d0) -> (d0)>
tt.func @non_splat_constant_survives() -> tensor<3xf32> {
  %c = arith.constant dense<[0.0, 1.0, 2.0]> : tensor<3xf32>
  tt.return %c : tensor<3xf32>
}

// -----

// An op with one scalar and one tensor operand still converts. tt.splat
// produces exactly this shape upstream of the conversion, so this is not a
// synthetic case.

// CHECK-LABEL:   tt.func @mixed_scalar_and_tensor(
// CHECK-SAME:  %[[VAL_0:.*]]: f32, %[[VAL_1:.*]]: tensor<64xf32>) -> tensor<64xf32> {
// CHECK:           %[[VAL_2:.*]] = tt.splat %[[VAL_0]] : f32 -> tensor<64xf32>
// CHECK:           %[[VAL_3:.*]] = linalg.generic {indexing_maps = [#[[$ATTR_6]], #[[$ATTR_6]], #[[$ATTR_6]]], iterator_types = ["parallel"]} ins(%[[VAL_1]], %[[VAL_2]] : tensor<64xf32>, tensor<64xf32>) outs(%[[VAL_1]] : tensor<64xf32>) {
// CHECK:           ^bb0(%[[VAL_4:.*]]: f32, %[[VAL_5:.*]]: f32, %[[VAL_6:.*]]: f32):
// CHECK:             %[[VAL_7:.*]] = arith.addf %[[VAL_4]], %[[VAL_5]] : f32
// CHECK:             linalg.yield %[[VAL_7]] : f32
// CHECK:           } -> tensor<64xf32>
// CHECK:           tt.return %[[VAL_3]] : tensor<64xf32>
// CHECK:         }
tt.func @mixed_scalar_and_tensor(%s: f32, %t: tensor<64xf32>) -> tensor<64xf32> {
  %z = tt.splat %s : f32 -> tensor<64xf32>
  %r = arith.addf %t, %z : tensor<64xf32>
  tt.return %r : tensor<64xf32>
}
