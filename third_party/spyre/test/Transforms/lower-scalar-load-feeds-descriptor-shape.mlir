// RUN: spyre-triton-opt %s --lower-scalar-load | FileCheck %s

// Pass-ordering: LowerScalarLoad running before LowerDescriptorMemory.
//
// Flow A: this pass runs before `LowerDescriptorMemory` sees the scalar-load
// result feeding a tensor-descriptor shape operand. The load is rewritten to
// the rank-0 read chain, and the descriptor op -- not touched by this pass --
// survives with its shape operand rewired from the (now-gone) `tt.load`
// result to the `tensor.extract` result. Companion to
// `test_dynamic_shape_from_scalar_load` (test_lower_desc_memory.py), which
// pins the reverse ordering.

// NOTE: Assertions have been autogenerated by utils/generate-test-checks.py

// The script is designed to make adding checks to
// a test case fast, it is *not* designed to be authoritative
// about what constitutes a good test! The CHECK should be
// minimized and named to reflect the test intent.

// CHECK: #[[$ATTR_0:.+]] = affine_map<() -> ()>
// CHECK: #[[$ATTR_1:.+]] = affine_set<() : (0 >= 0)>

module {
// CHECK-LABEL:   tt.func @k(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: i32, %[[VAL_2:.*]]: !tt.ptr<i32>) {
// CHECK:           %[[VAL_3:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_3]], sizes: [], strides: [] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.spyre_memory_space<HBM>} : memref<i32>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_access_tile %[[VAL_4]][] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_1]]} : memref<i32> -> !ktdp.access_tile<index>
// CHECK:           %[[VAL_6:.*]] = ktdp.load %[[VAL_5]] : <index> -> tensor<i32>
// CHECK:           %[[VAL_7:.*]] = tensor.extract %[[VAL_6]][] : tensor<i32>
// CHECK:           %[[VAL_8:.*]] = arith.constant 1 : i64
// CHECK:           %[[VAL_9:.*]] = tt.make_tensor_descriptor %[[VAL_0]], {{\[}}%[[VAL_7]]], {{\[}}%[[VAL_8]]] : <f16>, <64xf16>
// CHECK:           %[[VAL_10:.*]] = tt.descriptor_load %[[VAL_9]]{{\[}}%[[VAL_1]]] : !tt.tensordesc<64xf16> -> tensor<64xf16>
// CHECK:           tt.return
// CHECK:         }
  tt.func @k(%ptr: !tt.ptr<f16>, %off: i32, %seqlen_ptr: !tt.ptr<i32>) {
    %seqlen = tt.load %seqlen_ptr : !tt.ptr<i32>
    %stride = arith.constant 1 : i64
    %desc = tt.make_tensor_descriptor %ptr, [%seqlen], [%stride]
        : <f16>, <64xf16>
    %data = tt.descriptor_load %desc[%off]
        : !tt.tensordesc<64xf16> -> tensor<64xf16>
    tt.return
  }
}
