// RUN: spyre-triton-opt %s --materialize-base-addresses='base-addresses=1024,12288,18432' -split-input-file | FileCheck %s

// Tests for --materialize-base-addresses, the opt-in rewrite that replaces a
// kernel's base-address arguments with arith.constant and drops them from the
// signature, so the dataflow scheduler sees a function whose HBM addresses are
// materialized rather than passed in.
//
// The address list is positional over the entry block's `index` arguments in
// scan order, NOT over all arguments. After ConvertFunctions the `index` args
// are exactly the arguments that were !tt.ptr, so that indexing is what the
// caller means and it is type-safe: a runtime i32 scalar is never a candidate
// to receive an address.
//
// A pass option is fixed for a whole spyre-triton-opt invocation, so the cases
// are split by address list across sibling files rather than crammed into
// per-case RUN lines here:
//   this file                                — three addresses (1024/12288/18432)
//   materialize-base-addresses-two.mlir      — two addresses (prefix, interleaved)
//   materialize-base-addresses-large.mlir    — one 2^33 address (int64 carrier)
//   materialize-base-addresses-noop.mlir     — empty list (opt-in no-op)
//   materialize-base-addresses-invalid.mlir  — the two diagnostics

// -----

// Three `index` args, three addresses → zero-argument function. The canonical
// scheduler shape: every base address is a constant in the entry block and
// construct_memory_view consumes it directly. The autogenerated CHECK-LABEL
// transcribes the empty parameter list, so a surviving argument breaks the
// match on its own.

// CHECK-LABEL:   func.func @three_addrs() {
// CHECK:           %[[VAL_0:.*]] = arith.constant 1024 : index
// CHECK:           %[[VAL_1:.*]] = arith.constant 12288 : index
// CHECK:           %[[VAL_2:.*]] = arith.constant 18432 : index
// CHECK:           %[[VAL_3:.*]] = ktdp.construct_memory_view %[[VAL_0]], sizes: [32, 64], strides: [64, 1] {coordinate_set = #{{.*}}, memory_space = #ktdp.memory_space<global>} : memref<32x64xf16>
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_1]], sizes: [32, 64], strides: [64, 1] {coordinate_set = #{{.*}}, memory_space = #ktdp.memory_space<global>} : memref<32x64xf16>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_2]], sizes: [32, 64], strides: [64, 1] {coordinate_set = #{{.*}}, memory_space = #ktdp.memory_space<global>} : memref<32x64xf16>
// CHECK:           return
// CHECK:         }
#set2d = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 63 >= 0)>
func.func @three_addrs(%a: index, %b: index, %c: index) {
  %va = ktdp.construct_memory_view %a, sizes: [32, 64], strides: [64, 1] {
      coordinate_set = #set2d, memory_space = #ktdp.memory_space<global>
  } : memref<32x64xf16>
  %vb = ktdp.construct_memory_view %b, sizes: [32, 64], strides: [64, 1] {
      coordinate_set = #set2d, memory_space = #ktdp.memory_space<global>
  } : memref<32x64xf16>
  %vc = ktdp.construct_memory_view %c, sizes: [32, 64], strides: [64, 1] {
      coordinate_set = #set2d, memory_space = #ktdp.memory_space<global>
  } : memref<32x64xf16>
  return
}

// -----

// A private function is untouched. A private helper is not a kernel boundary —
// its arguments come from its caller, not from the runtime — so both `index`
// args survive even though the pass has three addresses to spend.

// CHECK-LABEL:   func.func private @helper(
// CHECK-SAME:      %[[ARG_0:.*]]: index,
// CHECK-SAME:      %[[ARG_1:.*]]: index) {
// CHECK:           %[[VAL_0:.*]] = ktdp.construct_memory_view %[[ARG_0]], sizes: [4], strides: [1] {coordinate_set = #{{.*}}, memory_space = #ktdp.memory_space<global>} : memref<4xf16>
// CHECK:           %[[VAL_1:.*]] = ktdp.construct_memory_view %[[ARG_1]], sizes: [4], strides: [1] {coordinate_set = #{{.*}}, memory_space = #ktdp.memory_space<global>} : memref<4xf16>
// CHECK:           return
// CHECK:         }
// CHECK-NOT:     arith.constant
#set1d = affine_set<(d0) : (d0 >= 0, -d0 + 3 >= 0)>
func.func private @helper(%a: index, %b: index) {
  %va = ktdp.construct_memory_view %a, sizes: [4], strides: [1] {
      coordinate_set = #set1d, memory_space = #ktdp.memory_space<global>
  } : memref<4xf16>
  %vb = ktdp.construct_memory_view %b, sizes: [4], strides: [1] {
      coordinate_set = #set1d, memory_space = #ktdp.memory_space<global>
  } : memref<4xf16>
  return
}

// -----

// A non-`index` argument survives, and that is not an error — the pass drops
// base addresses, it does not promise arity zero. Three `index` args plus a
// trailing i32 runtime scalar: the three addresses land on the `index` args and
// the i32 survives, shifting left to signature position 0.

// CHECK-LABEL:   func.func @trailing_scalar_survives(
// CHECK-SAME:      %[[N:.*]]: i32) {
// CHECK:           %[[VAL_0:.*]] = arith.constant 1024 : index
// CHECK:           %[[VAL_1:.*]] = arith.constant 12288 : index
// CHECK:           %[[VAL_2:.*]] = arith.constant 18432 : index
// CHECK:           %[[VAL_3:.*]] = ktdp.construct_memory_view %[[VAL_0]], sizes: [4], strides: [1] {coordinate_set = #{{.*}}, memory_space = #ktdp.memory_space<global>} : memref<4xf16>
// CHECK:           %[[VAL_4:.*]] = ktdp.construct_memory_view %[[VAL_1]], sizes: [4], strides: [1] {coordinate_set = #{{.*}}, memory_space = #ktdp.memory_space<global>} : memref<4xf16>
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_2]], sizes: [4], strides: [1] {coordinate_set = #{{.*}}, memory_space = #ktdp.memory_space<global>} : memref<4xf16>
// CHECK:           %[[VAL_6:.*]] = arith.addi %[[N]], %[[N]] : i32
// CHECK:           return
// CHECK:         }
#set1db = affine_set<(d0) : (d0 >= 0, -d0 + 3 >= 0)>
func.func @trailing_scalar_survives(%a: index, %b: index, %c: index, %n: i32) {
  %va = ktdp.construct_memory_view %a, sizes: [4], strides: [1] {
      coordinate_set = #set1db, memory_space = #ktdp.memory_space<global>
  } : memref<4xf16>
  %vb = ktdp.construct_memory_view %b, sizes: [4], strides: [1] {
      coordinate_set = #set1db, memory_space = #ktdp.memory_space<global>
  } : memref<4xf16>
  %vc = ktdp.construct_memory_view %c, sizes: [4], strides: [1] {
      coordinate_set = #set1db, memory_space = #ktdp.memory_space<global>
  } : memref<4xf16>
  %w = arith.addi %n, %n : i32
  return
}
