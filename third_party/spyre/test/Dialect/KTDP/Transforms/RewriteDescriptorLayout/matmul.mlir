// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_6]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_7]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_7]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_9]], %[[VAL_6]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_4]], access_tile_set = #[[$ATTR_6]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_6]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf32>
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_19:.*]] = arith.divsi %[[VAL_16]], %[[VAL_18]] : index
// CHECK:           %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_21:.*]] = arith.remsi %[[VAL_16]], %[[VAL_20]] : index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_19]], %[[VAL_17]], %[[VAL_21]]] {access_tile_order = #[[$ATTR_4]], access_tile_set = #[[$ATTR_6]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_22]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:           %[[VAL_24:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_25:.*]] = ktdp.construct_memory_view %[[VAL_24]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_26:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_27:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_28:.*]] = ktdp.construct_access_tile %[[VAL_25]]{{\[}}%[[VAL_26]], %[[VAL_27]]] {access_tile_order = #[[$ATTR_5]], access_tile_set = #[[$ATTR_7]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           %[[VAL_29:.*]] = ktdp.load %[[VAL_28]] : <64x64xindex> -> tensor<64x64xf32>
// CHECK:           %[[VAL_30:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_31:.*]] = arith.constant 1 : index
