// Test 1: Single-stick matmul — A[64x64] @ B[64x64] = C[64x64].
// Layout: stick-on-K for A (K=64, stick=64 => 1 K-stick => no loop).
//         stick-on-N for B (N=64, stick=64 => 1 N-stick => no loop).
// Expected: extract_slice of each operand + linalg.matmul, no scf.for.
module {
// CHECK-LABEL:   tt.func @matmul_single_stick(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_7]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_7]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_9]], %[[VAL_6]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_19:.*]] = arith.divsi %[[VAL_17]], %[[VAL_18]] : index
// CHECK:           %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_21:.*]] = arith.remsi %[[VAL_17]], %[[VAL_20]] : index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_19]], %[[VAL_16]], %[[VAL_21]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_22]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:           %[[VAL_24:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_25:.*]] = ktdp.construct_memory_view %[[VAL_24]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_26:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_27:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_28:.*]] = ktdp.construct_access_tile %[[VAL_25]]{{\[}}%[[VAL_26]], %[[VAL_27]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           %[[VAL_29:.*]] = ktdp.load %[[VAL_28]] : <64x64xindex> -> tensor<64x64xf32>
// CHECK:           %[[VAL_30:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_31:.*]] = tensor.extract_slice %[[VAL_13]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_32:.*]] = tensor.extract_slice %[[VAL_23]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_33:.*]] = linalg.matmul ins(%[[VAL_31]], %[[VAL_32]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_29]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:           %[[VAL_34:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_35:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_36:.*]] = ktdp.construct_access_tile %[[VAL_25]]{{\[}}%[[VAL_34]], %[[VAL_35]]] {access_tile_order = #[[$ATTR_1]], access_tile_set = #[[$ATTR_3]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           ktdp.store %[[VAL_33]], %[[VAL_36]] : tensor<64x64xf32>, <64x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_4:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_5:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_6:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @matmul_single_stick(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 64] stick-on-K(64): phys [1, 64, 64] = [K/64, M, K%64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // B[64, 64] stick-on-N(64): phys [1, 64, 64] = [N/64, K, N%64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // C[64, 64] — unannotated accumulator
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  %d = tt.dot %a, %b, %c : tensor<64x64xf32> * tensor<64x64xf32> -> tensor<64x64xf32>

  tt.descriptor_store %c_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}


