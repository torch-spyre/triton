// Test 6: A stick-on-M (trip=1), B stick-on-K (trip=2) — parallel on A, reduction on B.
// A[64x128] stick-on-M(64): phys [M/64, K, M%64] = [1, 128, 64]
// B[128x64] stick-on-K(64): phys [K/64, N, K%64] = [2, 64, 64]
// C unannotated [64x64].
// Expected: scf.for over 2 K-sticks, linalg.transpose on both A and B slices,
//           linalg.matmul inside loop.
module {
// CHECK-LABEL:   tt.func @matmul_a_parallel_b_ksplit(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1, 128, 64], strides: [8192, 64, 1] {coordinate_set = #[[$ATTR_22]], memory_space = #ktdp.memory_space<global>} : memref<1x128x64xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_6]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_6]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_9]], %[[VAL_7]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_20]], access_tile_set = #[[$ATTR_22]]} : memref<1x128x64xf32> -> !ktdp.access_tile<1x128x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <1x128x64xindex> -> tensor<1x128x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_23]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf32>
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_19:.*]] = arith.divsi %[[VAL_16]], %[[VAL_18]] : index
// CHECK:           %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_21:.*]] = arith.remsi %[[VAL_16]], %[[VAL_20]] : index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_19]], %[[VAL_17]], %[[VAL_21]]] {access_tile_order = #[[$ATTR_20]], access_tile_set = #[[$ATTR_23]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_22]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:           %[[VAL_24:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_25:.*]] = ktdp.construct_memory_view %[[VAL_24]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_24]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_26:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_27:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_28:.*]] = ktdp.construct_access_tile %[[VAL_25]]{{\[}}%[[VAL_26]], %[[VAL_27]]] {access_tile_order = #[[$ATTR_21]], access_tile_set = #[[$ATTR_24]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           %[[VAL_29:.*]] = ktdp.load %[[VAL_28]] : <64x64xindex> -> tensor<64x64xf32>
// CHECK:           %[[VAL_30:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_31:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_32:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_33:.*]] = scf.for %[[VAL_34:.*]] = %[[VAL_30]] to %[[VAL_32]] step %[[VAL_31]] iter_args(%[[VAL_35:.*]] = %[[VAL_29]]) -> (tensor<64x64xf32>) {
// CHECK:             %[[VAL_36:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_37:.*]] = arith.muli %[[VAL_34]], %[[VAL_36]] : index
// CHECK:             %[[VAL_38:.*]] = tensor.extract_slice %[[VAL_13]][0, %[[VAL_37]], 0] [1, 64, 64] [1, 1, 1] : tensor<1x128x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_39:.*]] = tensor.empty() : tensor<64x64xf32>
// CHECK:             %[[VAL_40:.*]] = linalg.transpose ins(%[[VAL_38]] : tensor<64x64xf32>) outs(%[[VAL_39]] : tensor<64x64xf32>) permutation = [1, 0]
// CHECK:             %[[VAL_41:.*]] = tensor.extract_slice %[[VAL_23]]{{\[}}%[[VAL_34]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_42:.*]] = tensor.empty() : tensor<64x64xf32>
// CHECK:             %[[VAL_43:.*]] = linalg.transpose ins(%[[VAL_41]] : tensor<64x64xf32>) outs(%[[VAL_42]] : tensor<64x64xf32>) permutation = [1, 0]
// CHECK:             %[[VAL_44:.*]] = linalg.matmul ins(%[[VAL_40]], %[[VAL_43]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_35]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:             scf.yield %[[VAL_44]] : tensor<64x64xf32>
// CHECK:           }
// CHECK:           %[[VAL_45:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_46:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_47:.*]] = ktdp.construct_access_tile %[[VAL_25]]{{\[}}%[[VAL_45]], %[[VAL_46]]] {access_tile_order = #[[$ATTR_21]], access_tile_set = #[[$ATTR_24]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           ktdp.store %[[VAL_33]], %[[VAL_47]] : tensor<64x64xf32>, <64x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_25:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_26:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_27:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 127 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_28:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
tt.func @matmul_a_parallel_b_ksplit(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64
  // A[M=64, K=128] stick-on-M(64): phys [M/64, K, M%64] = [1, 128, 64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>
  // B[K=128, N=64] stick-on-K(64): phys [K/64, N, K%64] = [2, 64, 64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>
  // C unannotated [64x64]
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>
  %d = tt.dot %a, %b, %c : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>
  tt.descriptor_store %c_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}


// -----


// Test 7: Matmul source+sink — A[64x128] stick-on-K(64) (2 K-sticks, reduction loop),
// B[128x64] stick-on-N(64), D[64x64] stick-on-N(64) annotated output.
// Expected: scf.for K-reduction loop (source) + tensor.insert_slice scatter (sink)
//           + ktdp.store with physical shape [1, 64, 64].
module {
// CHECK-LABEL:   tt.func @matmul_annotated_output(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_26]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_7]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_7]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_9]], %[[VAL_6]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_25]], access_tile_set = #[[$ATTR_26]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [1, 128, 64], strides: [8192, 64, 1] {coordinate_set = #[[$ATTR_27]], memory_space = #ktdp.memory_space<global>} : memref<1x128x64xf32>
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_19:.*]] = arith.divsi %[[VAL_17]], %[[VAL_18]] : index
// CHECK:           %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_21:.*]] = arith.remsi %[[VAL_17]], %[[VAL_20]] : index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_19]], %[[VAL_16]], %[[VAL_21]]] {access_tile_order = #[[$ATTR_25]], access_tile_set = #[[$ATTR_27]]} : memref<1x128x64xf32> -> !ktdp.access_tile<1x128x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_22]] : <1x128x64xindex> -> tensor<1x128x64xf32>
// CHECK:           %[[VAL_24:.*]] = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
// CHECK:           %[[VAL_25:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_26:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_27:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_28:.*]] = scf.for %[[VAL_29:.*]] = %[[VAL_25]] to %[[VAL_27]] step %[[VAL_26]] iter_args(%[[VAL_30:.*]] = %[[VAL_24]]) -> (tensor<64x64xf32>) {
// CHECK:             %[[VAL_31:.*]] = tensor.extract_slice %[[VAL_13]]{{\[}}%[[VAL_29]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_32:.*]] = arith.constant 64 : index
// CHECK:             %[[VAL_33:.*]] = arith.muli %[[VAL_29]], %[[VAL_32]] : index
// CHECK:             %[[VAL_34:.*]] = tensor.extract_slice %[[VAL_23]][0, %[[VAL_33]], 0] [1, 64, 64] [1, 1, 1] : tensor<1x128x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_35:.*]] = linalg.matmul ins(%[[VAL_31]], %[[VAL_34]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_30]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:             scf.yield %[[VAL_35]] : tensor<64x64xf32>
// CHECK:           }
// CHECK:           %[[VAL_36:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_37:.*]] = ktdp.construct_memory_view %[[VAL_36]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_28]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_38:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_39:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_40:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_41:.*]] = arith.divsi %[[VAL_39]], %[[VAL_40]] : index
// CHECK:           %[[VAL_42:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_43:.*]] = arith.remsi %[[VAL_39]], %[[VAL_42]] : index
// CHECK:           %[[VAL_44:.*]] = ktdp.construct_access_tile %[[VAL_37]]{{\[}}%[[VAL_41]], %[[VAL_38]], %[[VAL_43]]] {access_tile_order = #[[$ATTR_25]], access_tile_set = #[[$ATTR_28]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_45:.*]] = tensor.empty() : tensor<1x64x64xf32>
// CHECK:           %[[VAL_46:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_47:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_48:.*]] = arith.muli %[[VAL_47]], %[[VAL_46]] : index
// CHECK:           %[[VAL_49:.*]] = tensor.extract_slice %[[VAL_28]][0, %[[VAL_48]]] [64, 64] [1, 1] : tensor<64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_50:.*]] = tensor.insert_slice %[[VAL_49]] into %[[VAL_45]]{{\[}}%[[VAL_47]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<64x64xf32> into tensor<1x64x64xf32>
// CHECK:           ktdp.store %[[VAL_50]], %[[VAL_44]] : tensor<1x64x64xf32>, <1x64x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_29:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_30:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_31:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
tt.func @matmul_annotated_output(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %d_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 128] stick-on-K(64): phys [K/64, M, K%64] = [2, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>

  // B[128, 64] stick-on-N(64): phys [N/64, K, N%64] = [1, 128, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>

  // Zero init (unannotated)
  %zero = arith.constant dense<0.0> : tensor<64x64xf32>

  %d = tt.dot %a, %b, %zero : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>

  // D[64, 64] stick-on-N(64): phys [N/64, M, N%64] = [1, 64, 64]
  //   Annotated output descriptor.
  %d_desc = tt.make_tensor_descriptor %d_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %d_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>

  tt.descriptor_store %d_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}


// -----


// Test 8: K-split with annotated output — A[64x128] stick-on-K(64),
// B[128x64] stick-on-K(64), D[64x64] stick-on-N(64).
// Expected: scf.for K-reduction + B transpose inside loop + sink scatter.
module {
// CHECK-LABEL:   tt.func @matmul_k_split_annotated_output(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_30]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_7]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_7]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_9]], %[[VAL_6]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_29]], access_tile_set = #[[$ATTR_30]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [2, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_30]], memory_space = #ktdp.memory_space<global>} : memref<2x64x64xf32>
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_19:.*]] = arith.divsi %[[VAL_16]], %[[VAL_18]] : index
// CHECK:           %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_21:.*]] = arith.remsi %[[VAL_16]], %[[VAL_20]] : index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_19]], %[[VAL_17]], %[[VAL_21]]] {access_tile_order = #[[$ATTR_29]], access_tile_set = #[[$ATTR_30]]} : memref<2x64x64xf32> -> !ktdp.access_tile<2x64x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_22]] : <2x64x64xindex> -> tensor<2x64x64xf32>
// CHECK:           %[[VAL_24:.*]] = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
// CHECK:           %[[VAL_25:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_26:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_27:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_28:.*]] = scf.for %[[VAL_29:.*]] = %[[VAL_25]] to %[[VAL_27]] step %[[VAL_26]] iter_args(%[[VAL_30:.*]] = %[[VAL_24]]) -> (tensor<64x64xf32>) {
// CHECK:             %[[VAL_31:.*]] = tensor.extract_slice %[[VAL_13]]{{\[}}%[[VAL_29]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_32:.*]] = tensor.extract_slice %[[VAL_23]]{{\[}}%[[VAL_29]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<2x64x64xf32> to tensor<64x64xf32>
// CHECK:             %[[VAL_33:.*]] = tensor.empty() : tensor<64x64xf32>
// CHECK:             %[[VAL_34:.*]] = linalg.transpose ins(%[[VAL_32]] : tensor<64x64xf32>) outs(%[[VAL_33]] : tensor<64x64xf32>) permutation = [1, 0]
// CHECK:             %[[VAL_35:.*]] = linalg.matmul ins(%[[VAL_31]], %[[VAL_34]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_30]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:             scf.yield %[[VAL_35]] : tensor<64x64xf32>
// CHECK:           }
// CHECK:           %[[VAL_36:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_37:.*]] = ktdp.construct_memory_view %[[VAL_36]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_31]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_38:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_39:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_40:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_41:.*]] = arith.divsi %[[VAL_39]], %[[VAL_40]] : index
// CHECK:           %[[VAL_42:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_43:.*]] = arith.remsi %[[VAL_39]], %[[VAL_42]] : index
// CHECK:           %[[VAL_44:.*]] = ktdp.construct_access_tile %[[VAL_37]]{{\[}}%[[VAL_41]], %[[VAL_38]], %[[VAL_43]]] {access_tile_order = #[[$ATTR_29]], access_tile_set = #[[$ATTR_31]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_45:.*]] = tensor.empty() : tensor<1x64x64xf32>
// CHECK:           %[[VAL_46:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_47:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_48:.*]] = arith.muli %[[VAL_47]], %[[VAL_46]] : index
// CHECK:           %[[VAL_49:.*]] = tensor.extract_slice %[[VAL_28]][0, %[[VAL_48]]] [64, 64] [1, 1] : tensor<64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_50:.*]] = tensor.insert_slice %[[VAL_49]] into %[[VAL_45]]{{\[}}%[[VAL_47]], 0, 0] [1, 64, 64] [1, 1, 1] : tensor<64x64xf32> into tensor<1x64x64xf32>
// CHECK:           ktdp.store %[[VAL_50]], %[[VAL_44]] : tensor<1x64x64xf32>, <1x64x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_32:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_33:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_34:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 + 1 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 31 >= 0)>
tt.func @matmul_k_split_annotated_output(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %d_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c128_i32 = arith.constant 128 : i32
  %c128_i64 = arith.constant 128 : i64
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 128] stick-on-K(64): phys [K/64, M, K%64] = [2, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c128_i32], [%c128_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x128xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x128xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x128xf32> -> tensor<64x128xf32>

  // B[128, 64] stick-on-K(64): phys [K/64, N, K%64] = [2, 64, 64]
  //   phys_src=[0,1,0] phys_op=[1,0,2] phys_arg=[64,0,64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c128_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<128x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 0, 1, 0>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<128x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<128x64xf32> -> tensor<128x64xf32>

  // Zero init (unannotated)
  %zero = arith.constant dense<0.0> : tensor<64x64xf32>

  %d = tt.dot %a, %b, %zero : tensor<64x128xf32> * tensor<128x64xf32> -> tensor<64x64xf32>

  // D[64, 64] stick-on-N(64): phys [N/64, M, N%64] = [1, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %d_desc = tt.make_tensor_descriptor %d_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %d_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>

  tt.descriptor_store %d_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}


// -----


// Test 9: Sink scatter with trip > 1 — A[64x64] stick-on-K(64), B[64x64] stick-on-N(64),
// D[64x64] stick-on-N(32) => phys [N/32, M, N%32] = [2, 64, 32].
// Source: no reduction loop (trip=1 on both inputs).
// Sink: scatter loop with trip=2 (inserting 64x32 slices into [2, 64, 32]).
module {
// CHECK-LABEL:   tt.func @matmul_parallel_scatter_output(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_33]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_6:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_9:.*]] = arith.divsi %[[VAL_7]], %[[VAL_8]] : index
// CHECK:           %[[VAL_10:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_11:.*]] = arith.remsi %[[VAL_7]], %[[VAL_10]] : index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_9]], %[[VAL_6]], %[[VAL_11]]] {access_tile_order = #[[$ATTR_32]], access_tile_set = #[[$ATTR_33]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_12]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_33]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_16:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_19:.*]] = arith.divsi %[[VAL_17]], %[[VAL_18]] : index
// CHECK:           %[[VAL_20:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_21:.*]] = arith.remsi %[[VAL_17]], %[[VAL_20]] : index
// CHECK:           %[[VAL_22:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_19]], %[[VAL_16]], %[[VAL_21]]] {access_tile_order = #[[$ATTR_32]], access_tile_set = #[[$ATTR_33]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_23:.*]] = ktdp.load %[[VAL_22]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:           %[[VAL_24:.*]] = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
// CHECK:           %[[VAL_25:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_26:.*]] = tensor.extract_slice %[[VAL_13]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_27:.*]] = tensor.extract_slice %[[VAL_23]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_28:.*]] = linalg.matmul ins(%[[VAL_26]], %[[VAL_27]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_24]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:           %[[VAL_29:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_30:.*]] = ktdp.construct_memory_view %[[VAL_29]], sizes: [2, 64, 32], strides: [2048, 32, 1] {coordinate_set = #[[$ATTR_34]], memory_space = #ktdp.memory_space<global>} : memref<2x64x32xf32>
// CHECK:           %[[VAL_31:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_32:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_33:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_34:.*]] = arith.divsi %[[VAL_32]], %[[VAL_33]] : index
// CHECK:           %[[VAL_35:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_36:.*]] = arith.remsi %[[VAL_32]], %[[VAL_35]] : index
// CHECK:           %[[VAL_37:.*]] = ktdp.construct_access_tile %[[VAL_30]]{{\[}}%[[VAL_34]], %[[VAL_31]], %[[VAL_36]]] {access_tile_order = #[[$ATTR_32]], access_tile_set = #[[$ATTR_34]]} : memref<2x64x32xf32> -> !ktdp.access_tile<2x64x32xindex>
// CHECK:           %[[VAL_38:.*]] = tensor.empty() : tensor<2x64x32xf32>
// CHECK:           %[[VAL_39:.*]] = arith.constant 32 : index
// CHECK:           %[[VAL_40:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_41:.*]] = arith.constant 1 : index
// CHECK:           %[[VAL_42:.*]] = arith.constant 2 : index
// CHECK:           %[[VAL_43:.*]] = scf.for %[[VAL_44:.*]] = %[[VAL_40]] to %[[VAL_42]] step %[[VAL_41]] iter_args(%[[VAL_45:.*]] = %[[VAL_38]]) -> (tensor<2x64x32xf32>) {
// CHECK:             %[[VAL_46:.*]] = arith.muli %[[VAL_44]], %[[VAL_39]] : index
// CHECK:             %[[VAL_47:.*]] = tensor.extract_slice %[[VAL_28]][0, %[[VAL_46]]] [64, 32] [1, 1] : tensor<64x64xf32> to tensor<64x32xf32>
// CHECK:             %[[VAL_48:.*]] = tensor.insert_slice %[[VAL_47]] into %[[VAL_45]]{{\[}}%[[VAL_44]], 0, 0] [1, 64, 32] [1, 1, 1] : tensor<64x32xf32> into tensor<2x64x32xf32>
// CHECK:             scf.yield %[[VAL_48]] : tensor<2x64x32xf32>
// CHECK:           }
// CHECK:           ktdp.store %[[VAL_43]], %[[VAL_37]] : tensor<2x64x32xf32>, <2x64x32xindex>
// CHECK:           tt.return
// CHECK:         }
tt.func @matmul_parallel_scatter_output(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %d_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // A[64, 64] stick-on-K(64): phys [K/64, M, K%64] = [1, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // B[64, 64] stick-on-N(64): phys [N/64, K, N%64] = [1, 64, 64]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[64,0,64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // Zero init (unannotated)
  %zero = arith.constant dense<0.0> : tensor<64x64xf32>

  %d = tt.dot %a, %b, %zero : tensor<64x64xf32> * tensor<64x64xf32> -> tensor<64x64xf32>

  // D[64, 64] stick-on-N(32): phys [N/32, M, N%32] = [2, 64, 32]
  //   phys_src=[1,0,1] phys_op=[1,0,2] phys_arg=[32,0,32]
  %d_desc = tt.make_tensor_descriptor %d_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %d_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 32, 0, 32>} : !tt.tensordesc<64x64xf32>

  tt.descriptor_store %d_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}
