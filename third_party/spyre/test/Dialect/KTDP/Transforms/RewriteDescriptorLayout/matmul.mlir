// Test 3: Chain matmul — D = A @ (B @ C). The inner matmul B@C produces a
// scratchpad intermediate that the outer matmul consumes directly (no marker).
module {
// CHECK-LABEL:   tt.func @matmul_chain(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<f32>, %[[VAL_2:.*]]: !tt.ptr<f32>, %[[VAL_3:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_4:.*]] = arith.constant 0 : i32
// CHECK:           %[[VAL_5:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_6:.*]] = ktdp.construct_memory_view %[[VAL_5]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_10]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_7:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:           %[[VAL_8:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:           %[[VAL_9:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_10:.*]] = arith.divsi %[[VAL_8]], %[[VAL_9]] : index
// CHECK:           %[[VAL_11:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_12:.*]] = arith.remsi %[[VAL_8]], %[[VAL_11]] : index
// CHECK:           %[[VAL_13:.*]] = ktdp.construct_access_tile %[[VAL_6]]{{\[}}%[[VAL_10]], %[[VAL_7]], %[[VAL_12]]] {access_tile_order = #[[$ATTR_8]], access_tile_set = #[[$ATTR_10]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_14:.*]] = ktdp.load %[[VAL_13]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:           %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_10]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_17:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:           %[[VAL_18:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:           %[[VAL_19:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_20:.*]] = arith.divsi %[[VAL_18]], %[[VAL_19]] : index
// CHECK:           %[[VAL_21:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_22:.*]] = arith.remsi %[[VAL_18]], %[[VAL_21]] : index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_access_tile %[[VAL_16]]{{\[}}%[[VAL_20]], %[[VAL_17]], %[[VAL_22]]] {access_tile_order = #[[$ATTR_8]], access_tile_set = #[[$ATTR_10]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_24:.*]] = ktdp.load %[[VAL_23]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:           %[[VAL_25:.*]] = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
// CHECK:           %[[VAL_26:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_27:.*]] = tensor.extract_slice %[[VAL_14]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_28:.*]] = tensor.extract_slice %[[VAL_24]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_29:.*]] = linalg.matmul ins(%[[VAL_27]], %[[VAL_28]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_25]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:           %[[VAL_30:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_31:.*]] = ktdp.construct_memory_view %[[VAL_30]], sizes: [1, 64, 64], strides: [4096, 64, 1] {coordinate_set = #[[$ATTR_10]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf32>
// CHECK:           %[[VAL_32:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:           %[[VAL_33:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:           %[[VAL_34:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_35:.*]] = arith.divsi %[[VAL_33]], %[[VAL_34]] : index
// CHECK:           %[[VAL_36:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_37:.*]] = arith.remsi %[[VAL_33]], %[[VAL_36]] : index
// CHECK:           %[[VAL_38:.*]] = ktdp.construct_access_tile %[[VAL_31]]{{\[}}%[[VAL_35]], %[[VAL_32]], %[[VAL_37]]] {access_tile_order = #[[$ATTR_8]], access_tile_set = #[[$ATTR_10]]} : memref<1x64x64xf32> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:           %[[VAL_39:.*]] = ktdp.load %[[VAL_38]] : <1x64x64xindex> -> tensor<1x64x64xf32>
// CHECK:           %[[VAL_40:.*]] = arith.constant dense<0.000000e+00> : tensor<64x64xf32>
// CHECK:           %[[VAL_41:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_42:.*]] = tensor.extract_slice %[[VAL_39]][0, 0, 0] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf32> to tensor<64x64xf32>
// CHECK:           %[[VAL_43:.*]] = linalg.matmul ins(%[[VAL_42]], %[[VAL_29]] : tensor<64x64xf32>, tensor<64x64xf32>) outs(%[[VAL_40]] : tensor<64x64xf32>) -> tensor<64x64xf32>
// CHECK:           %[[VAL_44:.*]] = builtin.unrealized_conversion_cast %[[VAL_3]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_45:.*]] = ktdp.construct_memory_view %[[VAL_44]], sizes: [64, 64], strides: [64, 1] {coordinate_set = #[[$ATTR_11]], memory_space = #ktdp.memory_space<global>} : memref<64x64xf32>
// CHECK:           %[[VAL_46:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:           %[[VAL_47:.*]] = arith.index_cast %[[VAL_4]] : i32 to index
// CHECK:           %[[VAL_48:.*]] = ktdp.construct_access_tile %[[VAL_45]]{{\[}}%[[VAL_46]], %[[VAL_47]]] {access_tile_order = #[[$ATTR_9]], access_tile_set = #[[$ATTR_11]]} : memref<64x64xf32> -> !ktdp.access_tile<64x64xindex>
// CHECK:           ktdp.store %[[VAL_43]], %[[VAL_48]] : tensor<64x64xf32>, <64x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_12:.+]] = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
// CHECK: #[[$ATTR_13:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_14:.+]] = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 127 >= 0, d2 >= 0, -d2 + 63 >= 0)>
// CHECK: #[[$ATTR_15:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 63 >= 0, d1 >= 0, -d1 + 63 >= 0)>
tt.func @matmul_chain(%a_ptr: !tt.ptr<f32>, %b_ptr: !tt.ptr<f32>, %c_ptr: !tt.ptr<f32>, %d_ptr: !tt.ptr<f32>) {
  %c0_i32 = arith.constant 0 : i32
  %c64_i32 = arith.constant 64 : i32
  %c64_i64 = arith.constant 64 : i64
  %c1_i64 = arith.constant 1 : i64

  // B[64, 64] stick-on-N(64): phys [1, 64, 64] = [N/64, K, N%64]
  %b_desc = tt.make_tensor_descriptor %b_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %b_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %b = tt.descriptor_load %b_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // C[64, 64] stick-on-N(64): phys [1, 64, 64] = [N/64, K, N%64]
  %c_desc = tt.make_tensor_descriptor %c_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %c_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %c = tt.descriptor_load %c_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // B@C init: zero tensor [64, 64]
  %zero = arith.constant dense<0.0> : tensor<64x64xf32>
  %bc = tt.dot %b, %c, %zero : tensor<64x64xf32> * tensor<64x64xf32> -> tensor<64x64xf32>

  // A[64, 64] stick-on-K(64): phys [1, 64, 64] = [K/64, M, K%64]
  %a_desc = tt.make_tensor_descriptor %a_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.spyre_tensor_layout %a_desc {phys_src = array<i64: 1, 0, 1>, phys_op = array<i64: 1, 0, 2>, phys_arg = array<i64: 64, 0, 64>} : !tt.tensordesc<64x64xf32>
  %a = tt.descriptor_load %a_desc[%c0_i32, %c0_i32] : !tt.tensordesc<64x64xf32> -> tensor<64x64xf32>

  // D = A @ BC (BC is a scratchpad — no marker)
  %d_init = arith.constant dense<0.0> : tensor<64x64xf32>
  %d = tt.dot %a, %bc, %d_init : tensor<64x64xf32> * tensor<64x64xf32> -> tensor<64x64xf32>

  %d_desc = tt.make_tensor_descriptor %d_ptr, [%c64_i32, %c64_i32], [%c64_i64, %c1_i64]
      : !tt.ptr<f32>, !tt.tensordesc<64x64xf32>
  tt.descriptor_store %d_desc[%c0_i32, %c0_i32], %d : !tt.tensordesc<64x64xf32>, tensor<64x64xf32>
  tt.return
}
}


