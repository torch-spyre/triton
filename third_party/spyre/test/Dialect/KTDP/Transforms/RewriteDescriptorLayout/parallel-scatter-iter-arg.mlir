    %13 = ktdp.construct_access_tile %6[%c0, %c0, %c0] {access_tile_order = #map, access_tile_set = #set1} : memref<1x64x128xf16> -> !ktdp.access_tile<1x64x128xindex>
    ktdp.store %7, %13 : tensor<1x64x128xf16>, <1x64x128xindex>
