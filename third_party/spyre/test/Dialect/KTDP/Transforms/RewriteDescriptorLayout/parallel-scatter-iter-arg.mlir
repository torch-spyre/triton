// CHECK:               %[[VAL_42:.*]] = tensor.insert_slice %[[VAL_41]] into %[[VAL_35]][0, 0, %[[VAL_37]]] [1, 64, 64] [1, 1, 1] : tensor<1x64x64xf16> into tensor<1x64x128xf16>
// CHECK:               scf.yield %[[VAL_42]] : tensor<1x64x128xf16>
// CHECK:             }
// CHECK:             scf.yield %[[VAL_33]] : tensor<1x64x128xf16>
// CHECK:           }
// CHECK:           %[[VAL_46:.*]] = ktdp.construct_access_tile %[[VAL_12]]{{\[}}%[[ZERO]], %[[ZERO]], %[[ZERO]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_4]]} : memref<1x64x128xf16> -> !ktdp.access_tile<1x64x128xindex>
// CHECK:           ktdp.store %[[VAL_13]], %[[VAL_46]] : tensor<1x64x128xf16>, <1x64x128xindex>
// CHECK:           tt.return
// CHECK:         }
  tt.func @attn_pv(%arg0: !tt.ptr<f16>, %arg1: !tt.ptr<f16>, %arg2: !tt.ptr<f16>) {
    %c0_i32 = arith.constant 0 : i32
    %c0 = arith.constant 0 : index
    %c1_i32 = arith.constant 1 : i32
    %c2_i32 = arith.constant 2 : i32
    %cst = arith.constant dense<0.000000e+00> : tensor<1x64x128xf16>
    %0 = builtin.unrealized_conversion_cast %arg0 : !tt.ptr<f16> to index
    %1 = ktdp.construct_memory_view %0, sizes: [1, 64, 64], strides: [1, 64, 1] {coordinate_set = #set, memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf16>
    // V[B=1,K=64,N=128] stick-on-N(64) -> phys [B, N/64, K, N%64] = [1, 2, 64, 64]
    %2 = builtin.unrealized_conversion_cast %arg1 : !tt.ptr<f16> to index
    %3 = ktdp.construct_memory_view %2, sizes: [1, 64, 128], strides: [8192, 128, 1] {coordinate_set = #set1, memory_space = #ktdp.memory_space<global>} : memref<1x64x128xf16>
    %4 = builtin.unrealized_conversion_cast %3 : memref<1x64x128xf16> to !tt.tensordesc<1x64x128xf16>
    tt.spyre_tensor_layout %4 {phys_arg = array<i64: 0, 64, 0, 64>, phys_op = array<i64: 0, 1, 0, 2>, phys_src = array<i64: 0, 2, 1, 2>} : <1x64x128xf16>
    %5 = builtin.unrealized_conversion_cast %arg2 : !tt.ptr<f16> to index
    %6 = ktdp.construct_memory_view %5, sizes: [1, 64, 128], strides: [8192, 128, 1] {coordinate_set = #set1, memory_space = #ktdp.memory_space<global>} : memref<1x64x128xf16>
    %7 = scf.for %arg3 = %c0_i32 to %c2_i32 step %c1_i32 iter_args(%arg4 = %cst) -> (tensor<1x64x128xf16>)  : i32 {
      %8 = ktdp.construct_access_tile %1[%c0, %c0, %c0] {access_tile_order = #map, access_tile_set = #set} : memref<1x64x64xf16> -> !ktdp.access_tile<1x64x64xindex>
      %9 = ktdp.load %8 : <1x64x64xindex> -> tensor<1x64x64xf16>
      %10 = ktdp.construct_access_tile %3[%c0, %c0, %c0] {access_tile_order = #map, access_tile_set = #set1} : memref<1x64x128xf16> -> !ktdp.access_tile<1x64x128xindex>
      %11 = ktdp.load %10 : <1x64x128xindex> -> tensor<1x64x128xf16>
      %12 = linalg.batch_matmul ins(%9, %11 : tensor<1x64x64xf16>, tensor<1x64x128xf16>) outs(%arg4 : tensor<1x64x128xf16>) -> tensor<1x64x128xf16>
      scf.yield %12 : tensor<1x64x128xf16>
