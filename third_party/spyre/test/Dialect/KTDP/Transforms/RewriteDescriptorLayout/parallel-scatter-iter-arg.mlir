// Parallel scatter inside an enclosing scf.for that carries the accumulator as
// an iter_arg — the P @ V attention inner loop.
//
//   scf.for %i iter_args(%acc = zeros : tensor<1x64x128xf16>) {
//     %v  = <stick-on-N load>                  // physical [1, 2, 64, 64]
//     %na = tt.dot %p, %v, %acc                // -> linalg.batch_matmul
//     scf.yield %na
//   }
//
// V is stick-on-N with a parallel floor extent of 2, so the scatter loop fires.
// The regression this pins: emitSourceStage must return a value of the
// CANONICAL LOGICAL type. If it returned the physical scatter container
// (tensor<2x1x64x64xf16>) instead, replaceAllUsesWith would rewrite the
// scf.yield operand while leaving the enclosing loop's iter_arg and result at
// tensor<1x64x128xf16>, and the scf.for verifier would reject:
//   'scf.for' op region iter_arg and yielded value have different type
// Scattering into `cVal` itself keeps the invariant by construction: `cVal`
// already has the full logical output shape, so no enclosing-loop retyping is
// ever needed.
//
// P is unannotated (a logical scratchpad), which is legal here because the
// shared contraction axis (K) is not stickified, so that restriction does not apply.
#map = affine_map<(d0, d1, d2) -> (d0, d1, d2)>
#set = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 63 >= 0)>
#set1 = affine_set<(d0, d1, d2) : (d0 >= 0, -d0 >= 0, d1 >= 0, -d1 + 63 >= 0, d2 >= 0, -d2 + 127 >= 0)>
module {
// CHECK-LABEL:   tt.func @attn_pv(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f16>, %[[VAL_1:.*]]: !tt.ptr<f16>, %[[VAL_2:.*]]: !tt.ptr<f16>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : i32
// CHECK:           %[[ZERO:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_4:.*]] = arith.constant 1 : i32
// CHECK:           %[[VAL_5:.*]] = arith.constant 2 : i32
// CHECK:           %[[VAL_6:.*]] = arith.constant dense<0.000000e+00> : tensor<1x64x128xf16>
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [1, 64, 64], strides: [1, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<1x64x64xf16>
// CHECK:           %[[VAL_9:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_10:.*]] = ktdp.construct_memory_view %[[VAL_9]], sizes: [1, 2, 64, 64], strides: [8192, 4096, 64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<1x2x64x64xf16>
// CHECK:           %[[VAL_11:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_12:.*]] = ktdp.construct_memory_view %[[VAL_11]], sizes: [1, 64, 128], strides: [8192, 128, 1] {coordinate_set = #[[$ATTR_4]], memory_space = #ktdp.memory_space<global>} : memref<1x64x128xf16>
// CHECK:           %[[VAL_13:.*]] = scf.for %[[VAL_14:.*]] = %[[VAL_3]] to %[[VAL_5]] step %[[VAL_4]] iter_args(%[[VAL_15:.*]] = %[[VAL_6]]) -> (tensor<1x64x128xf16>)  : i32 {
// CHECK:             %[[VAL_19:.*]] = ktdp.construct_access_tile %[[VAL_8]]{{\[}}%[[ZERO]], %[[ZERO]], %[[ZERO]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_2]]} : memref<1x64x64xf16> -> !ktdp.access_tile<1x64x64xindex>
// CHECK:             %[[VAL_20:.*]] = ktdp.load %[[VAL_19]] : <1x64x64xindex> -> tensor<1x64x64xf16>
