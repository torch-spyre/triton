// Test: Gather with layout annotation on the source descriptor.
// The indirect access tile should be rebuilt on the physical memView,
// with the physical block shape and remapped subscript maps.

#map = affine_map<(d0, d1) -> (d0, d1)>
#set = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
#set1 = affine_set<(d0, d1) : (d0 >= 0, -d0 + 511 >= 0, d1 >= 0, -d1 + 127 >= 0)>
#set2 = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 127 >= 0)>
module {
// CHECK-LABEL:   tt.func @gather_with_layout(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_1]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [2, 512, 64], strides: [32768, 64, 1] {coordinate_set = #[[$ATTR_2]], memory_space = #ktdp.memory_space<global>} : memref<2x512x64xf32>
// CHECK:           %[[VAL_10:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_11:.*]], %[[VAL_12:.*]], %[[VAL_13:.*]]) %[[VAL_8]][((%[[VAL_3]] + %[[VAL_11]] * 64 + %[[VAL_13]]) floordiv 64), ind(%[[VAL_5]]{{\[}}%[[VAL_3]] + %[[VAL_12]]]), ((%[[VAL_3]] + %[[VAL_11]] * 64 + %[[VAL_13]]) mod 64)] {variables_space_order = #[[$ATTR_0]], variables_space_set = #[[$ATTR_3]]} : memref<2x512x64xf32>, memref<32xi32> -> !ktdp.access_tile<2x32x64xindex>
// CHECK:           %[[VAL_14:.*]] = ktdp.load %[[VAL_10]] : <2x32x64xindex> -> tensor<2x32x64xf32>
// CHECK:           %[[VAL_15:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_16:.*]] = ktdp.construct_memory_view %[[VAL_15]], sizes: [2, 32, 64], strides: [2048, 64, 1] {coordinate_set = #[[$ATTR_3]], memory_space = #ktdp.memory_space<global>} : memref<2x32x64xf32>
// CHECK:           %[[VAL_19:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_20:.*]] = arith.divsi %[[VAL_3]], %[[VAL_19]] : index
// CHECK:           %[[VAL_21:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_22:.*]] = arith.remsi %[[VAL_3]], %[[VAL_21]] : index
// CHECK:           %[[VAL_23:.*]] = ktdp.construct_access_tile %[[VAL_16]]{{\[}}%[[VAL_20]], %[[VAL_3]], %[[VAL_22]]] {access_tile_order = #[[$ATTR_0]], access_tile_set = #[[$ATTR_3]]} : memref<2x32x64xf32> -> !ktdp.access_tile<2x32x64xindex>
// CHECK:           ktdp.store %[[VAL_14]], %[[VAL_23]] : tensor<2x32x64xf32>, <2x32x64xindex>
// CHECK:           tt.return
// CHECK:         }
// CHECK: #[[$ATTR_4:.+]] = affine_map<(d0, d1) -> (d0, d1)>
// CHECK: #[[$ATTR_5:.+]] = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
// CHECK: #[[$ATTR_6:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 511 >= 0, d1 >= 0, -d1 + 127 >= 0)>
// CHECK: #[[$ATTR_7:.+]] = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 127 >= 0)>
  tt.func @gather_with_layout(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<i32>, %arg2: !tt.ptr<f32>) {
    %c0 = arith.constant 0 : index
    // Index descriptor: 32-element 1-D tensor holding row indices.
    %0 = builtin.unrealized_conversion_cast %arg1 : !tt.ptr<i32> to index
    %1 = ktdp.construct_memory_view %0, sizes: [32], strides: [1] {coordinate_set = #set, memory_space = #ktdp.memory_space<global>} : memref<32xi32>
    // Data descriptor: [512, 128] with stick-on-N layout (stick=64).
    //   phys_src=[1, 0, 1] phys_op=[1, 0, 2] phys_arg=[64, 0, 64]
    //   => physical shape [N/64, M, N%64] = [2, 512, 64]
    %2 = builtin.unrealized_conversion_cast %arg0 : !tt.ptr<f32> to index
    %3 = ktdp.construct_memory_view %2, sizes: [512, 128], strides: [128, 1] {coordinate_set = #set1, memory_space = #ktdp.memory_space<global>} : memref<512x128xf32>
    %4 = builtin.unrealized_conversion_cast %3 : memref<512x128xf32> to !tt.tensordesc<512x128xf32>
    tt.spyre_tensor_layout %4 {phys_arg = array<i64: 64, 0, 64>, phys_op = array<i64: 1, 0, 2>, phys_src = array<i64: 1, 0, 1>} : <512x128xf32>
    // Gather 32 non-contiguous rows.
    %5 = ktdp.construct_indirect_access_tile intermediate_variables(%arg3, %arg4) %3[ind(%1[%c0 + %arg3]), (%c0 + %arg4)] {variables_space_order = #map, variables_space_set = #set2} : memref<512x128xf32>, memref<32xi32> -> !ktdp.access_tile<32x128xindex>
    %6 = ktdp.load %5 : <32x128xindex> -> tensor<32x128xf32>
    // Store the gathered result to a physical-annotated output.
    %7 = builtin.unrealized_conversion_cast %arg2 : !tt.ptr<f32> to index
    %8 = ktdp.construct_memory_view %7, sizes: [32, 128], strides: [128, 1] {coordinate_set = #set2, memory_space = #ktdp.memory_space<global>} : memref<32x128xf32>
    %9 = builtin.unrealized_conversion_cast %8 : memref<32x128xf32> to !tt.tensordesc<32x128xf32>
    tt.spyre_tensor_layout %9 {phys_arg = array<i64: 64, 0, 64>, phys_op = array<i64: 1, 0, 2>, phys_src = array<i64: 1, 0, 1>} : <32x128xf32>
    %10 = ktdp.construct_access_tile %8[%c0, %c0] {access_tile_order = #map, access_tile_set = #set2} : memref<32x128xf32> -> !ktdp.access_tile<32x128xindex>
    ktdp.store %6, %10 : tensor<32x128xf32>, <32x128xindex>
    tt.return
  }
}


// -----

// Test: Gather without layout annotation — indirect access tile stays logical.
// The marker is NOT on the gather source, so the pass should not touch it.

#map = affine_map<(d0, d1) -> (d0, d1)>
#set = affine_set<(d0) : (d0 >= 0, -d0 + 31 >= 0)>
#set1 = affine_set<(d0, d1) : (d0 >= 0, -d0 + 511 >= 0, d1 >= 0, -d1 + 127 >= 0)>
#set2 = affine_set<(d0, d1) : (d0 >= 0, -d0 + 31 >= 0, d1 >= 0, -d1 + 127 >= 0)>
module {
// CHECK-LABEL:   tt.func @gather_no_layout(
// CHECK-SAME:  %[[VAL_0:.*]]: !tt.ptr<f32>, %[[VAL_1:.*]]: !tt.ptr<i32>, %[[VAL_2:.*]]: !tt.ptr<f32>) {
// CHECK:           %[[VAL_3:.*]] = arith.constant 0 : index
// CHECK:           %[[VAL_4:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<i32> to index
// CHECK:           %[[VAL_5:.*]] = ktdp.construct_memory_view %[[VAL_4]], sizes: [32], strides: [1] {coordinate_set = #[[$ATTR_5]], memory_space = #ktdp.memory_space<global>} : memref<32xi32>
// CHECK:           %[[VAL_7:.*]] = builtin.unrealized_conversion_cast %[[VAL_0]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_8:.*]] = ktdp.construct_memory_view %[[VAL_7]], sizes: [512, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_6]], memory_space = #ktdp.memory_space<global>} : memref<512x128xf32>
// CHECK:           %[[VAL_10:.*]] = ktdp.construct_indirect_access_tile intermediate_variables(%[[VAL_11:.*]], %[[VAL_12:.*]]) %[[VAL_8]][ind(%[[VAL_5]]{{\[}}%[[VAL_3]] + %[[VAL_11]]]), (%[[VAL_3]] + %[[VAL_12]])] {variables_space_order = #[[$ATTR_4]], variables_space_set = #[[$ATTR_7]]} : memref<512x128xf32>, memref<32xi32> -> !ktdp.access_tile<32x128xindex>
// CHECK:           %[[VAL_13:.*]] = ktdp.load %[[VAL_10]] : <32x128xindex> -> tensor<32x128xf32>
// CHECK:           %[[VAL_14:.*]] = builtin.unrealized_conversion_cast %[[VAL_2]] : !tt.ptr<f32> to index
// CHECK:           %[[VAL_15:.*]] = ktdp.construct_memory_view %[[VAL_14]], sizes: [32, 128], strides: [128, 1] {coordinate_set = #[[$ATTR_7]], memory_space = #ktdp.memory_space<global>} : memref<32x128xf32>
// CHECK:           %[[VAL_18:.*]] = ktdp.construct_access_tile %[[VAL_15]]{{\[}}%[[VAL_3]], %[[VAL_3]]] {access_tile_order = #[[$ATTR_4]], access_tile_set = #[[$ATTR_7]]} : memref<32x128xf32> -> !ktdp.access_tile<32x128xindex>
// CHECK:           ktdp.store %[[VAL_13]], %[[VAL_18]] : tensor<32x128xf32>, <32x128xindex>
// CHECK:           tt.return
// CHECK:         }
  tt.func @gather_no_layout(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<i32>, %arg2: !tt.ptr<f32>) {
    %c0 = arith.constant 0 : index
    // Index descriptor.
    %0 = builtin.unrealized_conversion_cast %arg1 : !tt.ptr<i32> to index
    %1 = ktdp.construct_memory_view %0, sizes: [32], strides: [1] {coordinate_set = #set, memory_space = #ktdp.memory_space<global>} : memref<32xi32>
    // Data descriptor: NO layout annotation.
    %2 = builtin.unrealized_conversion_cast %arg0 : !tt.ptr<f32> to index
    %3 = ktdp.construct_memory_view %2, sizes: [512, 128], strides: [128, 1] {coordinate_set = #set1, memory_space = #ktdp.memory_space<global>} : memref<512x128xf32>
    // Gather 32 non-contiguous rows — stays logical.
    %4 = ktdp.construct_indirect_access_tile intermediate_variables(%arg3, %arg4) %3[ind(%1[%c0 + %arg3]), (%c0 + %arg4)] {variables_space_order = #map, variables_space_set = #set2} : memref<512x128xf32>, memref<32xi32> -> !ktdp.access_tile<32x128xindex>
    %5 = ktdp.load %4 : <32x128xindex> -> tensor<32x128xf32>
    // Store to keep alive.
    %6 = builtin.unrealized_conversion_cast %arg2 : !tt.ptr<f32> to index
    %7 = ktdp.construct_memory_view %6, sizes: [32, 128], strides: [128, 1] {coordinate_set = #set2, memory_space = #ktdp.memory_space<global>} : memref<32x128xf32>
    %8 = ktdp.construct_access_tile %7[%c0, %c0] {access_tile_order = #map, access_tile_set = #set2} : memref<32x128xf32> -> !ktdp.access_tile<32x128xindex>
    ktdp.store %5, %8 : tensor<32x128xf32>, <32x128xindex>
    tt.return
  }
}
