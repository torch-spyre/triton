tt.func @parallel_floor_rank5(%a: !tt.ptr<f16>, %b: !tt.ptr<f16>, %c: !tt.ptr<f16>) {
  %z = arith.constant 0 : i32
  %b2 = arith.constant 2 : i32
  %m = arith.constant 128 : i32
  %k = arith.constant 128 : i32
  %n = arith.constant 64 : i32
  %s1 = arith.constant 1 : i64
  %s64 = arith.constant 64 : i64
  %s128 = arith.constant 128 : i64
  %s8192 = arith.constant 8192 : i64
  %s16384 = arith.constant 16384 : i64
  %ad = tt.make_tensor_descriptor %a, [%b2, %m, %k], [%s16384, %s128, %s1] : !tt.ptr<f16>, !tt.tensordesc<2x128x128xf16>
  tt.spyre_tensor_layout %ad {phys_src = array<i64: 1, 2, 0, 1, 2>, phys_op = array<i64: 1, 1, 0, 2, 2>, phys_arg = array<i64: 64, 64, 0, 64, 64>} : !tt.tensordesc<2x128x128xf16>
  %av = tt.descriptor_load %ad[%z, %z, %z] : !tt.tensordesc<2x128x128xf16> -> tensor<2x128x128xf16>
  %bd = tt.make_tensor_descriptor %b, [%b2, %k, %n], [%s8192, %s64, %s1] : !tt.ptr<f16>, !tt.tensordesc<2x128x64xf16>
  tt.spyre_tensor_layout %bd {phys_src = array<i64: 1, 0, 1, 2>, phys_op = array<i64: 1, 0, 2, 0>, phys_arg = array<i64: 64, 0, 64, 0>} : !tt.tensordesc<2x128x64xf16>
  %bv = tt.descriptor_load %bd[%z, %z, %z] : !tt.tensordesc<2x128x64xf16> -> tensor<2x128x64xf16>
  %cd = tt.make_tensor_descriptor %c, [%b2, %m, %n], [%s8192, %s64, %s1] : !tt.ptr<f16>, !tt.tensordesc<2x128x64xf16>
  %cv = tt.descriptor_load %cd[%z, %z, %z] : !tt.tensordesc<2x128x64xf16> -> tensor<2x128x64xf16>
  %d = tt.dot %av, %bv, %cv : tensor<2x128x128xf16> * tensor<2x128x64xf16> -> tensor<2x128x64xf16>
  tt.descriptor_store %cd[%z, %z, %z], %d : !tt.tensordesc<2x128x64xf16>, tensor<2x128x64xf16>
  tt.return
}
