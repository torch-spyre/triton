// CHECK:           %[[VAL_19:.*]] = builtin.unrealized_conversion_cast %[[VAL_1]] : !tt.ptr<f16> to index
// CHECK:           %[[VAL_20:.*]] = ktdp.construct_memory_view %[[VAL_19]], sizes: [2, 2, 64, 64], strides: [8192, 4096, 64, 1] {coordinate_set = #[[$ATTR_13]], memory_space = #ktdp.memory_space<global>} : memref<2x2x64x64xf16>
// CHECK:           %[[VAL_21:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_22:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_23:.*]] = arith.index_cast %[[VAL_3]] : i32 to index
// CHECK:           %[[VAL_24:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_25:.*]] = arith.divsi %[[VAL_22]], %[[VAL_24]] : index
// CHECK:           %[[VAL_26:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_27:.*]] = arith.remsi %[[VAL_22]], %[[VAL_26]] : index
// CHECK:           %[[VAL_28:.*]] = ktdp.construct_access_tile %[[VAL_20]]{{\[}}%[[VAL_25]], %[[VAL_21]], %[[VAL_27]], %[[VAL_23]]] {access_tile_order = #[[$ATTR_10]], access_tile_set = #[[$ATTR_13]]} : memref<2x2x64x64xf16> -> !ktdp.access_tile<2x2x64x64xindex>
