// CHECK:           %[[VAL_13:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_14:.*]] = arith.remsi %[[VAL_7]], %[[VAL_13]] : index
// CHECK:           %[[VAL_15:.*]] = arith.constant 64 : index
// CHECK:           %[[VAL_16:.*]] = arith.remsi %[[VAL_8]], %[[VAL_15]] : index
// CHECK:           %[[VAL_17:.*]] = ktdp.construct_access_tile %[[VAL_5]]{{\[}}%[[VAL_10]], %[[VAL_12]], %[[VAL_6]], %[[VAL_14]], %[[VAL_16]]] {access_tile_order = #[[$ATTR_9]], access_tile_set = #[[$ATTR_12]]} : memref<2x2x2x64x64xf16> -> !ktdp.access_tile<2x2x2x64x64xindex>
