index dbe0913..5c64c81 100644
--- a/include/ktir/Dialect/KTDP/KTDP.td
+++ b/include/ktir/Dialect/KTDP/KTDP.td
@@ -30,6 +30,7 @@ include "mlir/IR/EnumAttr.td"
 
 include "mlir/Dialect/Affine/IR/AffineMemoryOpInterfaces.td"
 include "mlir/Interfaces/ControlFlowInterfaces.td"
+include "mlir/Interfaces/InferTypeOpInterface.td"
 include "mlir/Interfaces/SideEffectInterfaces.td"
 include "mlir/Interfaces/ViewLikeInterface.td"
 include "mlir/IR/BuiltinAttributes.td"
@@ -710,4 +711,56 @@ def KTDP_RuntimeArgExtractOp : Ktdp_Op<"runtime_arg_extract", [Pure]> {
     OpBuilder<(ins "RuntimeArgExtractKind":$kind, "Value":$input)>
   ];
 }
+
+//===----------------------------------------------------------------------===//
+// Device-neutral compute intrinsics
+//===----------------------------------------------------------------------===//
+
+// F16, or a vector/tensor container of it -- the same shape `FloatLike`
+// (OpBase.td) gives `AnyFloat`, narrowed to the one width `spyreop.*`
+// intrinsics actually take. Needed, not just convenient: the op is traced
+// as a tensor but must remain the SAME op class once scalarized inside a
+// linalg.generic body (see the note on `ElementwiseMappable.traits`,
+// below), so its type constraint has to admit both forms itself.
+def Ktdp_F16Like : TypeOrValueSemanticsContainer<F16, "f16-or-container-of-f16">;
+
+// Base class for a device-neutral, 1:1 mirror of a `spyreop.*` intrinsic.
+// Such an op names a request for a specific device computation without
+// naming any device: it is traced as a tensor op (unlike `spyreop.*`, which
+// is scalar-only), carries no notion of "this requires Spyre hardware," and
+// is expected to have more than one legitimate lowering -- the real
+// hardware op for a backend that has one, a generic decomposition for a
+// backend (such as ktir_cpu) that does not.
+//
+// `ElementwiseMappable.traits` (OpBase.td: Elementwise, Scalarizable,
+// Vectorizable, Tensorizable) is load-bearing, not decorative, and
+// `Elementwise` alone is not enough: `Scalarizable` is specifically what
+// licenses the upstream `-convert-elementwise-to-linalg` pass to replace a
+// tensor-typed occurrence with a scalar-typed occurrence of this SAME op
+// class, inside a `linalg.generic` body, with no KTDP-specific wrapping
+// pass needed -- exactly the trick `math.sqrt` already relies on (see
+// `Math_Op`'s own base class). Without it, that pass has no license to
+// reuse this op class at scalar type, and the scalarized clone would
+// violate `Ktdp_F16Like` the moment anything re-verifies it.
+class Ktdp_IntrinsicOp<string mnemonic, list<Trait> traits = []> :
+    Ktdp_Op<mnemonic, traits # ElementwiseMappable.traits #
+                      [Pure, SameOperandsAndResultType]> {
+  let arguments = (ins Ktdp_F16Like:$operand);
+  let results = (outs Ktdp_F16Like:$result);
+  let assemblyFormat = "$operand attr-dict `:` type($result)";
+}
+
+def KTDP_GeLUOp : Ktdp_IntrinsicOp<"gelu"> {
+  let summary = "Device-neutral GELU request: x * CDF(x)";
+  let description = [{
+    `ktdp.gelu` is the device-neutral, tensor-level mirror of `spyreop.gelu`
+    (F16-only, matching the real hardware op's own element-type constraint).
+    It names a request for the GELU computation without naming a device:
+    the Spyre backend lowers it directly to `spyreop.gelu` once scalarized;
+    a backend with no `spyreop` support (e.g. ktir_cpu) instead decomposes
+    it into the tanh-approximation reference implementation in plain
+    `arith`/`math` ops. Neither lowering is visible to the other.
+  }];
+}
+
 #endif // KTDP_OPS_TD
