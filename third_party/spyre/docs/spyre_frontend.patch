index 0000000..f92c7e5
--- /dev/null
+++ b/include/ktir/Dialect/KTDP/Transforms/Passes.td
@@ -0,0 +1,60 @@
+//===- Passes.td - KTDP compute-op transform pass definitions -*- tablegen -*-===//
+//
+// Copyright 2026 The KTIR Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//
+//===----------------------------------------------------------------------===//
+//
+// This file defines passes whose subject is the KTDP dialect's own
+// device-neutral compute intrinsics (`Ktdp_IntrinsicOp`-derived ops, e.g.
+// `ktdp.gelu`) -- not its memory/access abstractions, which have no compute
+// to decompose.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef KTDP_TRANSFORMS_PASSES_TD
+#define KTDP_TRANSFORMS_PASSES_TD
+
+include "mlir/Pass/PassBase.td"
+
+def DecomposeKTDPCompute : Pass<"decompose-ktdp-compute", "::mlir::ModuleOp"> {
+  let summary = "Decompose device-neutral KTDP compute intrinsics into "
+                "generic arith/math ops";
+  let description = [{
+    A `Ktdp_IntrinsicOp`-derived op (e.g. `ktdp.gelu`) names a request for a
+    specific compute intrinsic without naming a device. A backend with a real
+    hardware op for it (Spyre) lowers it directly; a backend with none --
+    `ktir_cpu`, today the only such consumer -- instead needs a reference
+    implementation it already knows how to interpret. This pass is that
+    reference: it replaces each KTDP intrinsic with the equivalent `arith`/
+    `math` computation on the same tensor type, so that after it runs, no
+    `Ktdp_IntrinsicOp` survives anywhere in the module.
+
+    `ktdp.gelu` decomposes to the tanh approximation:
+
+      0.5 * x * (1 + tanh(0.7978845608 * (x + 0.044715 * x^3)))
+
+    computed directly on the operand's tensor type -- no `linalg`, since the
+    op is still tensor-level when this pass runs (scalarization, where it
+    happens at all, is a later, Spyre-specific concern this pass does not
+    need and does not perform).
+  }];
+
+  let dependentDialects = [
+    "mlir::arith::ArithDialect",
+    "mlir::math::MathDialect"
+  ];
+}
+
+#endif // KTDP_TRANSFORMS_PASSES_TD
