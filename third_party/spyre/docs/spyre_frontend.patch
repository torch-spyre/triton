diff --git a/lib/Dialect/KTDP/Transforms/DecomposeKTDPCompute.cpp b/lib/Dialect/KTDP/Transforms/DecomposeKTDPCompute.cpp
new file mode 100644
index 0000000..5a9d677
--- /dev/null
+++ b/lib/Dialect/KTDP/Transforms/DecomposeKTDPCompute.cpp
@@ -0,0 +1,134 @@
+//===- DecomposeKTDPCompute.cpp - Decompose KTDP compute intrinsics ------===//
+//
+// Copyright 2026 The KTIR Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//
+//===----------------------------------------------------------------------===//
+//
+// Replaces each `Ktdp_IntrinsicOp`-derived op with the equivalent `arith`/
+// `math` computation on the same tensor type. See the summary in Passes.td
+// for why this exists: a backend with no `spyreop` support (ktir_cpu, today
+// the only one) needs a reference implementation it already knows how to
+// interpret, and this pass is that reference.
+//
+//===----------------------------------------------------------------------===//
+
+#include "ktir/Dialect/KTDP/Transforms/Passes.h"
+
+#include "ktir/Dialect/KTDP/KTDP.h"
+#include "ktir/Dialect/KTDP/KTDPDialect.h"
+
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Math/IR/Math.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/BuiltinTypes.h"
+#include "mlir/IR/PatternMatch.h"
+#include "mlir/Pass/Pass.h"
+#include "llvm/ADT/APFloat.h"
+
+using namespace mlir;
+
+namespace ktir {
+#define GEN_PASS_DEF_DECOMPOSEKTDPCOMPUTE
+#include "ktir/Dialect/KTDP/Transforms/Passes.h.inc"
+} // namespace ktir
+
+namespace {
+
+/// A scalar float constant splatted to `type`, which must be a statically
+/// shaped tensor -- the only shape a `arith.constant` can carry directly, a
+/// dynamically shaped operand would need `tensor.splat` with explicit
+/// dynamic-extent operands instead, which this pass does not build (see the
+/// static-shape check in `DecomposeGeLU`, below).
+Value splatConstant(OpBuilder &builder, Location loc, RankedTensorType type,
+                    double value) {
+  auto elementType = cast<FloatType>(type.getElementType());
+  APFloat apValue(value);
+  bool losesInfo;
+  apValue.convert(elementType.getFloatSemantics(), APFloat::rmNearestTiesToEven,
+                  &losesInfo);
+  return arith::ConstantOp::create(
+      builder, loc, DenseElementsAttr::get(type, llvm::ArrayRef(apValue)));
+}
+
+/// `ktdp.gelu` -> the tanh approximation, in plain `arith`/`math` on the
+/// operand's own tensor type:
+///
+///   0.5 * x * (1 + tanh(0.7978845608 * (x + 0.044715 * x^3)))
+///
+/// No `linalg`: the op is still tensor-level when this pass runs (nothing
+/// upstream of it has scalarized anything), and this pass has no reason to
+/// introduce scalarization itself -- that is a later, Spyre-specific
+/// concern (see `LowerSpyreOps`'s `SelectKtdpGeLU` pattern, in the Triton
+/// fork, which relies on the *generic* `-convert-elementwise-to-linalg`
+/// pass instead of a bespoke one). This pass's only job is to leave behind
+/// ops a non-Spyre interpreter already understands.
+///
+/// A direct `IRRewriter` walk, not `applyPatternsGreedily`: the greedy
+/// driver's worklist unconditionally erases any `Pure` op it visits with no
+/// uses (`isOpTriviallyDead`, independent of `GreedyRewriteConfig`'s region-
+/// simplification toggle) -- for a whole-module pass that visits every op
+/// in the IR, not just `ktdp.gelu`. This pass must leave every op it does
+/// not itself decompose untouched.
+LogicalResult decomposeGeLU(ktdp::GeLUOp op, IRRewriter &rewriter) {
+  auto type = dyn_cast<RankedTensorType>(op.getType());
+  if (!type || !type.hasStaticShape())
+    return op.emitError(
+        "decompose-ktdp-compute: only a statically shaped operand is "
+        "supported today");
+
+  Location loc = op.getLoc();
+  Value x = op.getOperand();
+  rewriter.setInsertionPoint(op);
+
+  Value c0 = splatConstant(rewriter, loc, type, 0.044715);
+  Value c1 = splatConstant(rewriter, loc, type, 0.7978845608);
+  Value half = splatConstant(rewriter, loc, type, 0.5);
+  Value one = splatConstant(rewriter, loc, type, 1.0);
+
+  // inner = x + 0.044715 * x^3
+  Value x2 = arith::MulFOp::create(rewriter, loc, x, x);
+  Value x3 = arith::MulFOp::create(rewriter, loc, x2, x);
+  Value cubic = arith::MulFOp::create(rewriter, loc, c0, x3);
+  Value inner = arith::AddFOp::create(rewriter, loc, x, cubic);
+
+  // t = tanh(0.7978845608 * inner)
+  Value scaled = arith::MulFOp::create(rewriter, loc, c1, inner);
+  Value t = math::TanhOp::create(rewriter, loc, scaled);
+
+  // result = 0.5 * x * (1 + t)
+  Value onePlusT = arith::AddFOp::create(rewriter, loc, one, t);
+  Value halfX = arith::MulFOp::create(rewriter, loc, half, x);
+  Value result = arith::MulFOp::create(rewriter, loc, halfX, onePlusT);
+
+  rewriter.replaceOp(op, result);
+  return success();
+}
+
+struct DecomposeKTDPComputePass
+    : public ktir::impl::DecomposeKTDPComputeBase<DecomposeKTDPComputePass> {
+
+  void runOnOperation() override {
+    IRRewriter rewriter(&getContext());
+    auto result = getOperation().walk([&](ktdp::GeLUOp op) {
+      if (failed(decomposeGeLU(op, rewriter)))
+        return WalkResult::interrupt();
+      return WalkResult::advance();
+    });
+    if (result.wasInterrupted())
+      signalPassFailure();
+  }
+};
+
+} // namespace
