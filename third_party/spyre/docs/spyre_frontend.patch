+// CHECK:           %[[VAL_6:.*]] = arith.mulf %[[VAL_5]], %[[VAL_0]] : tensor<128xf16>
+// CHECK:           %[[VAL_7:.*]] = arith.mulf %[[VAL_1]], %[[VAL_6]] : tensor<128xf16>
+// CHECK:           %[[VAL_8:.*]] = arith.addf %[[VAL_0]], %[[VAL_7]] : tensor<128xf16>
+// CHECK:           %[[VAL_9:.*]] = arith.mulf %[[VAL_2]], %[[VAL_8]] : tensor<128xf16>
+// CHECK:           %[[VAL_10:.*]] = math.tanh %[[VAL_9]] : tensor<128xf16>
+// CHECK:           %[[VAL_11:.*]] = arith.addf %[[VAL_4]], %[[VAL_10]] : tensor<128xf16>
+// CHECK:           %[[VAL_12:.*]] = arith.mulf %[[VAL_3]], %[[VAL_0]] : tensor<128xf16>
+// CHECK:           %[[VAL_13:.*]] = arith.mulf %[[VAL_12]], %[[VAL_11]] : tensor<128xf16>
+// CHECK:           return %[[VAL_13]] : tensor<128xf16>
+// CHECK:         }
+// CHECK-NOT:     ktdp.gelu
+func.func @gelu(%x: tensor<128xf16>) -> tensor<128xf16> {
+  %y = ktdp.gelu %x : tensor<128xf16>
+  return %y : tensor<128xf16>
+}
